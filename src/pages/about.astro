---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import { translations, type Lang } from '../lib/i18n';

const currentLang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = translations[currentLang];
const a = t.about;

// 役員データ（英語・日本語切り替え）
const boardMembers = [
  {
    role: currentLang === 'en' ? 'President & Representative Director' : '理事長',
    name: currentLang === 'en' ? 'Sohtaro Kubo' : '久保 壮太郎',
    enName: currentLang === 'en' ? 'President' : 'Sohtaro Kubo'
  },
  {
    role: currentLang === 'en' ? 'Director' : '理事',
    name: currentLang === 'en' ? 'Shun Sekiguchi' : '関口 俊',
    enName: currentLang === 'en' ? 'Director' : 'Shun Sekiguchi'
  },
  {
    role: currentLang === 'en' ? 'Director' : '理事',
    name: currentLang === 'en' ? 'Hinata Suzuki' : '鈴木 陽向',
    enName: currentLang === 'en' ? 'Director' : 'Hinata Suzuki'
  },
  {
    role: currentLang === 'en' ? 'Director' : '理事',
    name: currentLang === 'en' ? 'Hiroya Mouri' : '毛利 仁哉',
    enName: currentLang === 'en' ? 'Director' : 'Hiroya Mouri'
  }
];
---

<Layout 
  title={currentLang === 'en' ? 'About Us | JYRAC' : '当法人について | 日本若者防災復興協会'} 
  currentTab="about"
>
  <div class="about-container">

    <!-- ページ見出し -->
    <header class="about-header">
      <span class="sub-label">{a.header.sub}</span>
      <h1 class="main-heading">{a.header.title}</h1>
      <p class="desc-text">{a.header.desc}</p>
    </header>

    <!-- 理念（Mission・Vision） -->
    <section class="section-card">
      <div class="card-inner-box">
        <span class="sub-label">{a.mission.sub}</span>
        <h2 class="card-heading">{a.mission.heading}</h2>
        <p class="lead-quote" style="white-space: pre-line;">{a.mission.leadQuote}</p>
        <p class="body-text">{a.mission.body}</p>
      </div>
    </section>

    <!-- 理事長挨拶 -->
    <section class="section-card">
      <span class="sub-label">{a.president.sub}</span>
      <h2 class="card-heading">{a.president.heading}</h2>
      
      <div class="message-body">
        <p>{a.president.p1}</p>
        <p>{a.president.p2}</p>
        <p>{a.president.p3}</p>
        <div class="message-signature">
          <span>{a.president.orgName}</span>
          <strong>{a.president.roleAndName}</strong>
        </div>
      </div>
    </section>

    <!-- 役員紹介 -->
    <section id="members" class="section-card">
      <div class="section-header-split">
        <div>
          <span class="sub-label">{a.members.sub}</span>
          <h2 class="card-heading">{a.members.heading}</h2>
        </div>
      </div>

      <div class="board-grid">
        {boardMembers.map(m => (
          <div class="board-card">
            <span class="board-role">{m.role}</span>
            <h3 class="board-name">{m.name}</h3>
            <span class="board-en-name">{m.enName}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- 組織図・体制 -->
    <section class="section-card">
      <span class="sub-label">{a.org.sub}</span>
      <h2 class="card-heading">{a.org.heading}</h2>
      <p class="desc-text" style="margin-bottom: 20px;">{a.org.desc}</p>

      <div class="org-layout-grid">
        <div class="org-col">
          <h4 class="org-title">{a.org.divisionsTitle}</h4>
          <ul class="org-list">
            {a.org.divisions.map(item => <li>・{item}</li>)}
          </ul>
        </div>

        <div class="org-col">
          <h4 class="org-title">{a.org.projectsTitle}</h4>
          <ul class="org-list">
            {a.org.projects.map(item => <li>・{item}</li>)}
          </ul>
        </div>

        <div class="org-col">
          <h4 class="org-title">{a.org.policyTitle}</h4>
          <ul class="org-list">
            {a.org.policy.map(item => <li>・{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- 法人概要スペック表（審査項目対応） -->
    <section class="section-card">
      <span class="sub-label">{a.legal.sub}</span>
      <h2 class="card-heading">{a.legal.heading}</h2>

      <table class="info-table">
        <tbody>
          <tr>
            <th>{a.legal.nameLabel}</th>
            <td>{a.legal.nameValue}</td>
          </tr>
          <tr>
            <th>{a.legal.corpNumLabel}</th>
            <td>
              <code>{a.legal.corpNumValue}</code>
              <span class="sub-note">{a.legal.corpNumSub}</span>
            </td>
          </tr>
          <tr>
            <th>{a.legal.certDateLabel}</th>
            <td>{a.legal.certDateValue}</td>
          </tr>
          <tr>
            <th>{a.legal.repLabel}</th>
            <td>{a.legal.repValue}</td>
          </tr>
          <tr>
            <th>{a.legal.addressLabel}</th>
            <td>{a.legal.addressValue}</td>
          </tr>
          <tr>
            <th>{a.legal.purposeLabel}</th>
            <td>
              {a.legal.purposeValue}
              <br />
              <span class="sub-note">{a.legal.purposeSub}</span>
            </td>
          </tr>
          <tr>
            <th>{a.legal.achievementsLabel}</th>
            <td>{a.legal.achievementsValue}</td>
          </tr>
          <tr>
            <th>{a.legal.contactLabel}</th>
            <td>
              <a href="mailto:info@jyrac.stki.org" class="table-link">info@jyrac.stki.org</a>
              <span class="sub-note">{a.legal.contactSub}</span>
            </td>
          </tr>
          <tr>
            <th>{a.legal.domainLabel}</th>
            <td>{a.legal.domainValue}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- 戻るリンク -->
    <div class="back-row">
      <a href={`${baseUrl}/${langParam}`} class="header-link">{t.common.backToHome}</a>
    </div>

  </div>
</Layout>

<style>
  .about-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) 16px;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 4vw, 36px);
  }

  .about-header {
    text-align: center;
    margin-bottom: 4px;
  }
  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }
  .main-heading {
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.3;
  }
  .desc-text {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 6px;
    line-height: 1.6;
  }

  /* セクションカード */
  .section-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: clamp(16px, 4vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 4px 16px rgba(0, 43, 84, 0.02);
  }
  .card-heading {
    font-size: clamp(17px, 4vw, 20px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.35;
  }

  /* 理念ブロック */
  .card-inner-box {
    background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
    border: 1px solid #ccfbf1;
    border-radius: 16px;
    padding: clamp(16px, 3.5vw, 24px);
  }
  .lead-quote {
    font-size: clamp(15px, 3.6vw, 18px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.5;
    margin: 10px 0;
  }
  .body-text {
    font-size: 13.5px;
    color: var(--text-main);
    line-height: 1.8;
  }

  /* メッセージ */
  .message-body {
    font-size: 13.5px;
    color: var(--text-main);
    line-height: 1.85;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .message-signature {
    margin-top: 12px;
    text-align: right;
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: var(--jyrac-navy);
  }

  /* 役員グリッド */
  .board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
  }
  .board-card {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .board-role {
    font-size: 11px;
    font-weight: 800;
    color: var(--jyrac-teal);
    font-family: ui-monospace, monospace;
  }
  .board-name {
    font-size: 17px;
    font-weight: 900;
    color: var(--jyrac-navy);
  }
  .board-en-name {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    color: #94a3b8;
  }

  /* 組織図グリッド */
  .org-layout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }
  .org-col {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 16px;
  }
  .org-title {
    font-size: 13px;
    font-weight: 800;
    color: var(--jyrac-navy);
    border-bottom: 1.5px solid var(--border-color);
    padding-bottom: 6px;
    margin-bottom: 10px;
  }
  .org-list {
    list-style: none;
    font-size: 12px;
    color: var(--text-main);
    line-height: 1.75;
  }

  /* テーブル */
  .info-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-top: 4px;
  }
  .info-table th {
    width: 28%;
    background-color: var(--bg-light);
    color: var(--jyrac-navy);
    font-weight: 800;
    text-align: left;
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    vertical-align: top;
    white-space: nowrap;
  }
  .info-table td {
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    color: var(--text-main);
    line-height: 1.6;
    word-break: break-word;
  }

  .sub-note {
    display: inline-block;
    color: var(--text-muted);
    font-size: 12px;
    margin-left: 4px;
  }
  .table-link {
    color: var(--jyrac-teal);
    text-decoration: none;
    font-weight: 600;
  }
  .table-link:hover {
    text-decoration: underline;
  }

  .header-link {
    font-size: 12px;
    font-weight: 800;
    color: var(--jyrac-teal);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
  .back-row {
    text-align: center;
    padding-top: 12px;
  }

  /* レスポンシブ最適化 */
  @media (max-width: 768px) {
    .section-card {
      padding: 18px 14px;
      border-radius: 16px;
    }
    .info-table, 
    .info-table tbody, 
    .info-table tr, 
    .info-table th, 
    .info-table td {
      display: block;
      width: 100%;
      box-sizing: border-box;
    }
    .info-table tr {
      border: 1px solid var(--border-color);
      border-radius: 12px;
      margin-bottom: 10px;
      overflow: hidden;
      background: #ffffff;
    }
    .info-table tr:last-child {
      margin-bottom: 0;
    }
    .info-table th {
      background-color: var(--bg-light);
      border: none;
      border-bottom: 1px solid var(--border-color);
      padding: 8px 12px;
      font-size: 11.5px;
    }
    .info-table td {
      border: none;
      padding: 10px 12px;
      font-size: 12.5px;
    }
    .board-grid {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 10px;
    }
    .board-card {
      padding: 12px 14px;
    }
    .board-name {
      font-size: 16px;
    }
    .org-layout-grid {
      grid-template-columns: 1fr;
    }
    .message-signature {
      text-align: left;
    }
  }
</style>
