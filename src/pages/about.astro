---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';

const currentLang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// 6. 役員・代表紹介データ (事業説明資料より)
const boardMembers = [
  {
    role: currentLang === 'en' ? 'President & Representative Director' : '理事長',
    name: '久保 壮太郎',
    enName: 'Sotaro Kubo',
    desc: currentLang === 'en'
      ? 'Oversees entire consortium operations, government policy proposals, and youth disaster mitigation strategies.'
      : '学生支援募金プロジェクトの発足から活動を牽引。若者の防災参画プラットフォーム確立と政策提言を担当。'
  },
  {
    role: currentLang === 'en' ? 'Director' : '理事',
    name: '関口 俊',
    enName: 'Shun Sekiguchi',
    desc: currentLang === 'en'
      ? 'Supervises internal administration, partner relations, and project development.'
      : '法人運営・組織管理・各プロジェクト統括を担当。'
  },
  {
    role: currentLang === 'en' ? 'Director' : '理事',
    name: '鈴木 陽向',
    enName: 'Hinata Suzuki',
    desc: currentLang === 'en'
      ? 'Leads field relief projects, school partnerships, and student networks.'
      : '被災地現地活動、学校・生徒会連携、学生ネットワーク形成を担当。'
  },
  {
    role: currentLang === 'en' ? 'Director' : '理事',
    name: '毛利 仁哉',
    enName: 'Jinya Mori',
    desc: currentLang === 'en'
      ? 'Focuses on regional revitalisation, logistics, and event management.'
      : '地域事業、避難所改善プロジェクト、広報戦略支援を担当。'
  }
];
---

<Layout 
  title={currentLang === 'en' ? 'About Us | JYRAC' : '当法人について | 日本若者防災復興協会'} 
  currentTab="about"
>
  <div class="about-container">

    <!-- ページ見出し -->
    <header class="about-header">
      <span class="sub-label">ABOUT JYRAC</span>
      <h1 class="main-heading">
        {currentLang === 'en' ? 'About Our Organization' : '当法人について'}
      </h1>
      <p class="desc-text">
        {currentLang === 'en'
          ? 'Information regarding the mission, vision, officers, and structure of Japan Youth Resilience Action Consortium.'
          : '特定非営利活動法人日本若者防災復興協会の理念・設立の想い・役員体制・組織概要です。'}
      </p>
    </header>

    <!-- 5. 理念（Mission・Vision・想い） -->
    <section class="section-card">
      <div class="card-inner-box">
        <span class="sub-label">MISSION & VISION</span>
        <h2 class="card-heading">
          {currentLang === 'en' ? 'Our Philosophy & Mission' : '組織理念・目指す社会'}
        </h2>
        <p class="lead-quote">
          「いつもの暮らし」が、いちばん強い。<br />
          若者から始める、新しい防災と復興。
        </p>
        <p class="body-text">
          私たちは、災害の悲しみをただの記憶で終わらせません。若者ならではの柔軟な発想力と圧倒的な行動力をもって、お堅い「お勉強」としての防災を刷新し、誰もが主体的に関わりたくなる新しい防災・復興のスタンダードを築きます。地域と世代の壁を越え、すべての人が手を取り合って災害に立ち向かえる、安全で持続可能な社会を私たちが先頭に立って創り上げます。
        </p>
      </div>
    </section>

    <!-- 理事長挨拶 -->
    <section class="section-card">
      <span class="sub-label">MESSAGE FROM THE PRESIDENT</span>
      <h2 class="card-heading">
        {currentLang === 'en' ? 'President Message' : '理事長 挨拶'}
      </h2>
      
      <div class="message-body">
        <p>
          災害は、ある日突然、私たちの日常を奪います。しかし同時に、そこから立ち上がろうとする人々の歩みの中には、地域の強さ、人と人とのつながり、未来を担う若者の可能性が確かに存在しています。
        </p>
        <p>
          私たちは、被災地への一時的な支援にとどまらず、若者が継続的に地域と関わり、学び、行動し、社会に提言していく仕組みをつくっていきたいと考えています。防災を「特別な人だけが担うもの」ではなく、すべての若者が自分ごととして考え、参加できる社会へ。その実現こそが、JYRACの使命です。
        </p>
        <p>
          災害の記憶を風化させず、次の行動へつなげること。支援する側とされる側を超え、ともに未来をつくる仲間になること。JYRACはその先頭に立ち、若者の挑戦を社会の力へと変えていきます。
        </p>
        <div class="message-signature">
          <span>特定非営利活動法人 日本若者防災復興協会</span>
          <strong>理事長 久保 壮太郎</strong>
        </div>
      </div>
    </section>

    <!-- 6. 代表・役員紹介 -->
    <section id="members" class="section-card">
      <div class="section-header-split">
        <div>
          <span class="sub-label">BOARD OF DIRECTORS</span>
          <h2 class="card-heading">
            {currentLang === 'en' ? 'Board Members' : '役員紹介'}
          </h2>
        </div>
      </div>

      <div class="board-grid">
        {boardMembers.map(m => (
          <div class="board-card">
            <span class="board-role">{m.role}</span>
            <h3 class="board-name">{m.name}</h3>
            <span class="board-en-name">{m.enName}</span>
            <p class="board-desc">{m.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 7. 組織図・体制 -->
    <section class="section-card">
      <span class="sub-label">ORGANIZATION STRUCTURE</span>
      <h2 class="card-heading">
        {currentLang === 'en' ? 'Organization Chart' : '組織体制・ガバナンス'}
      </h2>
      <p class="desc-text" style="margin-bottom: 20px;">
        最高意思決定機関である理事会および監査を行う監事のもと、各局・各事業本部・政務調査会が連携して活動を展開しています。
      </p>

      <div class="org-layout-grid">
        <div class="org-col">
          <h4 class="org-title">各局（法人基盤・統括）</h4>
          <ul class="org-list">
            <li>・<strong>事務局</strong>（総務・会計・法務・情報部）</li>
            <li>・<strong>人事局</strong>（採用・メンバー育成）</li>
            <li>・<strong>広報局</strong>（デザイン課・SNS発信課・メディアプレス課）</li>
            <li>・<strong>外務局</strong>（渉外・パートナーシップ）</li>
          </ul>
        </div>

        <div class="org-col">
          <h4 class="org-title">各事業本部（プロジェクト推進）</h4>
          <ul class="org-list">
            <li>・<strong>防災事業本部</strong>（生徒会サミット・避難所環境改善）</li>
            <li>・<strong>復興事業本部</strong>（能登現地支援・伝統食文化継承）</li>
            <li>・<strong>地域事業本部 / 募金事業本部</strong>（街頭募金・地域防災出展）</li>
            <li>・<strong>国際事業本部</strong>（Y-VITAL・模擬防災国連）</li>
          </ul>
        </div>

        <div class="org-col">
          <h4 class="org-title">政務調査会 ＆ 連携コミュニティ</h4>
          <ul class="org-list">
            <li>・<strong>政務調査会</strong>（政策提言・法案調査・意見交換）</li>
            <li>・<strong>中高生コミュニティ NSF PROJECTS</strong></li>
            <li>・<strong>超党派避難所議連 事務局支援</strong></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 法人概要スペック表 -->
    <section class="section-card">
      <span class="sub-label">ORGANIZATION OVERVIEW</span>
      <h2 class="card-heading">
        {currentLang === 'en' ? 'Legal Details' : '法人概要'}
      </h2>

      <table class="info-table">
        <tbody>
          <tr>
            <th>団体名称</th>
            <td>特定非営利活動法人日本若者防災復興協会（英語略称：JYRAC）</td>
          </tr>
          <tr>
            <th>設立登記日</th>
            <td>令和8年6月21日</td>
          </tr>
          <tr>
            <th>代表者</th>
            <td>理事長 久保 壮太郎</td>
          </tr>
          <tr>
            <th>所在地</th>
            <td>東京都文京区</td>
          </tr>
          <tr>
            <th>主な活動領域</th>
            <td>防災教育 / 被災地復興支援 / 若者参画 / 地域連携 / コミュニティ形成 / 政策提言</td>
          </tr>
          <tr>
            <th>主な実績</th>
            <td>内閣府共催「全国生徒会防災サミット2026」開催、避難所環境改善・政策提言、能登半島現地復興ボランティア、街頭募金活動59回（総額260万円超）</td>
          </tr>
          <tr>
            <th>連絡先</th>
            <td>jyrac.pr@gmail.com</td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- 戻るリンク -->
    <div class="back-row">
      <a href={`${baseUrl}/${langParam}`} class="header-link">← ホームに戻る</a>
    </div>

  </div>
</Layout>

<style>
  .about-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 48px 16px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .about-header {
    text-align: center;
    margin-bottom: 8px;
  }
  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }
  .main-heading {
    font-size: 28px;
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.3;
  }
  .desc-text {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 6px;
  }

  /* セクションカード */
  .section-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card-heading {
    font-size: 20px;
    font-weight: 900;
    color: var(--jyrac-navy);
  }

  /* 理念ブロック */
  .card-inner-box {
    background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
    border: 1px solid #ccfbf1;
    border-radius: 16px;
    padding: 24px;
  }
  .lead-quote {
    font-size: 18px;
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.5;
    margin: 12px 0;
  }
  .body-text {
    font-size: 13.5px;
    color: var(--text-main);
    line-height: 1.8;
  }

  /* メッセージ */
  .message-body {
    font-size: 13.5px;
    color: var(--text-main);
    line-height: 1.8;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .message-signature {
    margin-top: 12px;
    text-align: right;
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: var(--jyrac-navy);
  }

  /* 役員グリッド */
  .board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .board-card {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .board-role {
    font-size: 11px;
    font-weight: 800;
    color: var(--jyrac-teal);
    font-family: ui-monospace, monospace;
  }
  .board-name {
    font-size: 18px;
    font-weight: 900;
    color: var(--jyrac-navy);
  }
  .board-en-name {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    color: #94a3b8;
    margin-bottom: 6px;
  }
  .board-desc {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* 組織図 */
  .org-layout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .org-col {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 20px;
  }
  .org-title {
    font-size: 13px;
    font-weight: 800;
    color: var(--jyrac-navy);
    border-bottom: 1.5px solid var(--border-color);
    padding-bottom: 8px;
    margin-bottom: 12px;
  }
  .org-list {
    list-style: none;
    font-size: 12px;
    color: var(--text-main);
    line-height: 1.8;
  }

  /* テーブル */
  .info-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-top: 8px;
  }
  .info-table th {
    width: 28%;
    background-color: var(--bg-light);
    color: var(--jyrac-navy);
    font-weight: 800;
    text-align: left;
    padding: 12px 16px;
    border: 1px solid var(--border-color);
    vertical-align: top;
  }
  .info-table td {
    padding: 12px 16px;
    border: 1px solid var(--border-color);
    color: var(--text-main);
    line-height: 1.6;
  }

  .header-link {
    font-size: 12px;
    font-weight: 800;
    color: var(--jyrac-teal);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
  .back-row {
    text-align: center;
    padding-top: 16px;
  }

  @media (max-width: 768px) {
    .section-card {
      padding: 20px 16px;
    }
    .info-table th, .info-table td {
      padding: 10px 12px;
      font-size: 12px;
    }
    .info-table th {
      width: 32%;
    }
  }
</style>
