    var QS = [
      {ax:"P",scene:IS_EN?"Waiting at School":"学校で待機",text:IS_EN?"After an earthquake, you have to wait at school for a while. A friend nearby looks restless. What do you do first?":"地震のあと、学校でしばらく待機することになりました。近くにいる友達が落ち着かない様子です。あなたが最初にするなら？",o:[{t:IS_EN?"Check if they need anything or are having trouble":"今必要なものや困っていることがないか確認する",p:"P"},{t:IS_EN?"Ask what is bothering them":"何が気になっているのか話を聞く",p:"M"}]},
      {ax:"P",scene:IS_EN?"Stopping during a drill":"訓練中に立ち止まる",text:IS_EN?"During a disaster drill, someone in your group stops and cannot move. What do you do first?":"防災訓練の途中、同じグループの人が動けずに立ち止まっています。あなたが最初にするなら？",o:[{t:IS_EN?"Organize together what to do next":"次に何をすればよいか一緒に整理する",p:"P"},{t:IS_EN?"Talk to them to see how they are doing":"どうしたのか声をかけて様子を見る",p:"M"}]},
      {ax:"P",scene:IS_EN?"Stuck in heavy rain":"大雨で帰れない",text:IS_EN?"Heavy rain prevents you from going home, and you wait at school. Someone nearby keeps checking their phone. What do you do first?":"大雨で帰宅できず、学校で待つことになりました。近くの人が何度もスマホを見ています。あなたが最初にするなら？",o:[{t:IS_EN?"Check info together":"今分かっている情報を一緒に確認する",p:"P"},{t:IS_EN?"Ask what worries them":"何が心配なのか聞いてみる",p:"M"}]},
      {ax:"P",scene:IS_EN?"Tired":"疲労",text:IS_EN?"Team member looks exhausted after drill.":"訓練後、班の人が疲れている。",o:[{t:IS_EN?"Reduce burden":"負担を減らす",p:"P"},{t:IS_EN?"Talk and rest":"休みながら声をかける",p:"M"}]},
      {ax:"P",scene:IS_EN?"Quiet":"沈黙",text:IS_EN?"Someone stopped speaking in a discussion.":"話し合いで発言しなくなった人がいる。",o:[{t:IS_EN?"Check if unclear":"内容を確認",p:"P"},{t:IS_EN?"Ask how they feel":"気持ちを聞く",p:"M"}]},
      {ax:"P",scene:IS_EN?"Blackout":"停電",text:IS_EN?"Child cries in dark shelter.":"避難所の夜、子供が泣いている。",o:[{t:IS_EN?"Find light":"明かりを探す",p:"P"},{t:IS_EN?"Sit by them":"そばに座る",p:"M"}]},
