/* ====== 状態 ====== */
const $=id=>document.getElementById(id);
let deck=[], idx=0, answers=[], sex="", result=null;

function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a}

function buildDeck(){
  // 各軸10問のプールから5問ずつ抽選 → 計15問
  const picked = ["P","S","B"].flatMap(ax => shuffle(QS.filter(q=>q.ax===ax)).slice(0,5));
  // 出題順と選択肢の左右をランダムにする（並び順による偏りを消すため）
  const judge = shuffle(picked).map(x=>({...x, o: Math.random()<.5 ? x.o : [x.o[1], x.o[0]]}));
  // 共変量5問：順番も選択肢の左右も固定（「ある/いる/知っている」を必ずAに置く）
  const cov = COV.map(x=>({...x, o: x.o.slice()}));
  deck = judge.concat(cov);
}

function show(id){
  ["s-intro","s-quiz","s-profile","s-result"].forEach(s=>$(s).classList.toggle("hidden", s!==id));
  window.scrollTo({top:0,behavior:"instant"});
}

function renderIntro(){
  const order=["hamster","ant","squirrel","beaver","owl","penguin","otter","dolphin"];
  $("introGrid").innerHTML = order.map(k=>`<img src="${IMG[k]}" alt="">`).join("");
  $("axList").innerHTML = AXES.map(ax=>{
    const A=LETTER[ax.a], B=LETTER[ax.b];
    return `<div class="axrow"><span class="nm">${ax.name}</span>
      <span class="ltr"><b>${ax.a}</b>${A.ja}</span><span class="sl">か</span>
      <span class="ltr"><b>${ax.b}</b>${B.ja}</span></div>`;
  }).join("");
}

function renderQ(){
  const q=deck[idx];
  $("count").textContent = `${idx+1} / ${deck.length}` + (idx>=15 ? "　※ここからは判定に使いません" : "");
  const dots=["#EF5A48","#F06A18","#E8AF1E","#14875C","#8B44A8","#123A96","#1BBFC6","#EE6A9E"];
  $("prog").innerHTML = deck.map((_,i)=>
    `<i class="${i<idx?"on":i===idx?"cur":""}" style="--dot:${dots[i%8]}"></i>`).join("");
  $("scene").textContent = q.scene;
  $("qtext").textContent = q.text;
  $("choices").innerHTML = q.o.map((o,i)=>
    `<button type="button" class="choice" data-p="${o.p}"><span class="mark">${i===0?"A":"B"}</span>${o.t}</button>`).join("");
  $("choices").querySelectorAll(".choice").forEach(b=>b.onclick=()=>pick(b.dataset.p));
  $("backBtn").classList.toggle("hidden", idx===0);
}

function pick(p){
  answers[idx]={ax:deck[idx].ax, p, key:deck[idx].key||null, id:deck[idx].id||null};
  idx++;
  if(idx<deck.length) renderQ(); else show("s-profile");
}

function calc(){
  const c={P:0,M:0,S:0,I:0,B:0,N:0};
  answers.slice(0,15).forEach(a=>{ if(a.p in c) c[a.p]++ });
  const code=(c.P>=3?"P":"M")+(c.S>=3?"S":"I")+(c.B>=3?"B":"N");
  const cov={};
  answers.slice(15).forEach(a=>{ if(a.key) cov[a.key] = a.p==="1" ? "はい" : "いいえ" });
  return {code, c, cov};
}

function bar(label,leftName,rightName,leftVal){
  const l=leftVal, r=5-leftVal;
  return `<div class="bar"><div class="lab"><span>${l>=3?"<b>"+leftName+"</b>":leftName} ${l}</span>
    <span>${r} ${r>3?"<b>"+rightName+"</b>":rightName}</span></div>
    <div class="track"><span style="width:${l*20}%"></span><span class="r" style="width:${r*20}%"></span></div></div>`;
}

function renderResult(){
  result=calc();
  const t=TYPES[result.code], c=result.c;
  $("s-result").style.setProperty("--c", t.col);
  $("rImg").src=IMG[t.key]; $("rImg").alt=t.name;
  $("rCode").textContent=result.code.split("").join(" ・ ");
  $("rName").textContent=t.name;
  $("rCatch").textContent=t.catch;
  $("rBars").innerHTML =
    bar("","課題からいく","気持ちからいく",c.P)+
    bar("","決まった型でいく","その場で工夫する",c.S)+
    bar("","目の前の一人へ","全体へ広げる",c.B);
  $("rCode3").innerHTML = result.code.split("").map((L,i)=>{
    const l=LETTER[L], ax=AXES[i], other=LETTER[ax.a===L?ax.b:ax.a];
    return `<div class="cline"><div class="cbig">${L}</div><div class="cmeta">
      <p class="t1">${l.ja}　<span style="font-weight:500;font-size:12px;color:#8a7f70">${l.en}</span></p>
      <p class="t2">${l.line}</p>
      <p class="t3">${ax.name}の軸：<span>${l.ja}(${L})</span> ⇄ ${other.ja}(${ax.a===L?ax.b:ax.a})　／　${ax.src}</p>
    </div></div>`;
  }).join("");
  $("rGood").textContent=t.good;
  $("rPost").textContent=t.post;
  $("rBlind").textContent=t.blind;
  $("rStep").textContent=t.step;
  const bd=TYPES[t.buddy], op=TYPES[t.opp];
  $("rBuddyImg").src=IMG[bd.key]; $("rBuddy").textContent=bd.name;
  $("rOppImg").src=IMG[op.key];  $("rOpp").textContent=op.name;
  $("rPairNote").textContent="相棒は、動き方が近いのに死角が違う相手。正反対は、やり方が理解しづらいけれど、そろうと対応できる幅がいちばん広くなる相手です。";
  $("rTheme").textContent=t.theme;

  const mail=$("mail").value.trim();
  $("mailNote").textContent = mail
    ? `${mail} あてのメールを作成します。送信ボタンを押すのはメールアプリ側です。`
    : "メールアドレスが未入力です。前の画面に戻って入力するか、下の印刷から保存してください。";
  $("mailBtn").disabled = !mail;
  $("mailBtn").style.opacity = mail ? 1 : .45;

  send();
  show("s-result");
}

