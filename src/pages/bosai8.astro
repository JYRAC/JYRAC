      if (!GAS_WEBHOOK_URL || GAS_WEBHOOK_URL.indexOf("AKfycb") === -1) return;

      const ageSelect = $("b8-age");
      const ageVal = ageSelect ? ageSelect.value : "";
      const mailVal = $("b8-mail") ? $("b8-mail").value.trim() : "";

      const payload = {
        timestamp: new Date().toISOString(),
        mail: mailVal,
        age: ageVal,
        sex: sex,
        code: result.code,
        typeName: result.type.name,
        scores: result.c,
        answers: answers.map(a => a ? a.p : "")
      };

      fetch(GAS_WEBHOOK_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      }).catch(() => {});
    }

    function bar(leftName, rightName, leftVal){
      const l = leftVal, r = 5 - leftVal;
      return `<div class="bar"><div class="lab"><span>${l>=3?"<b>"+leftName+"</b>":leftName} ${l}</span>
        <span>${r} ${r>3?"<b>"+rightName+"</b>":rightName}</span></div>
        <div class="track"><span style="width:${l*20}%"></span><span class="r" style="width:${r*20}%"></span></div></div>`;
    }

    function renderResult(){
      result = calc();
      const t = TYPES[result.code], c = result.c;
      const ch = ANIMAL_ICONS[t.key];
      
      const sResult = $("s-result");
      if (sResult) sResult.style.setProperty("--c", t.col);

      // メインヒーローアイコン（丸型CSSレンダリング）
      const rImgContainer = $("rImgContainer");
      if (rImgContainer) {
        rImgContainer.innerHTML = `
          <div class="hero-circle" style="background:${t.col}">
            <span>${ch.line1}</span>
            <span>${ch.line2}</span>
          </div>
        `;
      }

      if ($("rCode")) $("rCode").textContent = result.code.split("").join(" ・ ");
      if ($("rName")) $("rName").textContent = t.name;
      if ($("rCatch")) $("rCatch").textContent = t.catch;

      const rBars = $("rBars");
      if (rBars) {
        rBars.innerHTML = 
          bar("課題からいく", "気持ちからいく", c.P) +
          bar("決まった型でいく", "その場で工夫する", c.S) +
          bar("目の前の一人へ", "全体へ広げる", c.B);
      }

      const rCode3 = $("rCode3");
      if (rCode3) {
        rCode3.innerHTML = result.code.split("").map((L,i)=>{
          const l=LETTER[L], ax=AXES[i], other=LETTER[ax.a===L?ax.b:ax.a];
          return `<div class="cline"><div class="cbig">${L}</div><div class="cmeta">
            <p class="t1">${l.ja} <span style="font-weight:500;font-size:12px;color:#8a7f70">${l.en}</span></p>
            <p class="t2">${l.line}</p>
            <p class="t3">${ax.name}の軸：<span>${l.ja}(${L})</span> ⇄ ${other.ja}(${ax.a===L?ax.b:ax.a}) ／ ${ax.src}</p>
          </div></div>`;
        }).join("");
      }

      if ($("rGood")) $("rGood").textContent = t.good;
      if ($("rPost")) $("rPost").textContent = t.post;
      if ($("rBlind")) $("rBlind").textContent = t.blind;
      if ($("rStep")) $("rStep").textContent = t.step;

      const bd = TYPES[t.buddy], op = TYPES[t.opp];
      const budCh = ANIMAL_ICONS[bd.key], oppCh = ANIMAL_ICONS[op.key];

      const rBuddyImgContainer = $("rBuddyImgContainer");
      if (rBuddyImgContainer) {
        rBuddyImgContainer.innerHTML = `
          <div class="sub-circle" style="background:${bd.col}">
            <span>${budCh.line1}</span>
            <span>${budCh.line2}</span>
          </div>
        `;
      }
      if ($("rBuddy")) $("rBuddy").textContent = bd.name;

      const rOppImgContainer = $("rOppImgContainer");
      if (rOppImgContainer) {
        rOppImgContainer.innerHTML = `
          <div class="sub-circle" style="background:${op.col}">
            <span>${oppCh.line1}</span>
            <span>${oppCh.line2}</span>
          </div>
        `;
      }
      if ($("rOpp")) $("rOpp").textContent = op.name;

      if ($("rPairNote")) {
        $("rPairNote").textContent = "相棒は、動き方が近いのに死角が違う相手。正反対は、やり方が理解しづらいけれど、そろうと対応できる幅がいちばん広くなる相手です。";
      }
      if ($("rTheme")) $("rTheme").textContent = t.theme;

      const mail = $("b8-mail").value.trim();
      if ($("mailNote")) {
        $("mailNote").textContent = mail
          ? `${mail} あてのメールを作成します。送信ボタンを押すのはメールアプリ側です。`
          : "メールアドレスが入力されています。";
      }

      const mailBtn = $("mailBtn");
      if (mailBtn) {
        mailBtn.onclick = () => {
          const to = $("b8-mail").value.trim();
          if(!to) return;
          const bodyText = [
            `■ 防災共助タイプ診断「ぼうさい8」結果`, ``,
            `あなたのタイプ：${t.name}（${result.code}）`, `${t.catch}`, ``,
            `── きみの得意 ──`, t.good, ``,
            `── 避難所での持ち場 ──`, t.post, ``,
            `── 今日からの一歩 ──`, t.step, ``,
            `日本若者防災復興協会（JYRAC）`
          ].join("\n");
          window.location.href = `mailto:${encodeURIComponent(to)}?subject=${encodeURIComponent("【ぼうさい8】あなたは "+t.name)}&body=${encodeURIComponent(bodyText)}`;
        };
      }

      if ($("printBtn")) $("printBtn").onclick = () => window.print();

      if ($("againBtn")) {
        $("againBtn").onclick = () => {
          sex = "";
          $("b8-mail").value = "";
          $("b8-age").value = "";
          if(sexPill) [...sexPill.children].forEach(x=>x.setAttribute("aria-pressed","false"));
          show("s-intro");
        };
      }

      submitToSpreadsheet();
      show("s-result");
    }

    renderIntro();
    buildDeck();

    const startBtn = $("startBtn");
    if (startBtn) {
      startBtn.onclick = () => {
        buildDeck();
        idx = 0;
        answers = [];
        show("s-quiz");
        renderQ();
      };
    }

    const sexPill = $("sexPill");
    if (sexPill) {
      sexPill.onclick = e => {
        const b = e.target.closest("button");
        if (!b) return;
        sex = b.dataset.v;
        [...sexPill.children].forEach(x => x.setAttribute("aria-pressed", x === b));
      };
    }

    const resultBtn = $("resultBtn");
    if (resultBtn) {
      resultBtn.onclick = () => {
        const mailInput = $("b8-mail");
        const mailVal = mailInput ? mailInput.value.trim() : "";
        const mailErr = $("mail-error");
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!mailVal || !emailRegex.test(mailVal)) {
          if (mailErr) mailErr.style.display = "block";
          if (mailInput) {
            mailInput.focus();
            mailInput.style.borderColor = "#ef5a48";
          }
          return;
        }

        if (mailErr) mailErr.style.display = "none";
        if (mailInput) mailInput.style.borderColor = "";

        renderResult();
      };
    }

    show("s-intro");
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runBosai8App);
  } else {
    runBosai8App();
  }
  document.addEventListener('astro:page-load', runBosai8App);
</script>
