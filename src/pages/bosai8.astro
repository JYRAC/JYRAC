    function renderQ(){
      const q = deck[idx];
      const countEl = $("count");
      if (countEl) countEl.textContent = `${idx+1} / ${deck.length}` + (idx>=15 ? " ※ここからは判定に使いません" : "");

      const dots = ["#EF5A48","#F06A18","#E8AF1E","#14875C","#8B44A8","#123A96","#1BBFC6","#EE6A9E"];
      const progEl = $("prog");
      if (progEl) {
        progEl.innerHTML = deck.map((_,i)=>
          `<i class="${i<idx?"on":i===idx?"cur":""}" style="--dot:${dots[i%8]}"></i>`).join("");
      }

      const sceneEl = $("scene");
      const qtextEl = $("qtext");
      const choicesEl = $("choices");

      if (sceneEl) sceneEl.textContent = q.scene;
      if (qtextEl) qtextEl.textContent = q.text;

      if (choicesEl) {
        choicesEl.innerHTML = q.o.map((o,i)=>
          `<button class="choice" data-p="${o.p}" type="button"><span class="mark">${i===0?"A":"B"}</span>${o.t}</button>`).join("");

        choicesEl.querySelectorAll(".choice").forEach(b => {
          b.onclick = () => {
            answers[idx] = {ax:deck[idx].ax, p:b.dataset.p, key:deck[idx].key||null, id:deck[idx].id||null};
            idx++;
            if (idx < deck.length) {
              renderQ();
            } else {
              show("s-profile");
            }
          };
        });
      }

      const backBtn = $("backBtn");
      if (backBtn) {
        backBtn.classList.toggle("b8-hidden", idx === 0);
        backBtn.onclick = () => {
          if (idx > 0) {
            idx--;
            renderQ();
          }
        };
      }
    }

    function calc(){
      const c={P:0,M:0,S:0,I:0,B:0,N:0};
      answers.slice(0,15).forEach(a=>{ if(a && a.p in c) c[a.p]++ });
      const code=(c.P>=3?"P":"M")+(c.S>=3?"S":"I")+(c.B>=3?"B":"N");
      const cov={};
      answers.slice(15).forEach(a=>{ if(a && a.key) cov[a.key] = a.p==="1" ? "はい" : "いいえ" });
      return {code, c, cov};
    }

