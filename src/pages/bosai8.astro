``,
`── コードの意味 ──`,
...result.code.split("").map((L,i)=>`${L}＝${LETTER[L].ja}（${LETTER[L].en}）／${AXES[i].name}の軸　${LETTER[L].line}`),
``,
`── スコア ──`,
`課題からいく ${c.P} ／ 気持ちからいく ${c.M}`,
`決まった型でいく ${c.S} ／ その場で工夫する ${c.I}`,
`目の前の一人へ ${c.B} ／ 全体へ広げる ${c.N}`,
``,
`── きみの得意 ──`,
t.good,
``,
`── 避難所での持ち場 ──`,
t.post,
``,
`── 気をつけたいこと ──`,
t.blind,
``,
`── 今日からの一歩 ──`,
t.step,
``,
`── 相棒と正反対 ──`,
`相棒：${TYPES[t.buddy].name}／正反対：${TYPES[t.opp].name}`,
``,
`── もっと知りたい人へ ──`,
t.theme,
``,
`※これは心理検査ではありません。災害時の行動を最も強く決めるのは性格ではなく、そのときの状況です。`,
`日本若者防災復興協会（JYRAC）`
].join("\n");
}

function send(){
  if(!GAS_ENDPOINT) return;
  const t=TYPES[result.code];
  const mailVal=$("mail").value.trim();
  const payload={
    timestamp:new Date().toISOString(),
    mail:mailVal,
    age:$("age").value,
    sex:sex,
    code:result.code,
    typeName:t.name,
    scores:{
      P:result.c.P, M:result.c.M,
      S:result.c.S, I:result.c.I,
      B:result.c.B, N:result.c.N
    },
    answers:answers
  };
  fetch(GAS_ENDPOINT,{
    method:"POST",
    mode:"no-cors",
    headers:{"Content-Type":"text/plain;charset=utf-8"},
    body:JSON.stringify(payload)
  }).catch(()=>{});
}

/* ====== イベント ====== */
$("startBtn").onclick=()=>{buildDeck();idx=0;answers=[];renderQ();show("s-quiz")};
$("backBtn").onclick=()=>{if(idx>0){idx--;renderQ()}};
$("resultBtn").onclick=renderResult;
$("sexPill").onclick=e=>{
  const b=e.target.closest("button"); if(!b)return;
  sex=b.dataset.v;
  [...$("sexPill").children].forEach(x=>x.setAttribute("aria-pressed", x===b));
};
$("mailBtn").onclick=()=>{
  const to=$("mail").value.trim(); if(!to)return;
  location.href=`mailto:${encodeURIComponent(to)}?subject=${encodeURIComponent("【ぼうさい8】あなたは "+TYPES[result.code].name)}&body=${encodeURIComponent(mailBody())}`;
};
$("printBtn").onclick=()=>window.print();
$("againBtn").onclick=()=>{sex="";$("mail").value="";$("age").value="";
  [...$("sexPill").children].forEach(x=>x.setAttribute("aria-pressed",false));show("s-intro")};

renderIntro();
</script>
