---
import Layout from '../layouts/Layout.astro';

// URLから言語パラメータを取得 (例: /bosai8?lang=en)
const requestUrl = Astro.request.url.replace(/^http:/, 'https:');
const url = new URL(requestUrl);
const currentLang = url.searchParams.get("lang") === "en" ? "en" : "ja";

// ローカルの public/images/ フォルダからイラストを読み込む設定
const IMG = {
  hamster: "/images/hamster.webp",
  ant: "/images/ant.webp",
  squirrel: "/images/squirrel.webp",
  beaver: "/images/beaver.webp",
  owl: "/images/owl.webp",
  penguin: "/images/penguin.webp",
  otter: "/images/otter.webp",
  dolphin: "/images/dolphin.webp"
};

// 多言語テキスト辞書
const t = {
  title: currentLang === 'en' ? "Bosai 8 ｜ Disaster Mutual-Aid Type Quiz" : "ぼうさい8 ｜ 防災共助タイプ診断",
  eyebrow: currentLang === 'en' ? "JYRAC Disaster Mutual-Aid Type Quiz" : "JYRAC 防災共助タイプ診断",
  heading: currentLang === 'en' ? "Bosai 8" : "ぼうさい8",
  intro: currentLang === 'en' 
    ? "In a disaster, there isn't just one way to help.<br>Based on your choices in 20 scenarios, find out which of the 8 animal helper types fits you best."
    : "災害のとき、人の助け方はひとつじゃない。<br>20の場面であなたが選んだ行動から、8匹のうちどの助け方に近いかを見つけます。",
  axTitle: currentLang === 'en' ? "Divided into 8 types across 3 axes" : "3つの軸で、8タイプに分かれます",
  axNote: currentLang === 'en' ? "The 3-letter combination (e.g., P-S-N) becomes your type code." : "3文字の組み合わせ（例：P・S・N）が、あなたのタイプコードになります。",
  muted: currentLang === 'en'
    ? "15 questions + 5 profile items / 2-3 minutes. There are no right or wrong answers.<br>5 questions are randomly chosen from 10 per axis, so questions change each time.<br>This is not a psychological test, but a learning opportunity to discover various ways of helping."
    : "15問＋5問／2〜3分。正解はありません。<br>設問は各軸10問の中から5問ずつ選ばれるので、やるたびに出題は変わります。<br>これは心理検査ではなく、助け方にはいろいろあることを知るための学びのきっかけです。",
  startBtn: currentLang === 'en' ? "Start" : "はじめる",
  backBtn: currentLang === 'en' ? "← Back" : "← ひとつ前にもどる",
  profileEyebrow: currentLang === 'en' ? "Almost Done" : "あと少し",
  profileTitle: currentLang === 'en' ? "Tell us a bit about yourself" : "あなたについて教えてください",
  profileDesc: currentLang === 'en' ? "Statistical data used by JYRAC for disaster education research. No names are collected. Leave blank if you prefer not to answer." : "JYRAC が防災教育の研究に使う統計データです。氏名は集めません。答えたくない項目は空欄のままで進めます。",
  labelAge: currentLang === 'en' ? "Age" : "年齢",
  optNoSelect: currentLang === 'en' ? "Prefer not to say" : "選ばない",
  sexTitle: currentLang === 'en' ? "Gender" : "性別",
  sexFemale: currentLang === 'en' ? "Female" : "女性",
  sexMale: currentLang === 'en' ? "Male" : "男性",
  sexOther: currentLang === 'en' ? "Other" : "その他",
  sexNone: currentLang === 'en' ? "Prefer not to say" : "答えない",
  labelMail: currentLang === 'en' ? "Email to send results (optional)" : "結果を送るメールアドレス（任意）",
  mailDesc: currentLang === 'en' ? "If entered, you can create an email to yourself from the result screen. You can view results without it." : "入力すると、結果画面から自分あてのメールを作成できます。空欄でも結果は見られます。",
  resultBtn: currentLang === 'en' ? "View Results" : "結果を見る",
  codeMeaning: currentLang === 'en' ? "Meaning of Your Code" : "コードの意味",
  good: currentLang === 'en' ? "Your Strengths" : "きみの得意",
  post: currentLang === 'en' ? "Shelter Role" : "避難所での持ち場",
  blind: currentLang === 'en' ? "Things to Watch Out For" : "気をつけたいこと",
  step: currentLang === 'en' ? "Your First Step Today" : "今日からの一歩",
  buddy: currentLang === 'en' ? "Buddy" : "相棒",
  opp: currentLang === 'en' ? "Opposite" : "正反対",
  pairNote: currentLang === 'en'
    ? "Buddies share a similar approach but have different blind spots. Opposites have contrasting styles, but together they cover the widest range of situations."
    : "相棒は、動き方が近いのに死角が違う相手。正反対は、やり方が理解しづらいけれど、そろうと対応できる幅がいちばん広くなる相手です。",
  theme: currentLang === 'en' ? "To Learn More" : "もっと知りたい人へ",
  noteFoot: currentLang === 'en' ? "Your animal type can change depending on your environment and role. Disaster behavior is shaped more by the situation than by personality. Use this result not to label yourself, but to learn about other ways to help." : "あなたの動物は、置かれた場所や役割で変わります。災害時の行動を最も強く決めるのは性格ではなく、そのときの状況です。結果を「自分はこういう人だ」と決めつけるためではなく、ほかの助け方を知るために使ってください。",
  saveTitle: currentLang === 'en' ? "Save Your Results" : "結果を残す",
  mailBtn: currentLang === 'en' ? "Create Email" : "メールを作成する",
  printBtn: currentLang === 'en' ? "Print Card / Save as PDF" : "このカードを印刷 / PDFで保存",
  againBtn: currentLang === 'en' ? "Take Again" : "もう一度やる",
  switchLangText: currentLang === 'en' ? "日本語" : "English",
  switchLangUrl: currentLang === 'en' ? "/bosai8" : "/bosai8?lang=en",
  orText: currentLang === 'en' ? "or" : "か"
};
---

<Layout title={t.title} currentTab="bosai8">
  <style is:global>
    :root{
      --bg1:#F2F7FF; --bg2:#FFF8F0;
      --card:#ffffff;
      --ink:#232936; --ink2:#6E7684; --mute:#9AA1AC;
      --line:#E6E9F0;
      --accent:#FF9F1C;
      --primary:#232936;
      --c:#232936;
      --r:24px;
      --disp:"M PLUS Rounded 1c","Hiragino Maru Gothic ProN",sans-serif;
      --body:"Zen Kaku Gothic New","Hiragino Sans","Noto Sans JP",sans-serif;
    }
    *{box-sizing:border-box}
    .b8-wrap{max-width:600px;margin:0 auto;padding:20px 16px 60px;position:relative;}

    .lang-switch {
      position: absolute;
      top: 15px;
      right: 16px;
      background: #fff;
      border: 2px solid var(--line);
      border-radius: 999px;
      padding: 6px 14px;
      font-family: var(--disp);
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      color: var(--ink);
      box-shadow: 0 2px 8px rgba(35,41,54,.06);
      text-decoration: none;
      transition: all .15s ease;
      z-index: 10;
      display: inline-block;
    }
    .lang-switch:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .sheet{
      position:relative; background:var(--card); border-radius:var(--r);
      box-shadow:0 1px 2px rgba(35,41,54,.05), 0 12px 30px rgba(35,41,54,.08);
      padding:26px 22px 24px;
    }
    .sheet + .sheet{margin-top:16px}

    h1{font-family:var(--disp);font-weight:800;font-size:clamp(32px,9vw,46px);line-height:1.12;margin:0 0 8px;letter-spacing:.01em}
    h2{font-family:var(--disp);font-weight:800;font-size:20px;margin:0 0 10px;line-height:1.4}
    .eyebrow{font-family:var(--disp);font-weight:700;font-size:11.5px;letter-spacing:.2em;color:var(--accent);margin:0 0 10px}
    p{line-height:1.85;margin:0 0 14px;font-size:15px}
    .muted{color:var(--ink2);font-size:12.5px;line-height:1.8}

    .btn{
      display:block;width:100%;border:none;cursor:pointer;
      font-family:var(--disp);font-weight:700;font-size:17px;
      background:var(--primary);color:#fff;padding:17px;border-radius:999px;
      box-shadow:0 6px 16px rgba(35,41,54,.24);
      transition:transform .13s ease, box-shadow .13s ease, opacity .13s;
    }
    .btn:hover{transform:translateY(-1px);box-shadow:0 10px 22px rgba(35,41,54,.28)}
    .btn:active{transform:translateY(1px);box-shadow:0 3px 10px rgba(35,41,54,.22)}
    .btn.sign{background:var(--accent);color:#3A2400;box-shadow:0 6px 16px rgba(255,159,28,.4)}
    .btn.ghost{background:transparent;color:var(--ink2);box-shadow:none;font-family:var(--body);font-size:14px;font-weight:500;padding:11px}
    .btn.ghost:hover{transform:none;color:var(--ink);box-shadow:none}
    :focus-visible{outline:3px solid var(--accent);outline-offset:3px}

    .prog{display:flex;gap:3px;margin:0 0 18px}
    .prog i{flex:1;height:7px;background:#EDF0F5;border-radius:999px;transition:background .25s, transform .25s}
    .prog i.on{background:var(--dot)}
    .prog i.cur{background:var(--dot);transform:scaleY(1.9)}
    .count{font-family:var(--disp);font-weight:700;font-size:12px;color:var(--mute);letter-spacing:.06em;margin:0 0 8px}

    .scene{font-family:var(--disp);font-weight:700;font-size:12.5px;color:#fff;
      background:var(--primary);display:inline-block;padding:5px 13px;border-radius:999px;margin-bottom:12px}
    .qtext{font-size:16px;line-height:1.9;margin:0 0 20px}
    .choice{
      display:flex;align-items:flex-start;gap:12px;width:100%;text-align:left;cursor:pointer;
      background:#fff;border:2px solid var(--line);border-radius:18px;
      padding:15px 16px;font-family:var(--body);font-size:15.5px;line-height:1.7;color:var(--ink);
      margin-bottom:11px;transition:border-color .14s, box-shadow .14s, transform .14s;
    }
    .choice:hover{border-color:var(--accent);box-shadow:0 6px 18px rgba(255,159,28,.18);transform:translateY(-1px)}
    .choice .mark{
      font-family:var(--disp);font-weight:800;font-size:13px;color:var(--ink2);
      background:#F1F4F9;border-radius:50%;width:24px;height:24px;flex:none;
      display:flex;align-items:center;justify-content:center;margin-top:2px}
    .choice:hover .mark{background:var(--accent);color:#fff}

    .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin:18px 0 4px}
    .grid img{width:100%;display:block;filter:drop-shadow(0 4px 6px rgba(35,41,54,.14))}

    .axbox{background:#F6F8FC;border-radius:18px;padding:15px 16px 13px;margin:16px 0 14px}
    .axttl{font-family:var(--disp);font-weight:800;font-size:14px;margin:0 0 11px}
    .axrow{display:flex;align-items:center;gap:7px;margin-bottom:8px}
    .axrow .nm{font-family:var(--disp);font-weight:700;font-size:11.5px;color:var(--mute);width:74px;flex:none}
    .ltr{display:inline-flex;align-items:center;gap:5px;background:#fff;border:1.5px solid var(--line);
      border-radius:999px;padding:5px 11px;font-size:12.5px}
    .ltr b{font-family:var(--disp);font-weight:800;color:var(--ink);font-size:14px}
    .axrow .sl{color:var(--mute);font-size:11.5px}
    .axnote{font-size:11.5px;color:var(--ink2);margin:6px 0 0;line-height:1.7}

    label.f{display:block;font-family:var(--disp);font-weight:700;font-size:14px;margin:18px 0 8px}
    input,select{width:100%;font-family:var(--body);font-size:16px;padding:14px;
      border:2px solid var(--line);border-radius:14px;background:#fff;color:var(--ink)}
    input:focus,select:focus{border-color:var(--accent);outline:none}
    .pill{display:flex;gap:7px;flex-wrap:wrap}
    .pill button{flex:1 1 auto;min-width:84px;cursor:pointer;font-family:var(--disp);font-weight:700;font-size:14.5px;
      padding:12px 10px;border:2px solid var(--line);background:#fff;border-radius:999px;color:var(--ink2)}
    .pill button[aria-pressed="true"]{background:var(--primary);border-color:var(--primary);color:#fff}

    #s-result .sheet{border-top:5px solid var(--c)}
    .hero{text-align:center;padding-top:6px}
    .heroimg{position:relative;padding:6px 0 2px}
    .heroimg::before{content:"";position:absolute;left:50%;top:52%;transform:translate(-50%,-50%);
      width:230px;height:230px;border-radius:50%;background:var(--c);opacity:.13;filter:blur(6px)}
    .heroimg img{position:relative;width:230px;max-width:70%;display:block;margin:0 auto;
      filter:drop-shadow(0 10px 16px rgba(35,41,54,.2))}
    .code{font-family:var(--disp);font-weight:800;font-size:12px;letter-spacing:.3em;color:var(--c);margin:12px 0 3px}
    .tname{font-family:var(--disp);font-weight:800;font-size:clamp(27px,8vw,36px);margin:0 0 8px;line-height:1.25;color:var(--c)}
    .catch{font-size:14.5px;color:var(--ink2);margin:0 0 4px}

    .bars{margin:24px 0 4px}
    .bar{margin-bottom:14px}
    .bar .lab{display:flex;justify-content:space-between;font-family:var(--disp);font-weight:700;font-size:12px;color:var(--mute);margin-bottom:5px}
    .bar .lab b{color:var(--ink)}
    .track{height:11px;background:#EDF0F5;border-radius:999px;overflow:hidden;display:flex}
    .track span{display:block;height:100%;background:var(--c)}
    .track span.r{background:#C9CFDA;margin-left:auto}

    .block{border-top:1px solid var(--line);padding-top:16px;margin-top:16px;text-align:left}
    .block h3{font-family:var(--disp);font-weight:800;font-size:13.5px;margin:0 0 8px;color:var(--c);letter-spacing:.02em}
    .block.warn h3{color:#D2691E}
    .block p{margin:0;font-size:14.5px;line-height:1.85}

    .codebox{margin-top:2px}
    .cline{display:flex;gap:12px;align-items:flex-start;background:#F7F9FC;border-radius:16px;padding:12px 14px;margin-bottom:8px}
    .cbig{font-family:var(--disp);font-weight:800;font-size:26px;color:var(--c);line-height:1;width:26px;flex:none;padding-top:2px}
    .cmeta{flex:1}
    .cmeta .t1{font-family:var(--disp);font-weight:700;font-size:14px;margin:0 0 2px}
    .cmeta .t2{font-size:12.5px;color:var(--ink2);margin:0 0 4px;line-height:1.6}
    .cmeta .t3{font-size:11px;color:var(--mute);margin:0;line-height:1.6}
    .cmeta .t3 span{color:var(--ink2);font-weight:600}

    .duo{display:flex;gap:10px;margin-top:4px}
    .duo div{flex:1;text-align:center;background:#F7F9FC;border-radius:16px;padding:10px 6px 12px}
    .duo img{width:100%;max-width:78px;filter:drop-shadow(0 4px 6px rgba(35,41,54,.16))}
    .duo b{display:block;font-family:var(--disp);font-size:12.5px;margin-top:4px;line-height:1.4}
    .duo em{display:block;font-style:normal;font-size:10.5px;color:var(--mute);margin-bottom:2px;font-weight:700;letter-spacing:.08em}

    .note{background:#F6F8FC;border-radius:16px;padding:14px 16px;margin-top:18px;text-align:left}
    .note p{margin:0;font-size:12px;line-height:1.8;color:var(--ink2)}

    .hidden{display:none}
    @media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important}}
    @media print{
      body{background:#fff}
      .noprint{display:none!important}
      .sheet{box-shadow:none;border:1px solid #ddd}
    }
  </style>

  <div class="b8-wrap" id="b8-root" data-lang={currentLang}>
    <a href={t.switchLangUrl} class="lang-switch">{t.switchLangText}</a>

    <!-- ===== 表紙 ===== -->
    <section id="s-intro" class="sheet">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.heading}</h1>
      <p set:html={t.intro}></p>
      <div class="grid" id="introGrid"></div>
      <div class="axbox">
        <p class="axttl">{t.axTitle}</p>
        <div id="axList"></div>
        <p class="axnote">{t.axNote}</p>
      </div>
      <p class="muted" set:html={t.muted}></p>
      <button type="button" class="btn" id="startBtn">{t.startBtn}</button>
    </section>

    <!-- ===== 設問 ===== -->
    <section id="s-quiz" class="sheet hidden">
      <p class="count" id="count"></p>
      <div class="prog" id="prog"></div>
      <span class="scene" id="scene"></span>
      <p class="qtext" id="qtext"></p>
      <div id="choices"></div>
      <button type="button" class="btn ghost" id="backBtn">{t.backBtn}</button>
    </section>

    <!-- ===== 属性 ===== -->
    <section id="s-profile" class="sheet hidden">
      <p class="eyebrow">{t.profileEyebrow}</p>
      <h2>{t.profileTitle}</h2>
      <p class="muted">{t.profileDesc}</p>

      <label class="f" for="age">{t.labelAge}</label>
      <select id="age">
        <option value="">{t.optNoSelect}</option>
        <option>{currentLang === 'en' ? '12 or under' : '12歳以下'}</option>
        <option>{currentLang === 'en' ? '13-15' : '13〜15歳'}</option>
        <option>{currentLang === 'en' ? '16-18' : '16〜18歳'}</option>
        <option>{currentLang === 'en' ? '19-22' : '19〜22歳'}</option>
        <option>{currentLang === 'en' ? '23-29' : '23〜29歳'}</option>
        <option>{currentLang === 'en' ? '30-39' : '30〜39歳'}</option>
        <option>{currentLang === 'en' ? '40-49' : '40〜49歳'}</option>
        <option>{currentLang === 'en' ? '50-59' : '50〜59歳'}</option>
        <option>{currentLang === 'en' ? '60 or older' : '60歳以上'}</option>
      </select>

      <label class="f">{t.sexTitle}</label>
      <div class="pill" id="sexPill">
        <button type="button" data-v={currentLang === 'en' ? 'Female' : '女性'} aria-pressed="false">{t.sexFemale}</button>
        <button type="button" data-v={currentLang === 'en' ? 'Male' : '男性'} aria-pressed="false">{t.sexMale}</button>
        <button type="button" data-v={currentLang === 'en' ? 'Other' : 'その他'} aria-pressed="false">{t.sexOther}</button>
        <button type="button" data-v={currentLang === 'en' ? 'Prefer not to say' : '答えない'} aria-pressed="false">{t.sexNone}</button>
      </div>

      <label class="f" for="mail">{t.labelMail}</label>
      <input id="mail" type="email" inputmode="email" placeholder="you@example.com" autocomplete="email">
      <p class="muted" style="margin-top:8px">{t.mailDesc}</p>

      <button type="button" class="btn" id="resultBtn" style="margin-top:22px">{t.resultBtn}</button>
    </section>

    <!-- ===== 結果 ===== -->
    <section id="s-result" class="hidden">
      <div class="sheet hero" id="card">
        <div class="heroimg"><img id="rImg" alt=""></div>
        <p class="code" id="rCode"></p>
        <h2 class="tname" id="rName"></h2>
        <p class="catch" id="rCatch"></p>

        <div class="bars" id="rBars"></div>

        <div class="block">
          <h3>{t.codeMeaning}</h3>
          <div class="codebox" id="rCode3"></div>
        </div>

        <div class="block"><h3>{t.good}</h3><p id="rGood"></p></div>
        <div class="block"><h3>{t.post}</h3><p id="rPost"></p></div>
        <div class="block warn"><h3>{t.blind}</h3><p id="rBlind"></p></div>
        <div class="block"><h3>{t.step}</h3><p id="rStep"></p></div>
        <div class="block">
          <h3>{t.buddy} &amp; {t.opp}</h3>
          <div class="duo">
            <div><em id="lblBuddy">{t.buddy}</em><img id="rBuddyImg" alt=""><b id="rBuddy"></b></div>
            <div><em id="lblOpp">{t.opp}</em><img id="rOppImg" alt=""><b id="rOpp"></b></div>
          </div>
          <p class="muted" style="margin-top:10px" id="rPairNote"></p>
        </div>
        <div class="block"><h3>{t.theme}</h3><p id="rTheme"></p></div>

        <div class="note">
          <p>{t.noteFoot}</p>
        </div>
      </div>

      <div class="sheet noprint">
        <h2>{t.saveTitle}</h2>
        <p class="muted" id="mailNote"></p>
        <button type="button" class="btn sign" id="mailBtn">{t.mailBtn}</button>
        <button type="button" class="btn ghost" id="printBtn">{t.printBtn}</button>
        <button type="button" class="btn ghost" id="againBtn">{t.againBtn}</button>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ currentLang, IMG }}>
  (function() {
    var root = document.getElementById('b8-root');
    if (!root) return;
    var IS_EN = currentLang === 'en';
    const GAS_ENDPOINT = "https://script.google.com/macros/s/AKfycbwmzKCxc363Di8WzGTIccpIICGfU26YNufoJ5h0SwjOlgbPN-zXgiEeorvcFQyRXxBO/exec";

    var TYPES = {
      PSB:{col:"#EF5A48",key:"hamster",name:IS_EN ? "Swift Hamster" : "てきぱきハムスター",catch:IS_EN ? "Quickly help the person right in front using established methods." : "決まったやり方で、目の前の一人をすぐ助ける",
        good:IS_EN?"Fast in structured tasks.":"やることが決まっている場面での速さが持ち味。手順を守れるので、任せたことが確実に終わります。慌てている人の隣で、淡々と手を動かせる強さがあります。",
        post:IS_EN?"First aid & logistics.":"応急手当、荷物運び、体調の確認。人手が要る作業を、抜けなく回す役。",
        blind:IS_EN?"Struggles outside standard procedures.":"手順にないことが起きると足が止まりがち。ひとりで抱え込んで、助けを呼びそびれることも。",
        step:IS_EN?"Take a first aid course.":"救命講習（普通救命講習Ⅰなど）を受けてみる。手順を1つ増やすと、動ける場面が増えます。",
        buddy:"MSN", opp:"MIN",
        theme:IS_EN?"Emergency response procedures":"災害時の応急対応と手順化"},
