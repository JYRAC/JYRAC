---
import Layout from '../layouts/Layout.astro';

// URLから言語パラメータを取得 (例: /bosai8?lang=en)
const requestUrl = Astro.request.url.replace(/^http:/, 'https:');
const url = new URL(requestUrl);
const currentLang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';

// 多言語テキスト辞書
const dict = {
