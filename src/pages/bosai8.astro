---
import Layout from '../layouts/Layout.astro';

const requestUrl = Astro.request.url.replace(/^http:/, 'https:');
const url = new URL(requestUrl);
const currentLang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = {
  title: currentLang === 'en' ? "Bosai 8 ｜ Disaster Mutual-Aid Type Quiz" : "ぼうさい8 ｜ 防災共助タイプ診断",
  eyebrow: currentLang === 'en' ? "JYRAC Disaster Mutual-Aid Type Quiz" : "JYRAC 防災共助タイプ診断",
  heading: currentLang === 'en' ? "Bosai 8" : "ぼうさい8",
  intro: currentLang === 'en' 
    ? "In a disaster, there isn't just one way to help.<br>Based on your choices in 20 scenarios, find out which of the 8 animal helper types fits you best."
    : "災害のとき、人の助け方はひとつじゃない。<br>20の場面であなたが選んだ行動から、8匹のうちどの助け方に近いかを見つけます。",
  axTitle: currentLang === 'en' ? "Divided into 8 types across 3 axes" : "3つの軸で、8タイプに分かれます",
  axNote: currentLang === 'en' ? "The 3-letter combination (e.g., P-S-N) becomes your type code." : "3文字の組み合わせ（例：P・S・N）が、あなたのタイプコードになります。",
  muted: currentLang === 'en'
    ? "15 questions + 5 profile items / 2-3 minutes. There are no right or wrong answers.<br>5 questions are randomly chosen from 10 per axis, so questions change each time."
    : "15問＋5問／2〜3分。正解はありません。<br>設問は各軸10問の中から5問ずつ選ばれるので、やるたびに出題は変わります。",
  startBtn: currentLang === 'en' ? "Start" : "はじめる",
  backBtn: currentLang === 'en' ? "← Back" : "← ひとつ前にもどる",
  profileEyebrow: currentLang === 'en' ? "Almost Done" : "あと少し",
  profileTitle: currentLang === 'en' ? "Tell us a bit about yourself" : "あなたについて教えてください",
  profileDesc: currentLang === 'en' ? "Statistical data used by JYRAC for research. No names are collected." : "JYRAC が防災教育の研究に使う統計データです。氏名は集めません。",
  labelAge: currentLang === 'en' ? "Age" : "年齢",
  optNoSelect: currentLang === 'en' ? "Prefer not to say" : "選ばない",
  sexTitle: currentLang === 'en' ? "Gender" : "性別",
  sexFemale: currentLang === 'en' ? "Female" : "女性",
  sexMale: currentLang === 'en' ? "Male" : "男性",
  sexOther: currentLang === 'en' ? "Other" : "その他",
  sexNone: currentLang === 'en' ? "Prefer not to say" : "答えない",
  labelMail: currentLang === 'en' ? "Email to send results (optional)" : "結果を送るメールアドレス（任意）",
  mailDesc: currentLang === 'en' ? "If entered, you can create an email to yourself." : "入力すると、結果画面から自分あてのメールを作成できます。",
  resultBtn: currentLang === 'en' ? "View Results" : "結果を見る",
  codeMeaning: currentLang === 'en' ? "Meaning of Your Code" : "コードの意味",
  good: currentLang === 'en' ? "Your Strengths" : "きみの得意",
  post: currentLang === 'en' ? "Shelter Role" : "避難所での持ち場",
  blind: currentLang === 'en' ? "Things to Watch Out For" : "気をつけたいこと",
  step: currentLang === 'en' ? "Your First Step Today" : "今日からの一歩",
  buddy: currentLang === 'en' ? "Buddy" : "相棒",
  opp: currentLang === 'en' ? "Opposite" : "正反対",
  theme: currentLang === 'en' ? "To Learn More" : "もっと知りたい人へ",
  noteFoot: currentLang === 'en' ? "Your animal type can change depending on your environment and role." : "あなたの動物は、置かれた場所や役割で変わります。",
  saveTitle: currentLang === 'en' ? "Save Your Results" : "結果を残す",
  mailBtn: currentLang === 'en' ? "Create Email" : "メールを作成する",
  printBtn: currentLang === 'en' ? "Print Card / Save as PDF" : "このカードを印刷 / PDFで保存",
  againBtn: currentLang === 'en' ? "Take Again" : "もう一度やる",
  switchLangText: currentLang === 'en' ? "日本語" : "English",
  switchLangUrl: currentLang === 'en' ? "/bosai8" : "/bosai8?lang=en"
};
---

<Layout title={t.title} currentTab="bosai8">
  <style is:global>
    :root{
      --bg1:#F2F7FF; --bg2:#FFF8F0; --card:#ffffff;
      --ink:#232936; --ink2:#6E7684; --mute:#9AA1AC;
      --line:#E6E9F0; --accent:#FF9F1C; --primary:#232936; --c:#232936; --r:24px;
      --disp:"M PLUS Rounded 1c",sans-serif; --body:"Zen Kaku Gothic New",sans-serif;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0}
    body{font-family:var(--body);color:var(--ink);background:linear-gradient(170deg, var(--bg1), var(--bg2));min-height:100vh;}
    .b8-wrap{display:block;width:100%;max-width:600px;margin:0 auto;padding:20px 16px 60px;position:relative;}
    .lang-switch{position:absolute;top:15px;right:16px;background:#fff;border:2px solid var(--line);border-radius:999px;padding:6px 14px;font-weight:700;font-size:13px;cursor:pointer;color:var(--ink);text-decoration:none;z-index:10;}
    .sheet{position:relative;background:var(--card);border-radius:var(--r);box-shadow:0 12px 30px rgba(35,41,54,.08);padding:26px 22px 24px;}
    .sheet + .sheet{margin-top:16px}
    h1{font-family:var(--disp);font-weight:800;font-size:clamp(32px,9vw,46px);margin:0 0 8px;}
    h2{font-family:var(--disp);font-weight:800;font-size:20px;margin:0 0 10px;}
    .eyebrow{font-family:var(--disp);font-weight:700;font-size:11.5px;letter-spacing:.2em;color:var(--accent);margin:0 0 10px}
    p{line-height:1.85;margin:0 0 14px;font-size:15px}
    .muted{color:var(--ink2);font-size:12.5px;line-height:1.8}
    .btn{display:block;width:100%;border:none;cursor:pointer;font-family:var(--disp);font-weight:700;font-size:17px;background:var(--primary);color:#fff;padding:17px;border-radius:999px;}
    .btn.sign{background:var(--accent);color:#3A2400;}
    .btn.ghost{background:transparent;color:var(--ink2);font-size:14px;padding:11px}
    .prog{display:flex;gap:3px;margin:0 0 18px}
    .prog i{flex:1;height:7px;background:#EDF0F5;border-radius:999px;}
    .prog i.on{background:var(--dot)}
    .prog i.cur{background:var(--dot);transform:scaleY(1.9)}
    .count{font-family:var(--disp);font-weight:700;font-size:12px;color:var(--mute);margin:0 0 8px}
    .scene{font-family:var(--disp);font-weight:700;font-size:12.5px;color:#fff;background:var(--primary);display:inline-block;padding:5px 13px;border-radius:999px;margin-bottom:12px}
    .qtext{font-size:16px;line-height:1.9;margin:0 0 20px}
    .choice{display:flex;align-items:flex-start;gap:12px;width:100%;text-align:left;cursor:pointer;background:#fff;border:2px solid var(--line);border-radius:18px;padding:15px 16px;font-size:15.5px;margin-bottom:11px;}
    .choice .mark{font-family:var(--disp);font-weight:800;font-size:13px;color:var(--ink2);background:#F1F4F9;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;margin-top:2px}
    .b8-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin:18px auto 4px;}
    .b8-grid img{width:100%;height:auto;display:block;object-fit:contain;filter:drop-shadow(0 4px 6px rgba(35,41,54,.14))}
    .axbox{background:#F6F8FC;border-radius:18px;padding:15px 16px;margin:16px 0 14px}
    .axrow{display:flex;align-items:center;gap:7px;margin-bottom:8px}
    .axrow .nm{font-weight:700;font-size:11.5px;color:var(--mute);width:74px;}
    .ltr{background:#fff;border:1.5px solid var(--line);border-radius:999px;padding:5px 11px;font-size:12.5px}
    label.f{display:block;font-family:var(--disp);font-weight:700;font-size:14px;margin:18px 0 8px}
    input,select{width:100%;font-size:16px;padding:14px;border:2px solid var(--line);border-radius:14px;background:#fff;}
    .pill{display:flex;gap:7px;flex-wrap:wrap}
    .pill button{flex:1;cursor:pointer;font-weight:700;padding:12px 10px;border:2px solid var(--line);background:#fff;border-radius:999px;color:var(--ink2)}
    .pill button[aria-pressed="true"]{background:var(--primary);border-color:var(--primary);color:#fff}
    .hero{text-align:center;}
    .heroimg{position:relative;padding:6px 0 2px}
    .heroimg::before{content:"";position:absolute;left:50%;top:52%;transform:translate(-50%,-50%);width:230px;height:230px;border-radius:50%;background:var(--c);opacity:.13;filter:blur(6px)}
    .heroimg img{position:relative;width:230px;max-width:70%;display:block;margin:0 auto;filter:drop-shadow(0 10px 16px rgba(35,41,54,.2))}
    .code{font-family:var(--disp);font-weight:800;font-size:12px;letter-spacing:.3em;color:var(--c);margin:12px 0 3px}
    .tname{font-family:var(--disp);font-weight:800;font-size:32px;margin:0 0 8px;color:var(--c)}
    .catch{font-size:14.5px;color:var(--ink2);margin:0 0 4px}
    .bars{margin:24px 0}
    .bar{margin-bottom:14px}
    .bar .lab{display:flex;justify-content:space-between;font-weight:700;font-size:12px;color:var(--mute);margin-bottom:5px}
    .track{height:11px;background:#EDF0F5;border-radius:999px;display:flex}
    .track span{height:100%;background:var(--c)}
    .track span.r{background:#C9CFDA;margin-left:auto}
    .block{border-top:1px solid var(--line);padding-top:16px;margin-top:16px;text-align:left}
    .block h3{font-family:var(--disp);font-weight:800;font-size:13.5px;margin:0 0 8px;color:var(--c);}
    .duo{display:flex;gap:10px;margin-top:4px}
    .duo div{flex:1;text-align:center;background:#F7F9FC;border-radius:16px;padding:10px}
    .duo img{width:100%;max-width:78px;filter:drop-shadow(0 4px 6px rgba(35,41,54,.16))}
    .note{background:#F6F8FC;border-radius:16px;padding:14px 16px;margin-top:18px;text-align:left;font-size:12px;color:var(--ink2)}
    .hidden{display:none}
  </style>

<div class="b8-wrap" id="b8-root" data-lang={currentLang}>
  <a href={t.switchLangUrl} class="lang-switch">{t.switchLangText}</a>

  <section id="s-intro" class="sheet">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.heading}</h1>
    <p set:html={t.intro}></p>
    <div class="b8-grid" id="introGrid"></div>
    <div class="axbox">
      <p class="axttl">{t.axTitle}</p>
      <div id="axList"></div>
      <p class="axnote">{t.axNote}</p>
    </div>
    <p class="muted" set:html={t.muted}></p>
    <button type="button" class="btn" id="startBtn">{t.startBtn}</button>
  </section>

  <section id="s-quiz" class="sheet hidden">
    <p class="count" id="count"></p>
    <div class="prog" id="prog"></div>
    <span class="scene" id="scene"></span>
    <p class="qtext" id="qtext"></p>
    <div id="choices"></div>
    <button type="button" class="btn ghost" id="backBtn">{t.backBtn}</button>
  </section>

  <section id="s-profile" class="sheet hidden">
    <p class="eyebrow">{t.profileEyebrow}</p>
    <h2>{t.profileTitle}</h2>
    <p class="muted">{t.profileDesc}</p>

    <label class="f" for="age">{t.labelAge}</label>
    <select id="age">
      <option value="">{t.optNoSelect}</option>
      <option>{currentLang === 'en' ? '12 or under' : '12歳以下'}</option>
      <option>{currentLang === 'en' ? '13–15' : '13〜15歳'}</option>
      <option>{currentLang === 'en' ? '16–18' : '16〜18歳'}</option>
      <option>{currentLang === 'en' ? '19–22' : '19〜22歳'}</option>
      <option>{currentLang === 'en' ? '23–29' : '23〜29歳'}</option>
      <option>{currentLang === 'en' ? '30–39' : '30〜39歳'}</option>
      <option>{currentLang === 'en' ? '40–49' : '40〜49歳'}</option>
      <option>{currentLang === 'en' ? '50–59' : '50〜59歳'}</option>
      <option>{currentLang === 'en' ? '60 or older' : '60歳以上'}</option>
    </select>

    <label class="f">{t.sexTitle}</label>
    <div class="pill" id="sexPill">
      <button type="button" data-v={currentLang === 'en' ? 'Female' : '女性'} aria-pressed="false">{t.sexFemale}</button>
      <button type="button" data-v={currentLang === 'en' ? 'Male' : '男性'} aria-pressed="false">{t.sexMale}</button>
      <button type="button" data-v={currentLang === 'en' ? 'Other' : 'その他'} aria-pressed="false">{t.sexOther}</button>
      <button type="button" data-v={currentLang === 'en' ? 'Prefer not to say' : '答えない'} aria-pressed="false">{t.sexNone}</button>
    </div>

    <label class="f" for="mail">{t.labelMail}</label>
    <input id="mail" type="email" inputmode="email" placeholder="you@example.com" autocomplete="email">
    <p class="muted" style="margin-top:8px">{t.mailDesc}</p>

    <button type="button" class="btn" id="resultBtn" style="margin-top:22px">{t.resultBtn}</button>
  </section>

  <section id="s-result" class="hidden">
    <div class="sheet hero" id="card">
      <div class="heroimg"><img id="rImg" alt=""></div>
      <p class="code" id="rCode"></p>
      <h2 class="tname" id="rName"></h2>
      <p class="catch" id="rCatch"></p>

      <div class="bars" id="rBars"></div>

      <div class="block">
        <h3>{t.codeMeaning}</h3>
        <div class="codebox" id="rCode3"></div>
      </div>

      <div class="block"><h3>{t.good}</h3><p id="rGood"></p></div>
      <div class="block"><h3>{t.post}</h3><p id="rPost"></p></div>
      <div class="block warn"><h3>{t.blind}</h3><p id="rBlind"></p></div>
      <div class="block"><h3>{t.step}</h3><p id="rStep"></p></div>
      <div class="block">
        <h3>{t.buddy} & {t.opp}</h3>
        <div class="duo">
          <div><em id="lblBuddy">{t.buddy}</em><img id="rBuddyImg" alt=""><b id="rBuddy"></b></div>
          <div><em id="lblOpp">{t.opp}</em><img id="rOppImg" alt=""><b id="rOpp"></b></div>
        </div>
      </div>
      <div class="block"><h3>{t.theme}</h3><p id="rTheme"></p></div>

      <div class="note">
        <p>{t.noteFoot}</p>
      </div>
    </div>

    <div class="sheet noprint">
      <h2>{t.saveTitle}</h2>
      <p class="muted" id="mailNote"></p>
      <button type="button" class="btn sign" id="mailBtn">{t.mailBtn}</button>
      <button type="button" class="btn ghost" id="printBtn">{t.printBtn}</button>
      <button type="button" class="btn ghost" id="againBtn">{t.againBtn}</button>
    </div>
  </section>
</div>

<script is:inline>
(function() {
  const root = document.getElementById('b8-root');
  if (!root) return;
  const currentLang = root.getAttribute('data-lang') || 'ja';
  const IS_EN = currentLang === 'en';

  const IMG = {
    "hamster": "data:image/webp;base64,*EOF"
  };

  const AXES = [
    {name: IS_EN ? "Support Function" : "支援機能", a:"P", b:"M"},
    {name: IS_EN ? "Action Style" : "行動様式", a:"S", b:"I"},
    {name: IS_EN ? "Support Range" : "支援射程", a:"B", b:"N"}
  ];

  const LETTER = {
    P:{en:"Performance", ja:"課題", line:IS_EN ? "First, resolve the problem itself." : "まず、困りごとそのものを片づけにいく。"},
    M:{en:"Maintenance", ja:"情緒", line:IS_EN ? "First, help the person feel at ease." : "まず、その人の気持ちが落ち着くほうへ動く。"},
    S:{en:"Structured", ja:"定型", line:IS_EN ? "Strong at following established patterns." : "決まっている型を、確実に回して強い。"},
    I:{en:"Improvised", ja:"即興", line:IS_EN ? "Create new solutions with what is on hand." : "その場にあるもので、新しいやり方を作る。"},
    B:{en:"Beside", ja:"近接", line:IS_EN ? "Engage deeply with the person right in front of you." : "目の前の一人に、深く関わる。"},
    N:{en:"Network", ja:"広域", line:IS_EN ? "Move broadly to reach the entire community." : "全体に届くように、広く動く。"}
  };

  const TYPES = {
    PSB:{col:"#EF5A48",key:"hamster",name:IS_EN ? "Swift Hamster" : "てきぱきハムスター",catch:IS_EN ? "Quickly help the person right in front using established methods." : "決まったやり方で、目の前の一人をすぐ助ける", good:IS_EN?"Fast in structured tasks.":"やることが決まっている場面での速さが持ち味。", post:IS_EN?"First aid & logistics.":"応急手当、荷物運び。", blind:IS_EN?"Struggles outside standard procedures.":"手順にないことが起きると足が止まりがち。", step:IS_EN?"Take a first aid course.":"救命講習を受けてみる。", buddy:"MSN", opp:"MIN", theme:IS_EN?"Emergency response procedures":"災害時の応急対応と手順化"},
    PSN:{col:"#F06A18",key:"ant",name:IS_EN ? "Organized Ant" : "だんどりアリ",catch:IS_EN ? "Smoothly manage overall tasks and resources." : "全体の仕事と物を、きちんと回す", good:IS_EN?"Great at organizing people and resources.":"人と物の流れを俯瞰して整えるのが得意。", post:IS_EN?"Supplies & reception.":"物資、受付、名簿。", blind:IS_EN?"Overlooks subtle personal struggles.":"数字にならない苦しさを見落としがち。", step:IS_EN?"Read shelter manuals.":"避難所運営マニュアルを読み返す。", buddy:"MSB", opp:"MIB", theme:IS_EN?"Shelter management organization":"避難所運営と組織対応"},
    PIB:{col:"#E8AF1E",key:"squirrel",name:IS_EN ? "Resourceful Squirrel" : "こうさくリス",catch:IS_EN ? "Solve immediate problems with available items." : "ありもので、目の前の困りごとを解決する", good:IS_EN?"Skilled at improvising solutions.":"道具がなくても何とかしてしまう手先の強さ。", post:IS_EN?"Bedding & toilet setup.":"段ボールベッド、簡易トイレ作り。", blind:IS_EN?"Might bypass safety rules.":"勢いで安全のルールを飛び越えることが.", step:IS_EN?"Try building a cardboard bed.":"段ボールベッドを作ってみる。", buddy:"MIN", opp:"MSN", theme:IS_EN?"Improvisation in disasters":"災害対応における即興"},
    PIN:{col:"#14875C",key:"beaver",name:IS_EN ? "System Beaver" : "しくみビーバー",catch:IS_EN ? "Build new systems that everyone can use." : "みんなが使える新しい仕組みを作る", good:IS_EN?"Good at creating structures and maps.":"仕組み化して分かりやすく整理するのが得意。", post:IS_EN?"Information & signage.":"掲示、情報整理。", blind:IS_EN?"May build overly complex systems.":"現場が実際には使えない仕組みを作ることも。", step:IS_EN?"Create a local hazard map.":"地域の危険マップを作る。", buddy:"MIB", opp:"MSB", theme:IS_EN?"Information organization":"情報整理と創発的組織"},
    MSB:{col:"#8B44A8",key:"owl",name:IS_EN ? "Watchful Owl" : "みまもりフクロウ",catch:IS_EN ? "Quietly notice and stay by someone's side." : "静かに気づいて、そばにいる", good:IS_EN?"Observant of emotional changes.":"人の様子の小さな変化に気づける観察力。", post:IS_EN?"Patrols & consultation.":"巡回、相談役。", blind:IS_EN?"Hesitates to speak up.":"気づいても言い出せずに抱えがち。", step:IS_EN?"Learn neighbors' names.":"近所の人の名前をおぼえる。", buddy:"PSN", opp:"PIN", theme:IS_EN?"Emotional support":"情緒的支援とケア"},
    MSN:{col:"#123A96",name:IS_EN ? "Cheerful Penguin" : "なごませペンギン",catch:IS_EN ? "Warm the atmosphere and help everyone settle down." : "場の空気をあたためて、みんなを落ち着かせる", good:IS_EN?"Eases tense atmosphere.":"張りつめた空気をゆるめられる人。", post:IS_EN?"Meeting facilitation.":"運営会議の進行。", blind:IS_EN?"Reluctant to address hard issues.":"深刻な問題を流してしまうことが。", step:IS_EN?"Practice drawing out quiet voices.":"まだ話していない人に声をかける。", buddy:"PSB", opp:"PIB", theme:IS_EN?"Group maintenance":"集団維持機能"},
    MIB:{col:"#1BBFC6",key:"otter",name:IS_EN ? "Playful Otter" : "あそびカワウソ",catch:IS_EN ? "Lighten the mood with spontaneous sparks of joy." : "その場のひらめきで、心を軽くする", good:IS_EN?"Brings smiles and playfulness.":"笑いや遊びを持ち込める人。", post:IS_EN?"Children's play space.":"子どもの遊び場作り。", blind:IS_EN?"May be too energetic for tired people.":"盛り上げすぎて疲れてしまうことも。", step:IS_EN?"Memorize simple games.":"簡単な遊びを覚えておく。", buddy:"PIN", opp:"PSN", theme:IS_EN?"Children's safe spaces":"子どもの居場所作り"},
    MIN:{col:"#EE6A9E",name:IS_EN ? "Connecting Dolphin" : "つなぎイルカ",catch:IS_EN ? "Energize everyone through voice and connections." : "声とつながりで、みんなを元気にする", good:IS_EN?"Connects inside and outside groups.":"人と人、地域と外を結ぶのが得意。", post:IS_EN?"External communications.":"外部連携・発信。", blind:IS_EN?"May lose track of internal needs.":"つないだところで手を離してしまいがち。", step:IS_EN?"Build connections outside school.":"外とのつながりを作る。", buddy:"PIB", opp:"PSB", theme:IS_EN?"Social capital":"ソーシャルキャピタル"}
  };

  const QS = [
    {ax:"P",scene:IS_EN?"Waiting":"待機",text:IS_EN?"Friend is restless after earthquake. What do you do?":"地震のあと友達が落ち着かない。どうする？",o:[{t:IS_EN?"Check needs":"必要なものや困りごとを確認",p:"P"},{t:IS_EN?"Listen to feelings":"話を聞く",p:"M"}]},
    {ax:"P",scene:IS_EN?"Drill":"訓練",text:IS_EN?"Someone stops during a drill. What do you do?":"訓練中に動けない人がいる。どうする？",o:[{t:IS_EN?"Organize next steps":"次にすることを整理",p:"P"},{t:IS_EN?"Check how they feel":"様子を見る",p:"M"}]},
    {ax:"P",scene:IS_EN?"Rain":"大雨",text:IS_EN?"Stuck at school in heavy rain, someone checks phone.":"大雨で帰れず、スマホを見ている人がいる。",o:[{t:IS_EN?"Check info together":"情報を確認",p:"P"},{t:IS_EN?"Ask what worries them":"心配を聞く",p:"M"}]},
    {ax:"P",scene:IS_EN?"Tired":"疲労",text:IS_EN?"Team member looks exhausted after drill.":"訓練後、班の人が疲れている。",o:[{t:IS_EN?"Reduce burden":"負担を減らす",p:"P"},{t:IS_EN?"Talk and rest":"休みながら声をかける",p:"M"}]},
    {ax:"P",scene:IS_EN?"Quiet":"沈黙",text:IS_EN?"Someone stopped speaking in a discussion.":"話し合いで発言しなくなった人がいる。",o:[{t:IS_EN?"Check if unclear":"内容を確認",p:"P"},{t:IS_EN?"Ask how they feel":"気持ちを聞く",p:"M"}]},
    {ax:"P",scene:IS_EN?"Blackout":"停電",text:IS_EN?"Child cries in dark shelter.":"避難所の夜、子供が泣いている。",o:[{t:IS_EN?"Find light":"明かりを探す",p:"P"},{t:IS_EN?"Sit by them":"そばに座る",p:"M"}]},
    {ax:"P",scene:IS_EN?"Line":"列",text:IS_EN?"Someone is frustrated in long line.":"受付の列で怒っている人がいる。",o:[{t:IS_EN?"Tell timing":"順番を伝える",p:"P"},{t:IS_EN?"Calm them":"気持ちを受け止める",p:"M"}]},
    {ax:"P",scene:IS_EN?"Contact":"連絡",text:IS_EN?"Cannot reach family after earthquake.":"家族と連絡がつかない人がいる。",o:[{t:IS_EN?"Try methods":"方法を探す",p:"P"},{t:IS_EN?"Keep company":"話し相手になる",p:"M"}]},
    {ax:"P",scene:IS_EN?"Family":"家族",text:IS_EN?"Family arrives, looks overwhelmed.":"避難所に着いた家族が困っている。",o:[{t:IS_EN?"Secure space":"場所を確保",p:"P"},{t:IS_EN?"Let them rest":"休んでもらう",p:"M"}]},
    {ax:"P",scene:IS_EN?"Camp":"合宿",text:IS_EN?"Earthquake at camp, some frozen.":"合宿先で動けない人がいる。",o:[{t:IS_EN?"Start moving":"動き出す",p:"P"},{t:IS_EN?"Speak individually":"声をかける",p:"M"}]},
    {ax:"S",scene:IS_EN?"Festival":"文化祭",text:IS_EN?"Earthquake at school festival.":"文化祭中に地震が起きた。",o:[{t:IS_EN?"Use main route":"決まったルートで行く",p:"S"},{t:IS_EN?"Open new route":"別のルートを作る",p:"I"}]},
    {ax:"S",scene:IS_EN?"Prep":"準備",text:IS_EN?"Almost no disaster prep before festival.":"防災の備えが整っていない。",o:[{t:IS_EN?"Use past schedule":"過去の表を使う",p:"S"},{t:IS_EN?"Recreate plan":"新しく作る",p:"I"}]},
    {ax:"S",scene:IS_EN?"Drill Type":"訓練",text:IS_EN?"Deciding drill content.":"防災訓練の内容を決める。",o:[{t:IS_EN?"Repeat standard":"毎年同じ手順",p:"S"},{t:IS_EN?"Add unexpected":"想定外を入れる",p:"I"}]},
    {ax:"S",scene:IS_EN?"Queue":"配給",text:IS_EN?"Distribution queue breaking down.":"配給の列が崩れている。",o:[{t:IS_EN?"Organize line":"列を整える",p:"S"},{t:IS_EN?"Make new layout":"新しい並び方を作る",p:"I"}]},
    {ax:"S",scene:IS_EN?"Foreigners":"外国人",text:IS_EN?"Foreign evacuees arrive without interpreter.":"外国人の避難者が来た。",o:[{t:IS_EN?"Use guide sheet":"案内シートを使う",p:"S"},{t:IS_EN?"Improvise":"工夫して伝える",p:"I"}]},
    {ax:"S",scene:IS_EN?"Assembly":"集合",text:IS_EN?"Assembly point blocked.":"集合場所が使えない。",o:[{t:IS_EN?"Use backup point":"第二集合場所へ",p:"S"},{t:IS_EN?"Find new place":"新しい場所を探す",p:"I"}]},
    {ax:"S",scene:IS_EN?"Manual":"マニュアル",text:IS_EN?"Thick manual unread.":"分厚いマニュアルがある。",o:[{t:IS_EN?"Extract pages":"必要なページを抜粋",p:"S"},{t:IS_EN?"Decide on spot":"その場で決める",p:"I"}]},
    {ax:"S",scene:IS_EN?"PA":"放送",text:IS_EN?"No school PA.":"校内放送が使えない。",o:[{t:IS_EN?"Messenger system":"伝達係を使う",p:"S"},{t:IS_EN?"Megaphone":"マイクを使う",p:"I"}]},
    {ax:"S",scene:IS_EN?"Kitchen":"炊き出し",text:IS_EN?"Soup kitchen too slow.":"炊き出しが遅い。",o:[{t:IS_EN?"Increase staff":"人手を増やす",p:"S"},{t:IS_EN?"Change method":"やり方を変える",p:"I"}]},
    {ax:"S",scene:IS_EN?"Storage":"倉庫",text:IS_EN?"Supply locations changed.":"備品の場所が変わった。",o:[{t:IS_EN?"Match list":"リスト通り確認",p:"S"},{t:IS_EN?"Grab visually":"見た目で判断",p:"I"}]},
    {ax:"B",scene:IS_EN?"Event":"イベント",text:IS_EN?"Planning disaster event.":"防災イベントを企画する。",o:[{t:IS_EN?"Deep prep few":"少数で深く",p:"B"},{t:IS_EN?"School-wide":"全校に呼びかけ",p:"N"}]},
    {ax:"B",scene:IS_EN?"Committee":"委員会",text:IS_EN?"Starting committee.":"委員会を作る。",o:[{t:IS_EN?"Reliable few":"確実に動く数人",p:"B"},{t:IS_EN?"All school":"学校全体",p:"N"}]},
    {ax:"B",scene:IS_EN?"Needs":"把握",text:IS_EN?"Manager asks what's missing.":"何が足りないか聞かれた。",o:[{t:IS_EN?"Ask individually":"直接聞いて回る",p:"B"},{t:IS_EN?"General call":"全員に呼びかけ",p:"N"}]},
    {ax:"B",scene:IS_EN?"Supplies":"物資",text:IS_EN?"Limited relief supplies.":"支援物資が届いた。",o:[{t:IS_EN?"Deliver directly":"直接届ける",p:"B"},{t:IS_EN?"Uniform distribution":"一斉に配る",p:"N"}]},
    {ax:"B",scene:IS_EN?"Free time":"自由時間",text:IS_EN?"Free 30 minutes in shelter.":"避難所で手が空いた。",o:[{t:IS_EN?"Talk to one person":"気になる人と話す",p:"B"},{t:IS_EN?"Check all":"声をかけて回る",p:"N"}]},
    {ax:"B",scene:IS_EN?"Sleep":"睡眠",text:IS_EN?"People unable to sleep.":"眠れていない人がいる。",o:[{t:IS_EN?"Listen to one":"一人とじっくり",p:"B"},{t:IS_EN?"Check all":"順に声をかける",p:"N"}]},
    {ax:"B",scene:IS_EN?"Talk":"発表",text:IS_EN?"15-min disaster talk.":"15分の話をする。",o:[{t:IS_EN?"One story":"一人の体験を深く",p:"B"},{t:IS_EN?"General basics":"基本を広く",p:"N"}]},
    {ax:"B",scene:IS_EN?"Drill group":"訓練",text:IS_EN?"At local drill with strangers.":"地域の訓練に参加した。",o:[{t:IS_EN?"Talk to one":"一人とおぼえる",p:"B"},{t:IS_EN?"Greet many":"多くの人と挨拶",p:"N"}]},
    {ax:"B",scene:IS_EN?"Surplus":"余り",text:IS_EN?"Supplies left over.":"物資が余った。",o:[{t:IS_EN?"Give to one in need":"必要な人に渡す",p:"B"},{t:IS_EN?"Share widely":"多くの人に分ける",p:"N"}]},
    {ax:"B",scene:IS_EN?"SNS":"発信",text:IS_EN?"Updating shelter on social media.":"SNSで伝える。",o:[{t:IS_EN?"One story":"一人の話を書く",p:"B"},{t:IS_EN?"Overall status":"全体の状態を出す",p:"N"}]}
  ];

  const COV = [
    {ax:"cov",key:"防災経験",scene:IS_EN?"Experience":"防災経験",text:IS_EN?"Experience in drills/volunteering?":"防災訓練やボランティアの経験があるか",o:[{t:IS_EN?"Yes":"ある",p:"1"},{t:IS_EN?"No":"ない",p:"0"}]},
    {ax:"cov",key:"サードプレイス",scene:IS_EN?"Third Place":"サードプレイス",text:IS_EN?"Community outside school/home?":"学校や家以外の居場所があるか",o:[{t:IS_EN?"Yes":"ある",p:"1"},{t:IS_EN?"No":"ない",p:"0"}]},
    {ax:"cov",key:"防災ポーチ",scene:IS_EN?"Kit":"備え",text:IS_EN?"Carry emergency items?":"非常用グッズを持ち歩いているか",o:[{t:IS_EN?"Yes":"はい",p:"1"},{t:IS_EN?"No":"いいえ",p:"0"}]},
    {ax:"cov",key:"頼れる大人",scene:IS_EN?"Adult":"大人",text:IS_EN?"Trusted adult outside family?":"家族以外に頼れる大人がいるか",o:[{t:IS_EN?"Yes":"いる",p:"1"},{t:IS_EN?"No":"いない",p:"0"}]},
    {ax:"cov",key:"地域防災",scene:IS_EN?"Local":"地域",text:IS_EN?"Knowledge of local shelters?":"地域の避難所を知っているか",o:[{t:IS_EN?"Yes":"知っている",p:"1"},{t:IS_EN?"No":"知らない",p:"0"}]}
  ];

  let deck = [], idx = 0, answers = [], sex = "", result = null;

  function shuffle(a) {
    a = a.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.random() * (i + 1) | 0;
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function buildDeck() {
    const picked = ["P", "S", "B"].flatMap(ax => shuffle(QS.filter(q => q.ax === ax)).slice(0, 5));
    const judge = shuffle(picked).map(x => ({...x, o: Math.random() < .5 ? x.o : [x.o[1], x.o[0]]}));
    const cov = COV.map(x => ({...x, o: x.o.slice()}));
    deck = judge.concat(cov);
  }

  function show(id) {
    ["s-intro", "s-quiz", "s-profile", "s-result"].forEach(s => {
      document.getElementById(s).classList.toggle("hidden", s !== id);
    });
    window.scrollTo({top: 0, behavior: "instant"});
  }

  function renderIntro() {
    const order = ["hamster", "ant", "squirrel", "beaver", "owl", "penguin", "otter", "dolphin"];
    document.getElementById("introGrid").innerHTML = order.map(k => `<img src="${IMG[k]}" alt="">`).join("");

    const AXES_DEF = [
      {name: IS_EN ? "Function" : "支援機能", a:"P", b:"M"},
      {name: IS_EN ? "Style" : "行動様式", a:"S", b:"I"},
      {name: IS_EN ? "Range" : "支援射程", a:"B", b:"N"}
    ];
    document.getElementById("axList").innerHTML = AXES_DEF.map(ax => {
      const A = LETTER[ax.a], B = LETTER[ax.b];
      return `<div class="axrow"><span class="nm">${ax.name}</span>
        <span class="ltr"><b>${ax.a}</b>${A.ja}</span>
        <span class="ltr"><b>${ax.b}</b>${B.ja}</span></div>`;
    }).join("");
  }

  function renderQ() {
    const q = deck[idx];
    document.getElementById("count").textContent = `${idx + 1} / ${deck.length}` + (idx >= 15 ? (IS_EN ? " *Not scored" : " ※判定外") : "");
    const dots = ["#EF5A48", "#F06A18", "#E8AF1E", "#14875C", "#8B44A8", "#123A96", "#1BBFC6", "#EE6A9E"];
    document.getElementById("prog").innerHTML = deck.map((_, i) =>
      `<i class="${i < idx ? "on" : i === idx ? "cur" : ""}" style="--dot:${dots[i % 8]}"></i>`).join("");
    document.getElementById("scene").textContent = q.scene;
    document.getElementById("qtext").textContent = q.text;
    document.getElementById("choices").innerHTML = q.o.map((o, i) =>
      `<button type="button" class="choice" data-p="${o.p}"><span class="mark">${i === 0 ? "A" : "B"}</span>${o.t}</button>`).join("");
    document.getElementById("choices").querySelectorAll(".choice").forEach(b => b.onclick = () => pick(b.dataset.p));
    document.getElementById("backBtn").classList.toggle("hidden", idx === 0);
  }

  function pick(p) {
    answers[idx] = {ax: deck[idx].ax, p};
    idx++;
    if (idx < deck.length) renderQ(); else show("s-profile");
  }

  function calc() {
    const c = {P: 0, M: 0, S: 0, I: 0, B: 0, N: 0};
    answers.slice(0, 15).forEach(a => { if (a.p in c) c[a.p]++; });
    const code = (c.P >= 3 ? "P" : "M") + (c.S >= 3 ? "S" : "I") + (c.B >= 3 ? "B" : "N");
    return {code, c};
  }

  function bar(leftName, rightName, leftVal) {
    const l = leftVal, r = 5 - leftVal;
    return `<div class="bar"><div class="lab"><span>${leftName} ${l}</span><span>${r} ${rightName}</span></div>
      <div class="track"><span style="width:${l * 20}%"></span><span class="r" style="width:${r * 20}%"></span></div></div>`;
  }

  function renderResult() {
    result = calc();
    const tData = TYPES[result.code], c = result.c;
    document.getElementById("s-result").style.setProperty("--c", tData.col);
    document.getElementById("rImg").src = IMG[tData.key];
    document.getElementById("rImg").alt = tData.name;
    document.getElementById("rCode").textContent = result.code.split("").join(" ・ ");
    document.getElementById("rName").textContent = tData.name;
    document.getElementById("rCatch").textContent = tData.catch;
    
    document.getElementById("rBars").innerHTML =
      bar(IS_EN ? "Performance" : "課題", IS_EN ? "Maintenance" : "情緒", c.P) +
      bar(IS_EN ? "Structured" : "定型", IS_EN ? "Improvised" : "即興", c.S) +
      bar(IS_EN ? "Beside" : "近接", IS_EN ? "Network" : "広域", c.B);

    document.getElementById("rCode3").innerHTML = result.code.split("").map((L) => {
      const l = LETTER[L];
      return `<div class="cline"><div class="cbig">${L}</div><div class="cmeta">
        <p class="t1">${l.ja} (${l.en})</p><p class="t2">${l.line}</p>
      </div></div>`;
    }).join("");

    document.getElementById("rGood").textContent = tData.good;
    document.getElementById("rPost").textContent = tData.post;
    document.getElementById("rBlind").textContent = tData.blind;
    document.getElementById("rStep").textContent = tData.step;
    
    const bd = TYPES[tData.buddy], op = TYPES[tData.opp];
    document.getElementById("rBuddyImg").src = IMG[bd.key];
    document.getElementById("rBuddy").textContent = bd.name;
    document.getElementById("rOppImg").src = IMG[op.key];
    document.getElementById("rOpp").textContent = op.name;
    document.getElementById("rTheme").textContent = tData.theme;

    const mail = document.getElementById("mail").value.trim();
    document.getElementById("mailNote").textContent = mail ? (IS_EN ? `Email ready for ${mail}` : `${mail} あてのメールを作成できます。`) : "";

    show("s-result");
  }

  function mailBody() {
    const tData = TYPES[result.code];
    return `Result: ${tData.name} (${result.code})\n${tData.catch}`;
  }

  document.getElementById("startBtn").onclick = () => { buildDeck(); idx = 0; answers = []; renderQ(); show("s-quiz"); };
  document.getElementById("backBtn").onclick = () => { if (idx > 0) { idx--; renderQ(); } };
  document.getElementById("resultBtn").onclick = renderResult;
  
  document.getElementById("sexPill").onclick = e => {
    const b = e.target.closest("button");
    if (!b) return;
    sex = b.dataset.v;
    [...document.getElementById("sexPill").children].forEach(x => x.setAttribute("aria-pressed", x === b));
  };

  document.getElementById("mailBtn").onclick = () => {
    const to = document.getElementById("mail").value.trim();
    if (!to) return;
    location.href = `mailto:${encodeURIComponent(to)}?subject=Quiz Result&body=${encodeURIComponent(mailBody())}`;
  };

  document.getElementById("printBtn").onclick = () => window.print();
  document.getElementById("againBtn").onclick = () => {
    sex = ""; document.getElementById("mail").value = ""; document.getElementById("age").value = "";
    [...document.getElementById("sexPill").children].forEach(x => x.setAttribute("aria-pressed", false));
    show("s-intro");
  };

  renderIntro();
})();
</script>
</Layout>
