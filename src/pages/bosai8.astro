    saveTitle: "結果を残す",
    mailBtn: "メールを作成する",
    printBtn: "このカードを印刷 / PDFで保存",
    againBtn: "もう一度やる",
    notUsed: " ※ここからは判定に使いません",
    switchLangText: "English",
    switchLangUrl: "/bosai8?lang=en"
  },
  en: {
    title: "Bosai 8 ｜ Disaster Mutual-Aid Type Quiz",
    eyebrow: "JYRAC Disaster Mutual-Aid Type Quiz",
    heading: "Bosai 8",
    intro: "In a disaster, there isn't just one way to help.<br>Based on your choices in 20 scenarios, find out which of the 8 animal helper types fits you best.",
    axTitle: "Divided into 8 types across 3 axes",
    axNote: "The 3-letter combination (e.g., P-S-N) becomes your type code.",
    muted: "15 questions + 5 profile items / 2-3 minutes. There are no right or wrong answers.<br>5 questions are randomly chosen from 10 per axis, so questions change each time.<br>This is not a psychological test, but a learning opportunity to discover various ways of helping.",
    startBtn: "Start",
    backBtn: "← Back",
    profileEyebrow: "Almost Done",
    profileTitle: "Tell us a bit about yourself",
    profileDesc: "Statistical data used by JYRAC for disaster education research. No names are collected. Leave blank if you prefer not to answer.",
    labelAge: "Age",
    optNoSelect: "Prefer not to say",
    sexTitle: "Gender",
    sexFemale: "Female", sexMale: "Male", sexOther: "Other", sexNone: "Prefer not to say",
    labelMail: "Email to send results (optional)",
    mailDesc: "If entered, you can create an email to yourself from the result screen. You can view results without it.",
    resultBtn: "View Results",
    codeMeaning: "Meaning of Your Code",
    good: "Your Strengths",
    post: "Shelter Role",
    blind: "Things to Watch Out For",
    step: "Your First Step Today",
    buddy: "Buddy",
    opp: "Opposite",
    pairNote: "Your buddy has a similar approach but different blind spots. Your opposite has a very different style, but together you cover the widest range of situations.",
    theme: "To Learn More",
    noteFoot: "Your animal type can change depending on your environment and role. Disaster behavior is shaped more by the situation than by personality. Use this result not to label yourself, but to learn about other ways to help.",
    saveTitle: "Save Your Results",
    mailBtn: "Create Email",
    printBtn: "Print Card / Save as PDF",
