---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import { translations, type Lang } from '../lib/i18n';

const currentLang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const isEn = currentLang === 'en';
const langParam = isEn ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = translations[currentLang];
---

<Layout 
  title={isEn ? 'Contact | JYRAC' : 'お問い合わせ | 日本若者防災復興協会'} 
  currentTab="contact"
>
  <div class="contact-container">

    <header class="contact-header">
      <span class="sub-label">GET IN TOUCH</span>
      <h1 class="main-heading">
        {isEn ? 'Contact & Inquiries' : 'お問い合わせ・取材窓口'}
      </h1>
      <p class="desc-text">
        {isEn
          ? 'We welcome media inquiries, collaboration proposals from government bodies, corporations, and educational institutions, as well as general questions regarding our initiatives.'
          : 'JYRACへの取材依頼、行政・企業・学校関係者様からの連携相談、活動に関するご質問などはこちらから受け付けております。'}
      </p>
    </header>

    <div class="contact-grid">
      
      <!-- メール窓口カード（ドメインメール優先） -->
      <div class="contact-card">
        <span class="card-badge">DIRECT EMAIL</span>
        <h2 class="card-title">
          {isEn ? 'Email Inquiry' : 'メールでのお問い合わせ'}
        </h2>
        <p class="card-desc">
          {isEn
            ? 'For media coverage, partnership proposals, and official inquiries from public or educational institutions, please email our general desk directly.'
            : '取材依頼、ご協賛・パートナーシップのご提案、公的機関・学校関係者様からのご連絡は、総合窓口まで直接メールをお送りください。'}
        </p>
        <div class="email-box">
          <span class="email-label">
            {isEn ? 'Official Inquiries (General Desk):' : '公式窓口（総合・対外連携）：'}
          </span>
          <a href="mailto:info@jyrac.stki.org" class="email-link">info@jyrac.stki.org</a>
          <span class="email-sub-note">
            {isEn ? 'PR & Media desk: pr@jyrac.stki.org' : '広報・メディア対応：pr@jyrac.stki.org'}
          </span>
        </div>
        <p class="note-text">
          {isEn ? '*We typically respond within 2–3 business days.' : '※通常2〜3営業日以内に担当（広報局・事務局）よりご返信いたします。'}
        </p>
      </div>

      <!-- フォーム窓口カード -->
      <div class="contact-card card-teal">
        <span class="card-badge">WEB FORM</span>
        <h2 class="card-title">
          {isEn ? 'Online Inquiry Form' : 'フォームからのお問い合わせ'}
        </h2>
        <p class="card-desc">
          {isEn
            ? 'Questions regarding member participation, general consultations, or media request submissions can also be completed through our dedicated online form.'
            : 'メンバー参加に関するご相談、一般的なご質問、取材のお申し込みは専用フォームからも簡単にご送信いただけます。'}
        </p>
        <div class="form-btn-wrap">
          <a href="https://forms.gle/Q5ccYt7HkBDuCpBRA" target="_blank" rel="noopener noreferrer" class="btn-form">
            {isEn ? 'Open Google Form ↗' : 'Googleフォームを開く ↗'}
          </a>
        </div>
        <p class="note-text">
          {isEn ? '*Opens Google Forms in a new tab.' : '※別ウィンドウでGoogle Formsが開きます。'}
        </p>
      </div>

    </div>

    <!-- 事務所情報・法人概要 -->
    <section class="office-card">
      <span class="sub-label">OFFICE DETAILS</span>
      <h3 class="office-heading">
        {isEn ? 'Legal Entity & Office Details' : '法人所在地・登記連絡先情報'}
      </h3>
      <table class="office-table">
        <tbody>
          <tr>
            <th>{isEn ? 'Legal Name' : '法人名称'}</th>
            <td>
              {isEn 
                ? '特定非営利活動法人 日本若者防災復興協会 (Japan Youth Resilience Action Consortium / JYRAC)' 
                : '特定非営利活動法人 日本若者防災復興協会（英語略称：JYRAC / カナ：ニホンワカモノボウサイフッコウキョウカイ）'}
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Corporate Number' : '法人番号'}</th>
            <td>
              <code>2010005042019</code>
              <span class="sub-note">（{isEn ? 'National Tax Agency Corporate Number' : '国税庁指定法人番号'}）</span>
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Principal Office' : '所在地'}</th>
            <td>
              {isEn 
                ? '603, 4-4-6 Kohinata, Bunkyo-ku, Tokyo, 112-0006, Japan' 
                : '東京都文京区小日向四丁目4番6-603号'}
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Representative' : '代表者'}</th>
            <td>
              {isEn ? 'President: Sohtaro Kubo' : '理事長 久保 壮太郎'}
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Competent Authority' : '所轄庁'}</th>
            <td>
              {isEn 
                ? 'Tokyo Metropolitan Government (Bureau of Citizens, Culture and Sports)' 
                : '東京都知事（生活文化スポーツ局）'}
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Official Domain' : '公式ドメイン'}</th>
            <td>
              <code>jyrac.stki.org</code>
              <span class="sub-note">
                {isEn 
                  ? '(Operated under gratuitous loan by partner platform "TRANs")' 
                  : '（協力団体 TRANs より公式無償貸与を受けて運用）'}
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- 戻るリンク -->
    <div class="back-row">
      <a href={`${baseUrl}/${langParam}`} class="header-link">{t.common.backToHome}</a>
    </div>

  </div>
</Layout>

<style>
  .contact-container {
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) 16px;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 4vw, 36px);
  }
  .contact-header {
    text-align: center;
  }
  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }
  .main-heading {
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.3;
  }
  .desc-text {
    font-size: 13.5px;
    color: var(--text-muted);
    margin-top: 8px;
    line-height: 1.7;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .contact-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    padding: clamp(18px, 4vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 4px 16px rgba(0, 43, 84, 0.02);
  }
  .card-teal {
    background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 100%);
    border-color: #ccfbf1;
  }
  .card-badge {
    font-size: 9px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    background: #f1f5f9;
    padding: 2px 8px;
    border-radius: 6px;
    width: fit-content;
  }
  .card-title {
    font-size: 17px;
    font-weight: 800;
    color: var(--jyrac-navy);
    margin: 0;
  }
  .card-desc {
    font-size: 13px;
    color: var(--text-main);
    line-height: 1.65;
    margin: 0;
    flex-grow: 1;
  }
  .email-box {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 12px 14px;
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .email-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
  }
  .email-link {
    font-size: clamp(13.5px, 3.5vw, 15px);
    font-weight: 800;
    font-family: ui-monospace, monospace;
    color: var(--jyrac-navy);
    text-decoration: underline;
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  .email-sub-note {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .form-btn-wrap {
    margin-top: 8px;
  }
  .btn-form {
    display: block;
    width: 100%;
    background: var(--jyrac-navy);
    color: #ffffff !important;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 800;
    padding: 13px 20px;
    border-radius: 10px;
    text-align: center;
    transition: background-color 0.2s, transform 0.1s;
    box-sizing: border-box;
  }
  .btn-form:hover {
    background: var(--jyrac-teal);
  }
  .note-text {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
  }

  .office-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    padding: clamp(18px, 4vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 4px 16px rgba(0, 43, 84, 0.02);
  }
  .office-heading {
    font-size: 17px;
    font-weight: 800;
    color: var(--jyrac-navy);
    margin: 0;
  }
  .office-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .office-table th {
    width: 25%;
    background: var(--bg-light);
    color: var(--jyrac-navy);
    font-weight: 800;
    text-align: left;
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    white-space: nowrap;
    vertical-align: top;
  }
  .office-table td {
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    color: var(--text-main);
    line-height: 1.6;
    word-break: break-word;
  }
  .sub-note {
    display: inline-block;
    color: var(--text-muted);
    font-size: 11.5px;
    margin-left: 4px;
  }

  .header-link {
    font-size: 12px;
    font-weight: 800;
    color: var(--jyrac-teal);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
  .back-row {
    text-align: center;
  }

  /* モバイル対応（幅768px以下） */
  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .office-table,
    .office-table tbody,
    .office-table tr,
    .office-table th,
    .office-table td {
      display: block;
      width: 100%;
      box-sizing: border-box;
    }
    .office-table tr {
      border: 1px solid var(--border-color);
      border-radius: 12px;
      margin-bottom: 10px;
      overflow: hidden;
      background: #ffffff;
    }
    .office-table tr:last-child {
      margin-bottom: 0;
    }
    .office-table th {
      background: var(--bg-light);
      border: none;
      border-bottom: 1px solid var(--border-color);
      padding: 8px 12px;
      font-size: 11.5px;
    }
    .office-table td {
      border: none;
      padding: 10px 12px;
      font-size: 12.5px;
    }
  }
</style>
