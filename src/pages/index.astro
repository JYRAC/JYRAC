---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

const requestUrl = Astro.request.url.replace(/^http:/, 'https:');
const url = new URL(requestUrl);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';

// 2. 数字で見るJYRAC データ (2026年6月時点・公式事業説明資料より起算)
const stats = [
  { num: "478", unit: "名", label: "メンバー総数", en: "MEMBERS" },
  { num: "23", unit: "件", label: "プロジェクト総数", en: "PROJECTS" },
  { num: "59", unit: "回", label: "募金活動実施数", en: "FUNDRAISING" },
  { num: "42", unit: "件", label: "イベント総数", en: "EVENTS" },
  { num: "10,128", unit: "人", label: "Instagram総フォロワー", en: "FOLLOWERS" },
  { num: "264", unit: "万円超", label: "募金活動総額", en: "DONATIONS" }
];

// 3. 4つの事業領域
const businessDomains = [
  {
    num: "01",
    title: "防災事業",
    enTitle: "Disaster Prevention",
    desc: "内閣府共催「全国生徒会防災サミット」の開催や、自衛隊協力のもと実施する避難所宿泊体験・ハザードマップ作成など、若者自らが行う実践教育を推進。",
    badge: "生徒会サミット・政策提言・避難所改善",
    link: `/services${langParam}#disaster-prevention`
  },
  {
    num: "02",
    title: "復興事業",
    enTitle: "Disaster Recovery",
    desc: "能登現地での家屋片付けボランティアや炊き出し支援、能登うまいもん再発見プロジェクトを通じた食・伝統文化の継承など、息の長い支援を展開。",
    badge: "能登現地活動・伝統食文化継承",
    link: `/services${langParam}#recovery`
  },
  {
    num: "03",
    title: "地域事業",
    enTitle: "Community & Local",
    desc: "街頭募金活動（計59回・260万円超）の実施や、各地の地域防災イベント出展を通じて、住民と若者が平時から手を取り合う共助の基盤を創出。",
    badge: "街頭募金・地域防災行事出展",
    link: `/services${langParam}#community`
  },
  {
    num: "04",
    title: "国際事業",
    enTitle: "Global Initiatives",
    desc: "世界の若者と災害対応を議論する「模擬防災国連」や、国際若者防災復興コミュニティ「Y-VITAL構想」を通じ、日本の防災・復興の経験を世界へ発信。",
    badge: "Y-VITAL構想・模擬防災国連",
    link: `/services${langParam}#international`
  }
];

// ピックアップ最新ニュース（直近3件）
const pickupNews = [
  {
    date: "2026.09.20",
    category: "サミット",
    badgeClass: "bg-blue-600 text-white",
    title: "「全国生徒会防災サミット2026 秋の陣 DAY 2（10/24開催）」参加エントリー受付中",
    url: "https://summit.jyrac.stki.org/autumn/day2",
    isExt: true
  },
  {
    date: "2026.08.15",
    category: "復興支援",
    badgeClass: "bg-teal-600 text-white",
    title: "【熊本地震】被災地へ願いを届けるデジタル絵馬ページを公開しました",
    url: "https://nsf.stki.org/ema",
    isExt: true
  },
  {
    date: "2026.06.21",
    category: "法人情報",
    badgeClass: "bg-slate-700 text-white",
    title: "特定非営利活動法人 日本若者防災復興協会 正式設立（登記完了）のお知らせ",
    url: `/about${langParam}`,
    isExt: false
  }
];
---

<Layout title="特定非営利活動法人 日本若者防災復興協会（JYRAC）" currentTab="home">

  <!-- 1. トップページのファーストビュー -->
  <section class="relative bg-gradient-to-b from-teal-50/60 via-white to-white py-16 sm:py-24 overflow-hidden border-b border-slate-100">
    <div class="absolute inset-0 mx-auto w-[600px] h-[300px] bg-gradient-to-tr from-teal-200/30 via-blue-200/30 to-orange-200/20 blur-3xl pointer-events-none -z-10 rounded-full"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-teal-200 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
        <span class="text-xs font-mono font-black tracking-wide text-teal-800">
          OFFICIAL PORTAL / JYRAC
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-[#002b54] tracking-tight leading-[1.25]">
        「いつもの暮らし」が、いちばん強い。<br />
        <span class="bg-gradient-to-r from-[#009aa6] via-blue-600 to-teal-500 bg-clip-text text-transparent">
          若者から始める、新しい防災と復興。
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600 leading-relaxed font-medium">
        特定非営利活動法人日本若者防災復興協会（JYRAC）は、全国の中学生・高校生・大学生が主体となり、
        お堅い「お勉強の防災」を刷新。誰もが自然と関わりたくなる持続可能な防災・復興のスタンダードを築くNPO法人です[cite: 3]。
      </p>

      <!-- 主要ページ誘導ボタン群 -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3.5">
        <a href={`/about${langParam}`} class="px-6 py-3.5 rounded-xl bg-[#002b54] hover:bg-[#0d3b66] text-white text-sm font-black shadow-md transition no-underline">
          JYRACについて知る
        </a>
        <a href="#business-domains" class="px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-[#002b54] border border-slate-300 text-sm font-black shadow-xs transition no-underline">
          活動・事業領域を見る
        </a>
        <a href={`/recruitment${langParam}`} class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-[#009aa6] to-teal-500 hover:to-[#007c87] text-white text-sm font-black shadow-md transition no-underline active:scale-95">
          メンバーとして参加する ↗
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-24">

    <!-- 直近の注力プロジェクト（秋の陣 DAY 2） -->
    <section class="relative overflow-hidden bg-gradient-to-br from-[#002b54] via-slate-900 to-teal-900 rounded-3xl p-6 sm:p-10 text-white shadow-xl">
      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 border border-teal-400/30 text-teal-300 text-[10px] font-mono font-bold tracking-wider uppercase">
            NEXT EVENT / 2026.10.24 SAT ZOOM
          </div>
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight">
            全国生徒会防災サミット2026 秋の陣 DAY 2
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            10月のテーマは【考える防災から動く防災へ】。全国の中高生・生徒会役員が集結し、地域や学校の枠を越えたアクションを共創します（参加費完全無料）。
          </p>
        </div>
        <a
          href="https://summit.jyrac.stki.org/autumn/day2"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-white text-[#002b54] font-black text-sm shadow-md hover:bg-teal-50 transition no-underline shrink-0"
        >
          <span>詳細・エントリーページを開く ↗</span>
        </a>
      </div>
    </section>

    <!-- 2. 数字で見るJYRAC -->
    <section class="space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-mono font-black text-[#009aa6] uppercase tracking-widest">FACTS & NUMBERS</span>
        <h2 class="text-2xl sm:text-3xl font-black text-[#002b54]">数字で見るJYRAC</h2>
        <p class="text-xs sm:text-sm text-slate-500">2024年能登半島地震支援の発足から現在までに積み上げてきた活動実績です[cite: 3]。</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {stats.map(s => (
          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs text-center flex flex-col justify-between hover:border-teal-400 transition">
            <span class="text-[10px] font-mono font-bold text-slate-400">{s.en}</span>
            <div class="my-3">
              <span class="text-3xl sm:text-4xl font-black text-[#002b54] font-mono">{s.num}</span>
              <span class="text-xs font-bold text-slate-600 ml-1">{s.unit}</span>
            </div>
            <span class="text-xs font-black text-slate-700">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. 事業内容（4つの事業領域） -->
    <section id="business-domains" class="space-y-8 scroll-mt-24">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-4">
        <div class="space-y-1">
          <span class="text-xs font-mono font-black text-[#009aa6] uppercase tracking-widest">BUSINESS DOMAINS</span>
          <h2 class="text-2xl sm:text-3xl font-black text-[#002b54]">4つの事業領域</h2>
        </div>
        <a href={`/services${langParam}`} class="text-xs font-black text-[#009aa6] hover:underline no-underline">
          各事業・プロジェクトの詳細を見る ➔
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {businessDomains.map(b => (
          <div class="p-7 rounded-3xl bg-white border border-slate-200 shadow-xs hover:border-[#009aa6] hover:shadow-md transition space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-black text-[#009aa6]">{b.num} / {b.enTitle}</span>
              <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">{b.badge}</span>
            </div>
            <h3 class="text-xl font-black text-[#002b54]">{b.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">{b.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. 最新ニュース ＆ 活動沿革ダイジェスト -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- ニュース枠（2カラム分） -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
          <h3 class="text-lg font-black text-[#002b54]">最新情報・お知らせ</h3>
          <a href={`/news${langParam}`} class="text-xs font-bold text-[#009aa6] hover:underline no-underline">すべて見る ➔</a>
        </div>
        <div class="space-y-2.5">
          {pickupNews.map(n => (
            <a
              href={n.url}
              target={n.isExt ? "_blank" : "_self"}
              rel={n.isExt ? "noopener noreferrer" : ""}
              class="p-4 rounded-2xl bg-white border border-slate-200 hover:border-teal-400 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 no-underline group transition"
            >
              <div class="flex items-center gap-3">
                <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded shrink-0 ${n.badgeClass}`}>{n.category}</span>
                <time class="text-xs font-mono text-slate-400 shrink-0">{n.date}</time>
                <span class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-teal-600 transition truncate">
                  {n.title}
                </span>
              </div>
              <span class="text-xs font-bold text-teal-600 shrink-0 hidden sm:inline">詳細 →</span>
            </a>
          ))}
        </div>
      </div>

      <!-- 沿革要約（1カラム分） -->
      <div class="bg-slate-50 rounded-3xl p-6 border border-slate-200 space-y-4">
        <h3 class="text-base font-black text-[#002b54] border-b border-slate-200 pb-2">これまでの歩み</h3>
        <ul class="space-y-3 text-xs">
          <li class="space-y-0.5">
            <span class="font-mono font-bold text-teal-700">2024年01月</span>
            <p class="text-slate-600 font-medium">能登半島地震を受け、学生支援募金プロジェクト発足[cite: 3]</p>
          </li>
          <li class="space-y-0.5">
            <span class="font-mono font-bold text-teal-700">2025年12月</span>
            <p class="text-slate-600 font-medium">「U20若者活動AWARD 2025 優秀賞」を受賞[cite: 3]</p>
          </li>
          <li class="space-y-0.5">
            <span class="font-mono font-bold text-teal-700">2026年03月</span>
            <p class="text-slate-600 font-medium">内閣府共催「全国生徒会防災サミット2026」開催（衆議院議員会館）[cite: 3]</p>
          </li>
          <li class="space-y-0.5">
            <span class="font-mono font-bold text-teal-700">2026年06月</span>
            <p class="text-slate-600 font-medium">「特定非営利活動法人 日本若者防災復興協会」登記完了[cite: 3]</p>
          </li>
        </ul>
        <a href={`/history${langParam}`} class="block pt-2 text-xs font-bold text-[#009aa6] hover:underline no-underline">
          詳細な沿革・実績年表を見る ➔
        </a>
      </div>
    </section>

    <!-- 7. 組織図の簡潔掲載（局・本部・政調会まで） -->
    <section class="space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-mono font-black text-[#009aa6] uppercase tracking-widest">ORGANIZATION CHART</span>
        <h2 class="text-2xl sm:text-3xl font-black text-[#002b54]">組織体制</h2>
        <p class="text-xs sm:text-sm text-slate-500">外部向けに組織の全体構造（局・各本部・政調会）を簡潔に示しています[cite: 3]。</p>
      </div>

      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xs space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
          
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-3">
            <span class="font-black text-[#002b54] text-sm block border-b border-slate-200 pb-2">各局（法人基盤・統括）</span>
            <ul class="text-slate-600 space-y-1.5 font-medium">
              <li>・<strong>事務局</strong>（総務・会計・法務・情報部）[cite: 3]</li>
              <li>・<strong>人事局</strong>（採用・組織育成）[cite: 3]</li>
              <li>・<strong>広報局</strong>（デザイン課・SNS発信・プレス）[cite: 3]</li>
              <li>・<strong>外務局</strong>（渉外・連携）[cite: 3]</li>
            </ul>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-3">
            <span class="font-black text-[#002b54] text-sm block border-b border-slate-200 pb-2">各事業本部（プロジェクト推進）</span>
            <ul class="text-slate-600 space-y-1.5 font-medium">
              <li>・<strong>防災事業本部</strong>（生徒会サミット・避難所改善）[cite: 3]</li>
              <li>・<strong>復興事業本部</strong>（能登現地支援・食文化継承）[cite: 3]</li>
              <li>・<strong>地域事業本部</strong>（街頭募金・地域防災出展）[cite: 3]</li>
              <li>・<strong>国際事業本部</strong>（Y-VITAL・模擬防災国連）[cite: 3]</li>
            </ul>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-3">
            <span class="font-black text-[#002b54] text-sm block border-b border-slate-200 pb-2">政務調査会 ＆ 連携コミュニティ</span>
            <ul class="text-slate-600 space-y-1.5 font-medium">
              <li>・<strong>政務調査会</strong>（防災政策提言・法案調査）[cite: 3]</li>
              <li>・<strong>中高生コミュニティ NSF PROJECTS</strong>[cite: 3]</li>
              <li>・<strong>避難所議連 事務局支援</strong>[cite: 3]</li>
            </ul>
          </div>

        </div>

        <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
          <span class="text-slate-500 font-medium">意思決定機関：理事会（理事長：久保 壮太郎） / 監査：監事[cite: 3]</span>
          <a href={`/about${langParam}#members`} class="font-bold text-[#009aa6] hover:underline no-underline">
            役員・メンバー紹介ページを見る ➔
          </a>
        </div>
      </div>
    </section>

    <!-- 8. メンバー募集 CTA -->
    <section class="rounded-3xl bg-gradient-to-r from-[#002b54] via-slate-900 to-[#002b54] text-white p-8 sm:p-14 text-center space-y-6 shadow-xl">
      <div class="max-w-2xl mx-auto space-y-3">
        <h2 class="text-2xl sm:text-4xl font-black tracking-tight">
          あなたもJYRACで、未来を動かしませんか？
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-medium">
          全国の中学・高校・大学生がオンライン・地方問わず多数活動しています。
          企画、デザイン、広報、政策提言、現地支援など、あなたの強みを発揮できるチームが必ずあります。
        </p>
      </div>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
        <a
          href={`/recruitment${langParam}`}
          class="px-8 py-4 rounded-xl bg-gradient-to-r from-[#009aa6] to-teal-500 hover:to-[#007c87] text-white font-black text-sm shadow-lg transition no-underline active:scale-95"
        >
          募集要項・活動詳細を見る ➔
        </a>
        <a
          href={`/contact${langParam}`}
          class="px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm border border-white/20 transition no-underline"
        >
          お問い合わせ
        </a>
      </div>
    </section>

  </div>

</Layout>
