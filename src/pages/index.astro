---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import { translations, type Lang } from '../lib/i18n';

const currentLang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const isEn = currentLang === 'en';
const langParam = isEn ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = translations[currentLang];

// 役員データ（日・英完全切り替え）
const boardMembers = [
  {
    role: isEn ? 'President & Representative Director' : '理事長',
    name: isEn ? 'Sohtaro Kubo' : '久保 壮太郎',
    enName: isEn ? 'President' : 'Sohtaro Kubo'
  },
  {
    role: isEn ? 'Director' : '理事',
    name: isEn ? 'Shun Sekiguchi' : '関口 俊',
    enName: isEn ? 'Director' : 'Shun Sekiguchi'
  },
  {
    role: isEn ? 'Director' : '理事',
    name: isEn ? 'Hinata Suzuki' : '鈴木 陽向',
    enName: isEn ? 'Director' : 'Hinata Suzuki'
  },
  {
    role: isEn ? 'Director' : '理事',
    name: isEn ? 'Hiroya Mouri' : '毛利 仁哉',
    enName: isEn ? 'Director' : 'Hiroya Mouri'
  }
];

// 組織体制リスト
const orgDivisions = isEn ? [
  'Secretariat (General Affairs, Finance, Legal & IT)',
  'Human Resources (Talent Acquisition & Development)',
  'Public Relations (Design, Social Media & Media Relations)',
  'External Relations (Partnerships & Alliances)'
] : [
  '事務局（総務・会計・法務・情報部）',
  '人事局（採用・メンバー育成）',
  '広報局（デザイン課・SNS発信課・メディアプレス課）',
  '外務局（渉外・パートナーシップ）'
];

const orgProjects = isEn ? [
  'Disaster Prevention Bureau (Student Summits & Shelter Improvements)',
  'Disaster Recovery Bureau (Noto On-site Support & Food Culture Heritage)',
  'Regional Bureau (Street Fundraising & Local Disaster Expos)',
  'Global Initiatives Bureau (Y-VITAL & Model Disaster UN)'
] : [
  '防災事業本部（生徒会サミット・避難所環境改善）',
  '復興事業本部（能登現地支援・伝統食文化継承）',
  '地域事業本部 / 募金事業本部（街頭募金・地域防災出展）',
  '国際事業本部（Y-VITAL・模擬防災国連）'
];

const orgPolicy = isEn ? [
  'Policy Research Council (Policy Proposals & Legislative Research)',
  'Youth Community NSF PROJECTS',
  'Cross-Party Evacuation Shelter Parliamentary Group Secretariat Support'
] : [
  '政務調査会（政策提言・法案調査・意見交換）',
  '中高生コミュニティ NSF PROJECTS',
  '超党派避難所議連 事務局支援'
];
---

<Layout 
  title={isEn ? 'About Us | JYRAC' : '当法人について | 日本若者防災復興協会'} 
  currentTab="about"
>
  <div class="about-container">

    <!-- ページ見出し -->
    <header class="about-header">
      <span class="sub-label">ABOUT JYRAC</span>
      <h1 class="main-heading">
        {isEn ? 'About Our Organization' : '当法人について'}
      </h1>
      <p class="desc-text">
        {isEn
          ? 'Information regarding the mission, vision, officers, and structure of Japan Youth Resilience Action Consortium.'
          : '特定非営利活動法人日本若者防災復興協会の理念・設立の想い・役員体制・組織概要です。'}
      </p>
    </header>

    <!-- 理念（Mission・Vision） -->
    <section class="section-card">
      <div class="card-inner-box">
        <span class="sub-label">MISSION & VISION</span>
        <h2 class="card-heading">
          {isEn ? 'Our Philosophy & Mission' : '組織理念・目指す社会'}
        </h2>
        <p class="lead-quote">
          {isEn ? (
            <>
              Everyday resilience is our greatest strength.<br />
              Youth-led innovation for disaster prevention and recovery.
            </>
          ) : (
            <>
              「いつもの暮らし」が、いちばん強い。<br />
              若者から始める、新しい防災と復興。
            </>
          )}
        </p>
        <p class="body-text">
          {isEn
            ? 'We ensure that the sorrow and lessons of disasters do not fade into history. Empowered by the flexibility and bold initiative of youth, we transform rigid disaster training into accessible, sustainable everyday resilience. Transcending barriers of generation and region, we stand at the forefront to create a society where all citizens stand together against disaster risks.'
            : '私たちは、災害の悲しみをただの記憶で終わらせません。若者ならではの柔軟な発想力と圧倒的な行動力をもって、お堅い「お勉強」としての防災を刷新し、誰もが主体的に関わりたくなる新しい防災・復興のスタンダードを築きます。地域と世代の壁を越え、すべての人が手を取り合って災害に立ち向かえる、安全で持続可能な社会を私たちが先頭に立って創り上げます。'}
        </p>
      </div>
    </section>

    <!-- 理事長挨拶 -->
    <section class="section-card">
      <span class="sub-label">MESSAGE FROM THE PRESIDENT</span>
      <h2 class="card-heading">
        {isEn ? 'President Message' : '理事長 挨拶'}
      </h2>
      
      <div class="message-body">
        <p>
          {isEn
            ? 'Disasters can strip away daily lives in an instant. Yet amidst hardship, the strength of local communities, human bonds, and the immense potential of youth shine brightly.'
            : '災害は、ある日突然、私たちの日常を奪います。しかし同時に、そこから立ち上がろうとする人々の歩みの中には、地域の強さ、人と人とのつながり、未来を担う若者の可能性が確かに存在しています。'}
        </p>
        <p>
          {isEn
            ? 'Beyond short-term emergency relief, our vision is to establish sustainable platforms where young people engage continuously with communities, learn, take action, and advocate impactful policies. Disaster resilience is not only for specialists; it must be an everyday responsibility embraced by everyone. Realizing this vision is the fundamental mission of JYRAC.'
            : '私たちは、被災地への一時的な支援にとどまらず、若者が継続的に地域と関わり、学び、行動し、社会に提言していく仕組みをつくっていきたいと考えています。防災を「特別な人だけが担うもの」ではなく、すべての若者が自分ごととして考え、参加できる社会へ。その実現こそが、JYRACの使命です。'}
        </p>
        <p>
          {isEn
            ? 'Preserving collective memory, translating knowledge into immediate action, and moving beyond the divide between helpers and those affected to build the future together. JYRAC leads this path, transforming youth passion into real societal strength.'
            : '災害の記憶を風化させず、次の行動へつなげること。支援する側とされる側を超え、ともに未来をつくる仲間になること。JYRACはその先頭に立ち、若者の挑戦を社会の力へと変えていきます。'}
        </p>
        <div class="message-signature">
          <span>{isEn ? '特定非営利活動法人 日本若者防災復興協会 (JYRAC)' : '特定非営利活動法人 日本若者防災復興協会'}</span>
          <strong>{isEn ? 'President Sohtaro Kubo' : '理事長 久保 壮太郎'}</strong>
        </div>
      </div>
    </section>

    <!-- 役員紹介 -->
    <section id="members" class="section-card">
      <div class="section-header-split">
        <div>
          <span class="sub-label">BOARD OF DIRECTORS</span>
          <h2 class="card-heading">
            {isEn ? 'Board Members' : '役員紹介'}
          </h2>
        </div>
      </div>

      <div class="board-grid">
        {boardMembers.map(m => (
          <div class="board-card">
            <span class="board-role">{m.role}</span>
            <h3 class="board-name">{m.name}</h3>
            <span class="board-en-name">{m.enName}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- 組織図・体制 -->
    <section class="section-card">
      <span class="sub-label">ORGANIZATION STRUCTURE</span>
      <h2 class="card-heading">
        {isEn ? 'Organization Chart & Governance' : '組織体制・ガバナンス'}
      </h2>
      <p class="desc-text" style="margin-bottom: 20px;">
        {isEn
          ? 'Guided by the Board of Directors as the supreme decision-making body and the Auditors, our operational divisions, project bureaus, and policy council work together seamlessly.'
          : '最高意思決定機関である理事会および監査を行う監事のもと、各局・各事業本部・政務調査会が連携して活動を展開しています。'}
      </p>

      <div class="org-layout-grid">
        <div class="org-col">
          <h4 class="org-title">{isEn ? 'Corporate Divisions' : '各局（法人基盤・統括）'}</h4>
          <ul class="org-list">
            {orgDivisions.map(item => <li>・{item}</li>)}
          </ul>
        </div>

        <div class="org-col">
          <h4 class="org-title">{isEn ? 'Project Bureaus' : '各事業本部（プロジェクト推進）'}</h4>
          <ul class="org-list">
            {orgProjects.map(item => <li>・{item}</li>)}
          </ul>
        </div>

        <div class="org-col">
          <h4 class="org-title">{isEn ? 'Policy Council & Communities' : '政務調査会 ＆ 連携コミュニティ'}</h4>
          <ul class="org-list">
            {orgPolicy.map(item => <li>・{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- 法人概要スペック表（東京都認証台帳・審査対策対応） -->
    <section class="section-card">
      <span class="sub-label">ORGANIZATION OVERVIEW</span>
      <h2 class="card-heading">
        {isEn ? 'Legal Details' : '法人概要'}
      </h2>

      <table class="info-table">
        <tbody>
          <tr>
            <th>{isEn ? 'Organization Legal Name' : '法人・団体名称'}</th>
            <td>
              {isEn 
                ? '特定非営利活動法人 日本若者防災復興協会 (Japan Youth Resilience Action Consortium / JYRAC)' 
                : '特定非営利活動法人 日本若者防災復興協会（英語略称：JYRAC / カナ：ニホンワカモノボウサイフッコウキョウカイ）'}
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Corporate Number' : '法人番号'}</th>
            <td>
              <code>2010005042019</code>
              <span class="sub-note">（{isEn ? 'National Tax Agency Corporate Number' : '国税庁指定法人番号'}）</span>
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Certification / Registration Date' : '認証日・設立登記日'}</th>
            <td>
              {isEn
                ? 'Certified: June 18, 2026 (Tokyo Metropolitan Government) / Registered: June 21, 2026'
                : '認証日：令和8年6月18日（東京都認証） / 設立登記日：令和8年6月21日'}
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Representative' : '代表者'}</th>
            <td>
              {isEn ? 'President Sohtaro Kubo' : '理事長 久保 壮太郎'}
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Principal Office' : '主たる事務所の所在地'}</th>
            <td>
              {isEn
                ? '603, 4-4-6 Kohinata, Bunkyo-ku, Tokyo, 112-0006, Japan'
                : '東京都文京区小日向四丁目4番6-603号'}
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Statutory Purpose & Key Domains' : '定款の目的・主な活動領域'}</th>
            <td>
              {isEn
                ? 'Engaging in youth-led disaster prevention, mitigation, and post-disaster recovery to enhance community disaster preparedness and contribute to the realization of a safe, resilient, and sustainable society.'
                : '若者が主体となって防災、減災及び災害復興に取り組むための事業を行い、地域社会の防災力向上と安全で安心な持続可能社会の実現に寄与することを目的とする。'}
              <br />
              <span class="sub-note">
                {isEn
                  ? '(Key Domains: Disaster Prevention Education, On-site Recovery Support, Community Fundraising, Global Initiatives, Policy Advocacy)'
                  : '（活動領域：防災教育・実践体験、被災地復興支援・文化継承、街頭啓蒙・募金、国際交流、政策提言）'}
              </span>
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Major Achievements' : '主な実績'}</th>
            <td>
              {isEn
                ? 'Co-hosted National Student Disaster Summit 2026 with Cabinet Office, evacuation shelter policy advocacy, Noto on-site volunteer relief, 59 street fundraising campaigns (over 2.6 million JPY raised).'
                : '内閣府共催「全国生徒会防災サミット2026」開催、避難所環境改善・政策提言、能登半島現地復興ボランティア、街頭募金活動59回（総額260万円超）'}
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Official Contact' : '公式連絡先'}</th>
            <td>
              <a href="mailto:info@jyrac.stki.org" class="table-link">info@jyrac.stki.org</a>
              <span class="sub-note">（{isEn ? 'PR Office: jyrac.pr@gmail.com' : '広報窓口：jyrac.pr@gmail.com'}）</span>
            </td>
          </tr>
          <tr>
            <th>{isEn ? 'Domain & Infrastructure' : 'ドメインの運用について'}</th>
            <td>
              {isEn
                ? 'The official domain (jyrac.stki.org) of JYRAC is operated under formal authorization and gratuitous loan by our partner youth platform "TRANs".'
                : '当団体の公式ウェブサイトおよびシステム運用ドメイン（jyrac.stki.org）は、初期運用コストの最適化のため、協力関係にある学生支援組織「TRANs」より正式な許諾を得て無償貸与を受けて運用しております。'}
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- 戻るリンク（i18n.ts の common.backToHome をそのまま使用） -->
    <div class="back-row">
      <a href={`${baseUrl}/${langParam}`} class="header-link">{t.common.backToHome}</a>
    </div>

  </div>
</Layout>

<style>
  .about-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) 16px;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 4vw, 36px);
  }

  .about-header {
    text-align: center;
    margin-bottom: 4px;
  }
  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }
  .main-heading {
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.3;
  }
  .desc-text {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 6px;
    line-height: 1.6;
  }

  /* セクションカード */
  .section-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: clamp(16px, 4vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 4px 16px rgba(0, 43, 84, 0.02);
  }
  .card-heading {
    font-size: clamp(17px, 4vw, 20px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.35;
  }

  /* 理念ブロック */
  .card-inner-box {
    background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
    border: 1px solid #ccfbf1;
    border-radius: 16px;
    padding: clamp(16px, 3.5vw, 24px);
  }
  .lead-quote {
    font-size: clamp(15px, 3.6vw, 18px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.5;
    margin: 10px 0;
  }
  .body-text {
    font-size: 13.5px;
    color: var(--text-main);
    line-height: 1.8;
  }

  /* メッセージ */
  .message-body {
    font-size: 13.5px;
    color: var(--text-main);
    line-height: 1.85;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .message-signature {
    margin-top: 12px;
    text-align: right;
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: var(--jyrac-navy);
  }

  /* 役員グリッド */
  .board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
  }
  .board-card {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .board-role {
    font-size: 11px;
    font-weight: 800;
    color: var(--jyrac-teal);
    font-family: ui-monospace, monospace;
  }
  .board-name {
    font-size: 17px;
    font-weight: 900;
    color: var(--jyrac-navy);
  }
  .board-en-name {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    color: #94a3b8;
  }

  /* 組織図グリッド */
  .org-layout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }
  .org-col {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 16px;
  }
  .org-title {
    font-size: 13px;
    font-weight: 800;
    color: var(--jyrac-navy);
    border-bottom: 1.5px solid var(--border-color);
    padding-bottom: 6px;
    margin-bottom: 10px;
  }
  .org-list {
    list-style: none;
    font-size: 12px;
    color: var(--text-main);
    line-height: 1.75;
  }

  /* テーブル */
  .info-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-top: 4px;
  }
  .info-table th {
    width: 28%;
    background-color: var(--bg-light);
    color: var(--jyrac-navy);
    font-weight: 800;
    text-align: left;
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    vertical-align: top;
    white-space: nowrap;
  }
  .info-table td {
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    color: var(--text-main);
    line-height: 1.6;
    word-break: break-word;
  }

  .sub-note {
    display: inline-block;
    color: var(--text-muted);
    font-size: 12px;
    margin-left: 4px;
  }
  .table-link {
    color: var(--jyrac-teal);
    text-decoration: none;
    font-weight: 600;
  }
  .table-link:hover {
    text-decoration: underline;
  }

  .header-link {
    font-size: 12px;
    font-weight: 800;
    color: var(--jyrac-teal);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
  .back-row {
    text-align: center;
    padding-top: 12px;
  }

  /* レスポンシブ最適化（タブレット・スマホ） */
  @media (max-width: 768px) {
    .section-card {
      padding: 18px 14px;
      border-radius: 16px;
    }
    .info-table, 
    .info-table tbody, 
    .info-table tr, 
    .info-table th, 
    .info-table td {
      display: block;
      width: 100%;
      box-sizing: border-box;
    }
    .info-table tr {
      border: 1px solid var(--border-color);
      border-radius: 12px;
      margin-bottom: 10px;
      overflow: hidden;
      background: #ffffff;
    }
    .info-table tr:last-child {
      margin-bottom: 0;
    }
    .info-table th {
      background-color: var(--bg-light);
      border: none;
      border-bottom: 1px solid var(--border-color);
      padding: 8px 12px;
      font-size: 11.5px;
    }
    .info-table td {
      border: none;
      padding: 10px 12px;
      font-size: 12.5px;
    }
    .board-grid {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 10px;
    }
    .board-card {
      padding: 12px 14px;
    }
    .board-name {
      font-size: 16px;
    }
    .org-layout-grid {
      grid-template-columns: 1fr;
    }
    .message-signature {
      text-align: left;
    }
  }
</style>
