---
import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメーターを取得 (プロトコルをhttpsに整形)
const requestUrl = Astro.request.url.replace(/^http:/, 'https:');
const url = new URL(requestUrl);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
const langParam = currentLang === 'en' ? '?lang=en' : '';

// public直下のファイルを参照 (ベースパス対応)
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${baseUrl}/JYRAC.jpg`;

// 言語に応じたニュース記事データ（資料の実績・沿革を反映）
const newsArticles = [
  {
    title: currentLang === 'en'
      ? '[Disaster Summit] "2026 All-Japan Student Council Disaster Summit Autumn Session DAY 2" Registration Open'
      : '【全国生徒会防災サミット】「2026 秋の陣 DAY 2（10/24開催）」エントリー受付中',
    url: "https://summit.jyrac.stki.org/autumn/day2",
    date: "2026.09.20",
    category: currentLang === 'en' ? 'Summit' : 'サミット',
    badgeClass: "badge-recruitment",
    hasLink: true,
    summary: currentLang === 'en'
      ? 'Under the theme "From Thinking About Disaster Prevention to Taking Action," DAY 2 will be held online via Zoom on Saturday, October 24. Free of charge for junior and senior high school students nationwide.'
      : '10月24日（土）にZoomで開催される「秋の陣 DAY 2」の参加申し込みを受け付けています。テーマは【考える防災から動く防災へ】。全国の中高生・生徒会役員・有志グループの皆さまのご参加をお待ちしています（参加費無料）。'
  },
  {
    title: currentLang === 'en'
      ? '[Kumamoto Earthquake] Digital Ema (Message) Page Launched'
      : '【熊本地震】願いを届けるデジタル絵馬を公開しました',
    url: "https://nsf.stki.org/ema",
    date: "2026.08.15",
    category: currentLang === 'en' ? 'News' : 'お知らせ',
    badgeClass: "badge-info",
    hasLink: true,
    summary: currentLang === 'en'
      ? 'We have launched a digital Ema page to send recovery messages to the affected areas. We welcome your warm messages.'
      : '被災地の一日も早い復興を願い、デジタル絵馬ページを公開いたしました。皆さまからの温かいメッセージをお待ちしております。'
  },
  {
    title: currentLang === 'en'
      ? '[Recruitment] Updated Application Guidelines for Projects & Headquarters'
      : '【メンバー募集】広報・災害支援・各事業本部の募集情報を更新しました',
    url: `/recruitment${langParam}`,
    date: "2026.07.30",
    category: currentLang === 'en' ? 'Recruit' : '募集',
    badgeClass: "badge-recruitment",
    hasLink: true,
    summary: currentLang === 'en'
      ? 'JYRAC is widely recruiting youth members centered on junior high, high school, and college students across Japan. Check the recruitment page for details.'
      : '特定非営利活動法人日本若者防災復興協会（JYRAC）では、全国の中学生・高校生・大学生を中心としたメンバーを広く募集しています。オンライン活動や各事業本部の募集要項はこちらからご確認いただけます。'
  },
  {
    title: currentLang === 'en'
      ? 'Official Incorporation: Completion of Non-Profit Organization Registration'
      : '特定非営利活動法人 日本若者防災復興協会 正式設立（登記完了）のお知らせ',
    url: `/about${langParam}`,
    date: "2026.06.21",
    category: currentLang === 'en' ? 'News' : 'お知らせ',
    badgeClass: "badge-info",
    hasLink: true,
    summary: currentLang === 'en'
      ? 'Japan Youth Resilience Action Consortium (JYRAC) completed incorporation registration at the Legal Affairs Bureau on June 21, 2026, officially establishing as a certified NPO.'
      : '特定非営利活動法人 日本若者防災復興協会は、法務局での設立登記手続きが完了し、令和8年6月21日をもって正式に法人として設立いたしました。若者の力で防災・復興を社会に根づかせるべく、持続可能な活動体制を整えてまいります。'
  },
  {
    title: currentLang === 'en'
      ? '[Event Report] Co-hosted with the Cabinet Office: "All-Japan Student Council Disaster Summit 2026" Held at the House of Representatives'
      : '【開催報告】内閣府共催「全国生徒会防災サミット2026」を衆議院議員会館にて開催',
    url: "https://summit.jyrac.stki.org/",
    date: "2026.03.23",
    category: currentLang === 'en' ? 'Summit' : 'サミット',
    badgeClass: "badge-info",
    hasLink: true,
    summary: currentLang === 'en'
      ? 'Co-hosted with the Cabinet Office, the "All-Japan Student Council Disaster Summit 2026" was held at the House of Representatives Members’ Office Building, bringing together students nationwide for policy proposals and dialogue.'
      : '内閣府共催のもと、東京都・衆議院議員会館にて「全国生徒会防災サミット2026」を開催いたしました。全国の中高生が集い、避難所改善や主体的な防災アクションに関する成果提案を行いました。'
  },
  {
    title: currentLang === 'en'
      ? '[Award] Received Excellence Award at "U20 Youth Action AWARD 2025" (Regional Revitalization Category)'
      : '【受賞】「U20若者活動AWARD 2025 地域活性化部門 優秀賞」を受賞しました',
    url: `/about${langParam}`,
    date: "2025.12.15",
    category: currentLang === 'en' ? 'Award' : '実績',
    badgeClass: "badge-award",
    hasLink: true,
    summary: currentLang === 'en'
      ? 'At the "U20 Youth Action AWARD 2025" hosted by the Japan Youth Career Support Association, JYRAC received the Excellence Award in the Regional Revitalization Category.'
      : '日本若者キャリア支援協会主催「U20若者活動AWARD 2025」において、地域活性化部門の優秀賞を受賞いたしました。これまでご支援いただいた皆さまに心より感謝申し上げます。'
  }
];
---

<Layout title={currentLang === 'en' ? 'Home | JYRAC Japan Youth Resilience Action Consortium' : 'ホーム | JYRAC 日本若者防災復興協会'} currentTab="news">
  <div class="news-page-container">
    
    <header class="news-header">
      <div class="header-logo-wrap">
        <img 
          src={logoSrc} 
          alt="特定非営利活動法人 日本若者防災復興協会 JYRAC" 
          class="header-logo"
          loading="eager"
          decoding="async"
        />
      </div>

      <span class="sub-title">JYRAC NEWS & TOPICS</span>
      <h1 class="main-title">
        {currentLang === 'en' ? 'News & Latest Information' : 'お知らせ・最新情報'}
      </h1>
      <p class="header-desc">
        {currentLang === 'en' 
          ? 'Delivering the latest news from Japan Youth Resilience Action Consortium (JYRAC).' 
          : '特定非営利活動法人 日本若者防災復興協会の活動・最新情報をお届けします。'}
      </p>
    </header>

    <div class="news-list">
      {newsArticles.map((article) => (
        article.hasLink ? (
          <article class={`news-card ${article.badgeClass === 'badge-urgent' ? 'card-urgent' : 'card-link'}`}>
            <div class="card-header">
              <span class={`badge ${article.badgeClass}`}>{article.category}</span>
              <time datetime={article.date} class="news-date">{article.date}</time>
            </div>
            <h2 class="card-title">
              <a href={article.url} target={article.url.startsWith('http') ? '_blank' : '_self'} rel={article.url.startsWith('http') ? 'noopener noreferrer' : ''}>
                {article.title}
              </a>
            </h2>
            <p class="card-summary">{article.summary}</p>
            <div class="card-footer">
              <a href={article.url} target={article.url.startsWith('http') ? '_blank' : '_self'} rel={article.url.startsWith('http') ? 'noopener noreferrer' : ''} class="detail-link">
                {currentLang === 'en' ? 'View Details ➔' : '詳細を見る ➔'}
              </a>
            </div>
          </article>
        ) : (
          <article class="news-card card-normal">
            <div class="card-header">
              <span class={`badge ${article.badgeClass}`}>{article.category}</span>
              <time datetime={article.date} class="news-date">{article.date}</time>
            </div>
            <h2 class="card-title-normal">{article.title}</h2>
            <p class="card-summary">{article.summary}</p>
          </article>
        )
      ))}
    </div>

  </div>
</Layout>

<style>
  .news-page-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px 16px 40px 16px;
    box-sizing: border-box;
  }

  .news-header {
    text-align: center;
    padding-bottom: 24px;
    margin-bottom: 32px;
    border-bottom: 2px solid rgba(0, 154, 166, 0.15);
  }

  .header-logo-wrap {
    margin-bottom: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 50px;
  }

  .header-logo {
    width: auto;
    max-width: 220px;
    height: auto;
    max-height: 90px;
    object-fit: contain;
    display: block;
  }

  .sub-title {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    color: #009aa6;
    background: rgba(0, 154, 166, 0.08);
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
    font-family: ui-monospace, monospace;
  }

  .main-title {
    font-size: 26px;
    font-weight: 900;
    color: #002b54;
    margin: 6px 0;
    line-height: 1.3;
  }

  .header-desc {
    font-size: 13px;
    color: #5b6779;
    margin: 0;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .news-card {
    border-radius: 16px;
    padding: 24px;
    box-sizing: border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .card-urgent {
    background: #ffffff;
    border: 2px solid #e53e3e;
    box-shadow: 0 4px 12px rgba(229, 62, 62, 0.08);
  }

  .card-urgent:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(229, 62, 62, 0.15);
    border-color: #c53030;
  }

  .card-link {
    background: #ffffff;
    border: 1.5px solid #009aa6;
    box-shadow: 0 4px 12px rgba(0, 154, 166, 0.08);
  }

  .card-link:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 154, 166, 0.15);
    border-color: #002b54;
  }

  .card-normal {
    background: #f8fafc;
    border: 1px solid rgba(0, 154, 166, 0.15);
    box-shadow: 0 2px 8px rgba(0, 43, 84, 0.02);
  }

  .card-normal:hover {
    transform: translateY(-4px);
    background: #ffffff;
    border-color: rgba(0, 154, 166, 0.4);
    box-shadow: 0 8px 20px rgba(0, 43, 84, 0.08);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .badge {
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 20px;
    color: #ffffff;
    display: inline-block;
    line-height: 1.2;
  }

  .badge-urgent {
    background: linear-gradient(135deg, #ff4b4b 0%, #c53030 100%);
  }

  .badge-recruitment {
    background: linear-gradient(135deg, #00b4d8 0%, #0077b6 100%);
  }

  .badge-info {
    background: linear-gradient(135deg, #0a4f8f 0%, #002b54 100%);
  }

  .badge-award {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  }

  .news-date {
    font-size: 12px;
    font-weight: 700;
    color: #718096;
    font-family: ui-monospace, monospace;
  }

  .card-title {
    font-size: 17px;
    font-weight: 800;
    margin: 0 0 10px 0;
    line-height: 1.45;
  }

  .card-title a {
    color: #002b54;
    text-decoration: none;
    transition: color 0.2s;
  }

  .card-title a:hover {
    color: #009aa6;
    text-decoration: underline;
  }

  .card-title-normal {
    font-size: 16px;
    font-weight: 800;
    color: #2d3748;
    margin: 0 0 10px 0;
    line-height: 1.45;
  }

  .card-summary {
    font-size: 13px;
    color: #4a5568;
    line-height: 1.6;
    margin: 0;
  }

  .card-footer {
    margin-top: 14px;
    text-align: right;
  }

  .detail-link {
    display: inline-block;
    font-size: 12px;
    font-weight: 800;
    color: #009aa6;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .detail-link:hover {
    opacity: 0.8;
    text-decoration: underline;
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .header-logo {
      max-width: 170px;
    }
    .news-card {
      padding: 18px;
    }
    .main-title {
      font-size: 20px;
    }
    .card-title {
      font-size: 15px;
    }
  }
</style>
