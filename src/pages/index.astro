---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";

const currentLang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// 2. 数字で見るJYRAC データ (2026年6月時点・公式事業説明資料より起算)
const stats = [
  { num: "478", unit: "名", label: "メンバー総数", en: "MEMBERS" }, 
  { num: "23", unit: "件", label: "プロジェクト総数", en: "PROJECTS" },
  { num: "59", unit: "回", label: "募金活動実施数", en: "FUNDRAISING" }, 
  { num: "42", unit: "件", label: "イベント総数", en: "EVENTS" }, 
  { num: "10,128", unit: "人", label: "Instagram総フォロワー", en: "FOLLOWERS" }, 
  { num: "264", unit: "万円超", label: "募金活動総額", en: "DONATIONS" }
];

// 3. 4つの事業領域
const businessDomains = [
  {
    num: "01",
    title: "防災事業",
    enTitle: "Disaster Prevention",
    desc: "内閣府共催「全国生徒会防災サミット」の開催や、自衛隊協力のもと実施する避難所宿泊体験・ハザードマップ作成など、若者自らが行う実践教育を推進。", 
    badge: "生徒会サミット・政策提言・避難所改善", 
    link: `${baseUrl}/services${langParam}#disaster-prevention`
  },
  {
    num: "02",
    title: "復興事業",
    enTitle: "Disaster Recovery",
    desc: "能登現地での家屋片付けボランティアや炊き出し支援、能登うまいもん再発見プロジェクトを通じた食・伝統文化の継承など、息の長い支援を展開。", 
    badge: "能登現地活動・伝統食文化継承", 
    link: `${baseUrl}/services${langParam}#recovery`
  },
  {
    num: "03",
    title: "地域事業",
    enTitle: "Community & Local",
    desc: "街頭募金活動（計59回・260万円超）の実施や、各地の地域防災イベント出展を通じて、住民と若者が平時から手を取り合う共助の基盤を創出。", 
    badge: "街頭募金・地域防災行事出展", 
    link: `${baseUrl}/services${langParam}#community`
  },
  {
    num: "04",
    title: "国際事業",
    enTitle: "Global Initiatives",
    desc: "世界の若者と災害対応を議論する「模擬防災国連」や、国際若者防災復興コミュニティ「Y-VITAL構想」を通じ、日本の防災・復興の経験を世界へ発信。", 
    badge: "Y-VITAL構想・模擬防災国連", 
    link: `${baseUrl}/services${langParam}#international`
  }
];

// ピックアップ最新ニュース（直近3件・news.astroと完全同期）
const pickupNews = [
  {
    date: "2026.09.20",
    category: "サミット",
    title: "「全国生徒会防災サミット2026 秋の陣 DAY 2（10/24開催）」参加エントリー受付中",
    url: "https://summit.jyrac.stki.org/autumn/day2",
    isExt: true
  },
  {
    date: "2026.09.01",
    category: "募集情報",
    title: "【秋期メンバー募集】企画・デザイン・広報・政策提言を担うユースメンバーの募集を開始",
    url: `${baseUrl}/recruitment${langParam}`,
    isExt: false
  },
  {
    date: "2026.08.15",
    category: "復興支援",
    title: "【熊本地震】被災地へ願いを届けるデジタル絵馬特設ページを公開",
    url: "https://nsf.stki.org/ema",
    isExt: true
  }
];
---

<Layout title="特定非営利活動法人 日本若者防災復興協会（JYRAC）" currentTab="home">

  <!-- 1. トップページのファーストビュー（浮遊クリスタル付き） -->
  <section class="hero-wrap">
    <div class="hero-layout">
      
      <!-- テキストカラム -->
      <div class="hero-text-col">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span>OFFICIAL PORTAL / JYRAC</span>
        </div>

        <h1 class="hero-heading">
          「いつもの暮らし」が、いちばん強い。<br class="pc-br"/>
          <span class="text-gradient">若者から始める、新しい防災と復興。</span> 
        </h1>

        <p class="hero-subtext">
          特定非営利活動法人日本若者防災復興協会（JYRAC）は、全国の中学生・高校生・大学生が主体となり、お堅い「お勉強の防災」を刷新。誰もが自然と関わりたくなる持続可能な防災・復興のスタンダードを築くNPO法人です。
        </p>

        <div class="hero-btn-row">
          <a href={`${baseUrl}/about${langParam}`} class="btn-hero btn-navy">JYRACについて知る</a> 
          <a href="#business-domains" class="btn-hero btn-white">活動・事業領域を見る</a>
          <a href={`${baseUrl}/recruitment${langParam}`} class="btn-hero btn-teal">メンバーとして参加する ↗</a>
        </div>
      </div>

      <!-- 浮遊するクリスタルグラフィック -->
      <div class="hero-crystal-col" aria-hidden="true">
        <div class="crystal-stage">
          <div class="crystal-body">
            <div class="crystal-face f1"></div>
            <div class="crystal-face f2"></div>
            <div class="crystal-face f3"></div>
            <div class="crystal-face f4"></div>
            <div class="crystal-face f5"></div>
            <div class="crystal-face f6"></div>
            <div class="crystal-face f7"></div>
            <div class="crystal-face f8"></div>
          </div>
          <!-- 光の軌道リング -->
          <div class="crystal-orbit orbit-1"></div>
          <div class="crystal-orbit orbit-2"></div>
          <div class="crystal-glow"></div>
        </div>
      </div>

    </div>
  </section>

  <div class="content-container">

    <!-- 直近の注力プロジェクト（秋の陣 DAY 2） -->
    <section class="banner-event">
      <div class="banner-text-col">
        <span class="event-tag">NEXT EVENT / 2026.10.24 SAT ZOOM</span>
        <h2 class="event-title">全国生徒会防災サミット2026 秋の陣 DAY 2</h2>
        <p class="event-desc">
          10月のテーマは【考える防災から動く防災へ】。全国の中高生・生徒会役員が集結し、地域や学校の枠を越えたアクションを共創します（参加費完全無料）。
        </p>
      </div>
      <a href="https://summit.jyrac.stki.org/autumn/day2" target="_blank" rel="noopener noreferrer" class="btn-event">
        詳細・エントリー ↗
      </a>
    </section>

    <!-- 2. 数字で見るJYRAC -->
    <section class="section-block">
      <div class="section-header-center">
        <span class="sub-label">FACTS & NUMBERS</span>
        <h2 class="main-heading">数字で見るJYRAC</h2>
        <p class="desc-text">2024年能登半島地震支援の発足から現在までに積み上げてきた活動実績です。</p>
      </div>

      <div class="stats-grid">
        {stats.map(s => (
          <div class="stat-card">
            <span class="stat-en">{s.en}</span>
            <div class="stat-num-row">
              <span class="stat-num">{s.num}</span> 
              <span class="stat-unit">{s.unit}</span>
            </div>
            <span class="stat-label">{s.label}</span> 
          </div>
        ))}
      </div>
    </section>

    <!-- 3. 事業内容（4つの事業領域） -->
    <section id="business-domains" class="section-block">
      <div class="section-header-split">
        <div>
          <span class="sub-label">BUSINESS DOMAINS</span>
          <h2 class="main-heading">4つの事業領域</h2> 
        </div>
        <a href={`${baseUrl}/services${langParam}`} class="header-link">
          各事業の詳細を見る ➔
        </a>
      </div>

      <div class="domain-grid">
        {businessDomains.map(b => (
          <div class="domain-card">
            <div class="domain-top">
              <span class="domain-no">{b.num} / {b.enTitle}</span>
              <span class="domain-badge">{b.badge}</span>
            </div>
            <h3 class="domain-title">{b.title}</h3> 
            <p class="domain-desc">{b.desc}</p> 
          </div>
        ))}
      </div>
    </section>

    <!-- 4. 最新ニュース ＆ 活動沿革 -->
    <section class="news-history-grid">
      <!-- ニュース -->
      <div class="news-column">
        <div class="section-header-split" style="margin-bottom: 14px;">
          <h3 style="font-size: 18px; font-weight: 800; color: var(--jyrac-navy);">最新情報・お知らせ</h3>
          <a href={`${baseUrl}/news${langParam}`} class="header-link">すべて見る ➔</a>
        </div>
        <div class="news-list-vertical">
          {pickupNews.map(n => (
            <a
              href={n.url}
              target={n.isExt ? "_blank" : "_self"}
              rel={n.isExt ? "noopener noreferrer" : ""}
              class="news-row-card"
            >
              <div class="news-row-left">
                <div class="news-meta-inline">
                  <span class="news-badge">{n.category}</span>
                  <time class="news-time">{n.date}</time>
                </div>
                <span class="news-title-text">{n.title}</span> 
              </div>
              <span class="arrow-sym">{n.isExt ? '↗' : '➔'}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- 沿革 -->
      <div class="history-column">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--jyrac-navy); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">これまでの歩み</h3> 
        <ul class="history-list">
          <li>
            <strong>2024年01月</strong>
            <p>能登半島地震を受け、学生支援募金プロジェクト発足</p>
          </li>
          <li>
            <strong>2025年12月</strong>
            <p>「U20若者活動AWARD 2025 優秀賞」を受賞</p>
          </li>
          <li>
            <strong>2026年03月</strong>
            <p>内閣府共催「全国生徒会防災サミット2026」開催（衆議院議員会館）</p>
          </li>
          <li>
            <strong>2026年06月</strong> 
            <p>「特定非営利活動法人 日本若者防災復興協会」登記完了</p>
          </li>
        </ul>
        <a href={`${baseUrl}/history${langParam}`} class="header-link" style="display: block; margin-top: 16px;">
          詳細な沿革・実績年表を見る ➔
        </a>
      </div>
    </section>

    <!-- 7. 組織体制 -->
    <section class="section-block">
      <div style="margin-bottom: 18px;">
        <span class="sub-label">ORGANIZATION CHART</span>
        <h2 class="main-heading">組織体制</h2> 
        <p class="desc-text">外部向けに組織の全体構造（局・各本部・政調会）を簡潔に示しています。</p>
      </div>

      <div class="org-box">
        <div class="org-3col">
          <div class="org-card">
            <h4>各局（法人基盤・統括）</h4>
            <ul>
              <li>・<strong>事務局</strong>（総務・会計・法務・情報部）</li>
              <li>・<strong>人事局</strong>（採用・組織育成）</li>
              <li>・<strong>広報局</strong>（デザイン課・SNS発信・プレス）</li>
              <li>・<strong>外務局</strong>（渉外・連携）</li>
            </ul>
          </div>

          <div class="org-card">
            <h4>各事業本部（プロジェクト推進）</h4>
            <ul>
              <li>・<strong>防災事業本部</strong>（生徒会サミット・避難所改善）</li>
              <li>・<strong>復興事業本部</strong>（能登現地支援・食文化継承）</li>
              <li>・<strong>地域事業本部</strong>（街頭募金・地域防災出展）</li>
              <li>・<strong>国際事業本部</strong>（Y-VITAL・模擬防災国連）</li>
            </ul>
          </div>

          <div class="org-card">
            <h4>政務調査会 ＆ 連携コミュニティ</h4>
            <ul>
              <li>・<strong>政務調査会</strong>（防災政策提言・法案調査）</li>
              <li>・<strong>中高生コミュニティ NSF PROJECTS</strong></li>
              <li>・<strong>避難所議連 事務局支援</strong></li>
            </ul>
          </div>
        </div>

        <div class="org-footer">
          <span>意思決定機関：理事会（理事長：久保 壮太郎） / 監査：監事</span>
          <a href={`${baseUrl}/about${langParam}#members`} class="header-link">役員・メンバー紹介を見る ➔</a>
        </div>
      </div>
    </section>

    <!-- 8. メンバー募集 CTA -->
    <section class="cta-banner">
      <h2>あなたもJYRACで、未来を動かしませんか？</h2>
      <p>
        全国の中学・高校・大学生がオンライン・地方問わず多数活動しています。企画、デザイン、広報、政策提言、現地支援など、あなたの強みを発揮できるチームが必ずあります。
      </p>
      <div class="cta-btn-row">
        <a href={`${baseUrl}/recruitment${langParam}`} class="btn-cta-teal">募集要項・活動詳細を見る ➔</a>
        <a href={`${baseUrl}/contact${langParam}`} class="btn-cta-trans">お問い合わせ</a>
      </div>
    </section>

  </div>

</Layout>

<style>
  /* ヒーロー全体レイアウト */
  .hero-wrap {
    background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
    padding: clamp(32px, 5vw, 64px) 16px;
    border-bottom: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
  }
  .hero-layout {
    max-width: 1160px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(20px, 4vw, 44px);
  }
  .hero-text-col {
    flex: 1 1 580px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    text-align: left;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid #ccfbf1;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 800;
    color: var(--jyrac-teal);
    font-family: ui-monospace, monospace;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--jyrac-teal);
  }
  .hero-heading {
    font-size: clamp(22px, 4.2vw, 32px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.35;
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .text-gradient {
    background: linear-gradient(90deg, var(--jyrac-teal) 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtext {
    max-width: 620px;
    font-size: clamp(13px, 2.4vw, 14px);
    color: var(--text-muted);
    line-height: 1.8;
  }
  .hero-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
    width: 100%;
  }
  .btn-hero {
    padding: 12px 20px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    text-align: center;
    transition: transform 0.2s, opacity 0.2s;
    box-sizing: border-box;
    white-space: nowrap;
  }
  .btn-hero:hover {
    transform: translateY(-2px);
  }
  .btn-navy {
    background: var(--jyrac-navy);
    color: #ffffff !important;
  }
  .btn-white {
    background: #ffffff;
    color: var(--jyrac-navy);
    border: 1px solid var(--border-color);
  }
  .btn-teal {
    background: var(--jyrac-teal);
    color: #ffffff !important;
  }

  /* 💎 浮遊するクリスタルアニメーション */
  .hero-crystal-col {
    flex: 0 0 300px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .crystal-stage {
    position: relative;
    width: 200px;
    height: 240px;
    perspective: 800px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .crystal-body {
    position: relative;
    width: 80px;
    height: 130px;
    transform-style: preserve-3d;
    animation: crystalFloat 6s ease-in-out infinite, crystalSpin 14s linear infinite;
  }
  .crystal-face {
    position: absolute;
    width: 0;
    height: 0;
    border-left: 40px solid transparent;
    border-right: 40px solid transparent;
    opacity: 0.82;
    backdrop-filter: blur(4px);
    transform-origin: 50% 100%;
  }
  .crystal-face.f1 {
    border-bottom: 65px solid rgba(0, 154, 166, 0.7);
    transform: rotateY(0deg) translateZ(24px) rotateX(24deg);
  }
  .crystal-face.f2 {
    border-bottom: 65px solid rgba(0, 210, 224, 0.65);
    transform: rotateY(90deg) translateZ(24px) rotateX(24deg);
  }
  .crystal-face.f3 {
    border-bottom: 65px solid rgba(37, 99, 235, 0.68);
    transform: rotateY(180deg) translateZ(24px) rotateX(24deg);
  }
  .crystal-face.f4 {
    border-bottom: 65px solid rgba(2, 132, 199, 0.7);
    transform: rotateY(270deg) translateZ(24px) rotateX(24deg);
  }
  .crystal-face.f5 {
    top: 65px;
    border-top: 65px solid rgba(0, 43, 84, 0.75);
    border-bottom: none;
    transform: rotateY(0deg) translateZ(24px) rotateX(-24deg);
    transform-origin: 50% 0%;
  }
  .crystal-face.f6 {
    top: 65px;
    border-top: 65px solid rgba(0, 154, 166, 0.7);
    border-bottom: none;
    transform: rotateY(90deg) translateZ(24px) rotateX(-24deg);
    transform-origin: 50% 0%;
  }
  .crystal-face.f7 {
    top: 65px;
    border-top: 65px solid rgba(30, 64, 175, 0.75);
    border-bottom: none;
    transform: rotateY(180deg) translateZ(24px) rotateX(-24deg);
    transform-origin: 50% 0%;
  }
  .crystal-face.f8 {
    top: 65px;
    border-top: 65px solid rgba(0, 90, 156, 0.7);
    border-bottom: none;
    transform: rotateY(270deg) translateZ(24px) rotateX(-24deg);
    transform-origin: 50% 0%;
  }

  .crystal-orbit {
    position: absolute;
    border-radius: 50%;
    border: 1.5px dashed rgba(0, 154, 166, 0.4);
    pointer-events: none;
  }
  .orbit-1 {
    width: 180px;
    height: 180px;
    transform: rotateX(72deg) rotateY(15deg);
    animation: orbitSpin 10s linear infinite;
  }
  .orbit-2 {
    width: 150px;
    height: 150px;
    transform: rotateX(65deg) rotateY(-25deg);
    border-color: rgba(37, 99, 235, 0.35);
    animation: orbitSpinRev 8s linear infinite;
  }
  .crystal-glow {
    position: absolute;
    width: 130px;
    height: 130px;
    background: radial-gradient(circle, rgba(0, 210, 224, 0.3) 0%, rgba(37, 99, 235, 0.08) 50%, transparent 70%);
    filter: blur(14px);
    z-index: 0;
    pointer-events: none;
  }

  @keyframes crystalFloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }
  @keyframes crystalSpin {
    0% { transform: rotateY(0deg) rotateX(12deg); }
    100% { transform: rotateY(360deg) rotateX(12deg); }
  }
  @keyframes orbitSpin {
    0% { transform: rotateX(72deg) rotateY(15deg) rotateZ(0deg); }
    100% { transform: rotateX(72deg) rotateY(15deg) rotateZ(360deg); }
  }
  @keyframes orbitSpinRev {
    0% { transform: rotateX(65deg) rotateY(-25deg) rotateZ(360deg); }
    100% { transform: rotateX(65deg) rotateY(-25deg) rotateZ(0deg); }
  }

  /* コンテナ */
  .content-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 48px) 16px;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 6vw, 54px);
  }

  /* イベントバナー */
  .banner-event {
    background: linear-gradient(135deg, var(--jyrac-navy) 0%, #064e3b 100%);
    border-radius: 18px;
    padding: clamp(18px, 4vw, 28px);
    color: #ffffff;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .banner-text-col {
    max-width: 700px;
  }
  .event-tag {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    background: rgba(255, 255, 255, 0.15);
    padding: 3px 10px;
    border-radius: 12px;
    display: inline-block;
    margin-bottom: 6px;
  }
  .event-title {
    font-size: clamp(16px, 4vw, 20px);
    font-weight: 900;
    margin-bottom: 6px;
    line-height: 1.35;
  }
  .event-desc {
    font-size: 13px;
    color: #cbd5e1;
    line-height: 1.6;
  }
