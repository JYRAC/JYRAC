---
// src/pages/news.astro
import Layout from '../layouts/Layout.astro';
import { type Lang } from '../lib/i18n';

const currentLang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// お知らせ・活動報告データ一覧（時系列整合版）
const newsArticles = [
  {
    id: "summit-autumn-day2",
    date: "2026.09.20",
    category: "SUMMIT",
    categoryJa: "サミット",
    categoryType: "event",
    titleJa: "「全国生徒会防災サミット2026 秋の陣 DAY 2（10/24開催）」参加エントリー受付中",
    titleEn: "Now Accepting Entries: National Student Council Disaster Prevention Summit 2026 Autumn DAY 2 (Oct 24)",
    summaryJa: "10月のテーマは【考える防災から動く防災へ】。全国の中高生・生徒会役員が集結し、学校や地域を越えた防災アクションを共創します（参加費無料）。",
    summaryEn: "Under the theme 'From Thinking to Action', student council leaders across Japan gather online to co-create cross-regional disaster resilience initiatives.",
    link: "https://summit.jyrac.stki.org/autumn/day2",
    isExternal: true
  },
  {
    id: "kumamoto-digital-ema",
    date: "2026.08.15",
    category: "ACTIVITY",
    categoryJa: "復興支援",
    categoryType: "activity",
    titleJa: "【熊本地震】被災地へ願いを届けるデジタル絵馬特設ページを公開",
    titleEn: "Launched Digital Ema Platform to Deliver Messages of Hope to Kumamoto Recovery Areas",
    summaryJa: "震災の記憶をつなぎ、被災地へのエールを集めるデジタル絵馬プロジェクトを公開。全国の若者から寄せられた応援メッセージを現地へ届けます。",
    summaryEn: "Unveiled our interactive digital message platform connecting youth across Japan to support ongoing recovery and remembrance initiatives in Kumamoto.",
    link: "https://nsf.stki.org/ema",
    isExternal: true
  },
  {
    id: "npo-establishment",
    date: "2026.06.21",
    category: "CORPORATE",
    categoryJa: "法人情報",
    categoryType: "report",
    titleJa: "特定非営利活動法人 日本若者防災復興協会 正式設立（登記完了）のお知らせ",
    titleEn: "Official Announcement: Japan Youth Resilience Action Consortium Incorporated as an NPO",
    summaryJa: "学生支援募金プロジェクト発足から2年半を経て、東京都所轄のもと特定非営利活動法人としての登記を完了いたしました。より強固な組織基盤で活動を推進します。",
    summaryEn: "Following 2.5 years of youth-led disaster relief initiatives, JYRAC has officially completed its registration as a Non-Profit Organization in Tokyo.",
    link: `${baseUrl}/about${langParam}`,
    isExternal: false
  },
  {
    id: "noto-winter-relief",
    date: "2026.01.20",
    category: "ACTIVITY",
    categoryJa: "復興支援",
    categoryType: "activity",
    titleJa: "能登現地復興支援：家屋片付けボランティアおよび伝統郷土食を通じた交流を実施",
    titleEn: "Noto Relief Operations: Debris Clearing Volunteers and Community Kitchen Exchanges",
    summaryJa: "発災から2年を迎えた能登半島へ復興事業本部メンバーを派遣。被災家屋の片付け支援のほか、食文化継承プロジェクトの一環として現地高校生との炊き出し交流を行いました。",
    summaryEn: "Dispatched youth volunteer squads to Noto for clean-up assistance and community kitchen sessions in partnership with local high schools.",
    link: `${baseUrl}/services${langParam}#recovery`,
    isExternal: false
  }
];
---

<Layout 
  title={currentLang === 'en' ? 'News & Announcements | JYRAC' : 'お知らせ・最新情報 | 日本若者防災復興協会'} 
  currentTab="news"
>
  <div class="news-page-container">

    <!-- ページ見出し -->
    <header class="page-header">
      <span class="sub-label">NEWS & RELEASES</span>
      <h1 class="main-heading">
        {currentLang === 'en' ? 'News & Announcements' : 'お知らせ・最新情報'}
      </h1>
      <p class="desc-text">
        {currentLang === 'en'
          ? 'Official announcements, press releases, event schedules, and activity reports from JYRAC.'
          : '特定非営利活動法人 日本若者防災復興協会（JYRAC）の最新の活動実績、イベント案内、プレスリリースをお届けします。'}
      </p>
    </header>

    <!-- お知らせ記事リスト -->
    <div class="news-list-stack">
      {newsArticles.map(article => (
        <article class="news-card">
          <div class="news-meta">
            <time class="news-date">{article.date}</time>
            <span class={`news-category cat-${article.categoryType}`}>
              {currentLang === 'en' ? article.category : article.categoryJa}
            </span>
          </div>

          <h2 class="news-title">
            <a 
              href={article.link} 
              target={article.isExternal ? "_blank" : "_self"} 
              rel={article.isExternal ? "noopener noreferrer" : ""}
            >
              {currentLang === 'en' ? article.titleEn : article.titleJa}
              {article.isExternal && <span class="external-icon">↗</span>}
            </a>
          </h2>

          <p class="news-summary">
            {currentLang === 'en' ? article.summaryEn : article.summaryJa}
          </p>

          <div class="news-action">
            <a 
              href={article.link} 
              target={article.isExternal ? "_blank" : "_self"} 
              rel={article.isExternal ? "noopener noreferrer" : ""}
              class="news-link-btn"
            >
              {currentLang === 'en' 
                ? (article.isExternal ? 'Open Link ↗' : 'Read More ➔') 
                : (article.isExternal ? '詳細ページを開く ↗' : '詳細を見る ➔')}
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- 戻るリンク -->
    <div class="back-row">
      <a href={`${baseUrl}/${langParam}`} class="header-link">
        {currentLang === 'en' ? '← Back to Home' : '← ホームに戻る'}
      </a>
    </div>

  </div>
</Layout>

<style>
  .news-page-container {
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 48px) 16px;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 5vw, 40px);
  }

  .page-header {
    text-align: center;
  }
  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }
  .main-heading {
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.3;
  }
  .desc-text {
    font-size: 13.5px;
    color: var(--text-muted);
    margin-top: 8px;
    line-height: 1.7;
  }

  /* 記事リスト */
  .news-list-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .news-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: clamp(18px, 4vw, 24px) clamp(16px, 4vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 4px 16px rgba(0, 43, 84, 0.02);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .news-card:hover {
    border-color: var(--jyrac-teal);
    box-shadow: 0 4px 16px rgba(0, 43, 84, 0.06);
    transform: translateY(-2px);
  }

  /* メタ情報 */
  .news-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .news-date {
    font-family: ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
  }
  .news-category {
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 6px;
    letter-spacing: 0.03em;
  }

  /* カテゴリ別カラー */
  .cat-recruit {
    background: #e0f2fe;
    color: #0284c7;
  }
  .cat-event {
    background: #fef3c7;
    color: #b45309;
  }
  .cat-activity {
    background: #ccfbf1;
    color: #0f766e;
  }
  .cat-report {
    background: #f1f5f9;
    color: #475569;
  }

  /* タイトル */
  .news-title {
    font-size: clamp(15.5px, 3.8vw, 17px);
    font-weight: 800;
    color: var(--jyrac-navy);
    line-height: 1.45;
    margin: 0;
  }
  .news-title a {
    color: inherit;
    text-decoration: none;
  }
  .news-title a:hover {
    color: var(--jyrac-teal);
  }
  .external-icon {
    font-size: 12px;
    margin-left: 4px;
    color: var(--jyrac-teal);
  }

  /* サマリー本文 */
  .news-summary {
    font-size: 13px;
    color: var(--text-main);
    line-height: 1.7;
    margin: 0;
  }

  /* アクションリンク */
  .news-action {
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
  }
  .news-link-btn {
    font-size: 12px;
    font-weight: 800;
    color: var(--jyrac-teal);
    text-decoration: none;
  }
  .news-link-btn:hover {
    text-decoration: underline;
  }

  .header-link {
    font-size: 12px;
    font-weight: 800;
    color: var(--jyrac-teal);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
  .back-row {
    text-align: center;
    margin-top: 8px;
  }
</style>
