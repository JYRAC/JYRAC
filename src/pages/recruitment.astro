---
// src/pages/recruitment.astro
import Layout from "../layouts/Layout.astro";

const currentLang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// 現在募集中のポジション一覧データ
const jobOpenings = [
  {
    id: "pr",
    department: "広報局",
    title: "広報スタッフ（SNS運用・デザイン・Web記事執筆）",
    badge: "募集中",
    badgeType: "open",
    target: "中学生 / 高校生 / 大学生 / 若手社会人",
    location: "完全オンライン（全国どこからでも参加可能）",
    timeCommitment: "週1〜3時間程度（試験・学業最優先）",
    summary: "公式Instagram・X・noteの企画運用や、Canvaを用いた画像制作、Web記事・プレスリリース作成などを通じて、若者の防災・減災アクションを社会へ届けるポジションです。",
    // src/pages/join-pr.astro へのリンク
    detailLink: `${baseUrl}/join-pr${langParam}`,
    isFeatured: true
  },
  {
    id: "disaster-prevention",
    department: "防災事業本部",
    title: "生徒会防災サミット 企画運営・政策提言サポート",
    badge: "募集中",
    badgeType: "open",
    target: "高校生 / 大学生",
    location: "オンライン ＋ 現地（サミット本番・避難所体験等）",
    timeCommitment: "週2〜4時間程度",
    summary: "内閣府共催「全国生徒会防災サミット」のセッション設計や参加校サポート、避難所環境改善（守寝プロジェクト）、国や行政への政策提言ドラフト作成に関わります。",
    detailLink: "https://docs.google.com/forms/d/e/1FAIpQLScv5WAo-g4J7_vufh_NbB-dqhACP9iQihiBCtrK8XJWa2lM_g/viewform?usp=send_form",
    isFeatured: false
  },
  {
    id: "recovery",
    department: "復興事業本部",
    title: "能登現地支援・食文化継承プロジェクトメンバー",
    badge: "募集中",
    badgeType: "open",
    target: "高校生 / 大学生 / 若手社会人",
    location: "オンライン ＋ 能登現地（能登視察・ボランティア）",
    timeCommitment: "週1〜2時間程度 ＋ 現地遠征（任意）",
    summary: "能登半島での家屋片付けや炊き出し支援、仮設住宅での交流会、郷土食の魅力を東京等で届ける「能登うまいもん再発見プロジェクト」などの現地・都市連携企画を担当します。",
    detailLink: "https://docs.google.com/forms/d/e/1FAIpQLScv5WAo-g4J7_vufh_NbB-dqhACP9iQihiBCtrK8XJWa2lM_g/viewform?usp=send_form",
    isFeatured: false
  },
  {
    id: "fundraising",
    department: "地域事業本部 / 募金事業本部",
    title: "街頭支援募金・地域防災イベント企画スタッフ",
    badge: "募集中",
    badgeType: "open",
    target: "中学生 / 高校生 / 大学生",
    location: "各地域（街頭募金実施地）およびオンライン",
    timeCommitment: "月1〜2回（土日活動中心）",
    summary: "被災地支援のための街頭募金活動（累計59回実施・総額260万円超）の現地リーダーや、自治体・地域の防災イベント出展ブースの企画運営を担います。",
    detailLink: "https://docs.google.com/forms/d/e/1FAIpQLScv5WAo-g4J7_vufh_NbB-dqhACP9iQihiBCtrK8XJWa2lM_g/viewform?usp=send_form",
    isFeatured: false
  },
  {
    id: "corporate",
    department: "事務局 / 人事局 / 外務局",
    title: "法人運営・メンバー採用オンボーディング・渉外補佐",
    badge: "若干名",
    badgeType: "limited",
    target: "大学生 / 若手社会人",
    location: "完全オンライン",
    timeCommitment: "週2〜3時間程度",
    summary: "全国470名を超えるメンバーの参加窓口、ITツール運用、総務・法務・会計の補佐、他団体や自治体・協賛企業との連携連絡窓口などを担当します。",
    detailLink: "https://docs.google.com/forms/d/e/1FAIpQLScv5WAo-g4J7_vufh_NbB-dqhACP9iQihiBCtrK8XJWa2lM_g/viewform?usp=send_form",
    isFeatured: false
  }
];
---

<Layout 
  title={currentLang === 'en' ? 'Recruitment & Open Roles | JYRAC' : 'メンバー募集一覧 | 日本若者防災復興協会'} 
  currentTab="recruitment"
>
  <div class="recruit-list-container">

    <header class="page-header">
      <span class="sub-label">JOIN JYRAC</span>
      <h1 class="main-heading">メンバー募集一覧</h1>
      <p class="desc-text">
        全国の中学生・高校生・大学生・若手社会人を対象に、現在募集中のポジション一覧です。<br />
        完全オンライン参加から現地フィールドワークまで、自分のライフスタイルに合わせて関わり方を選べます。
      </p>
    </header>

    <div class="quick-guide-bar">
      <div class="guide-item">
        <span class="step-num">01</span>
        <span>募集要項を選ぶ</span>
      </div>
      <span class="guide-arrow">➔</span>
      <div class="guide-item">
        <span class="step-num">02</span>
        <span>Googleフォームからエントリー</span>
      </div>
      <span class="guide-arrow">➔</span>
      <div class="guide-item">
        <span class="step-num">03</span>
        <span>オンライン面談・Discord合流</span>
      </div>
    </div>

    <div class="job-list-stack">
      {jobOpenings.map(job => (
        <article class={`job-card ${job.isFeatured ? 'job-card-featured' : ''}`}>
          
          <div class="job-card-main">
            <div class="job-top-row">
              <span class="dept-tag">{job.department}</span>
              <span class={`status-pill pill-${job.badgeType}`}>{job.badge}</span>
            </div>

            <h2 class="job-title">
              <a href={job.detailLink}>{job.title}</a>
            </h2>

            <p class="job-summary">{job.summary}</p>

            <div class="job-spec-chips">
              <span class="spec-chip">👤 対象：{job.target}</span>
              <span class="spec-chip">📍 拠点：{job.location}</span>
              <span class="spec-chip">⏱ 目安：{job.timeCommitment}</span>
            </div>
          </div>

          <div class="job-card-action">
            {job.id === 'pr' ? (
              <a href={job.detailLink} class="btn-job-detail">
                詳細・募集要項を見る ➔
              </a>
            ) : (
              <a href={job.detailLink} target="_blank" rel="noopener noreferrer" class="btn-job-detail">
                応募フォームを開く ↗
              </a>
            )}
          </div>

        </article>
      ))}
    </div>

    <section class="common-notice-card">
      <h3 class="notice-heading">どの部門に応募するか迷っている方へ</h3>
      <p class="notice-desc">
        「何かやってみたいけれど、どのポジションが自分に合うかわからない」「活動頻度の相談をしたい」という場合も歓迎しています。エントリーフォームにて「部門未定・相談希望」を選択して送信していただければ、オンライン面談にて適性に合ったチームをご案内いたします。
      </p>
      <div class="notice-btn-row">
        <a 
          href="https://docs.google.com/forms/d/e/1FAIpQLScv5WAo-g4J7_vufh_NbB-dqhACP9iQihiBCtrK8XJWa2lM_g/viewform?usp=send_form" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-general-apply"
        >
          総合エントリー / 相談フォームを開く ↗
        </a>
      </div>
    </section>

    <div class="back-row">
      <a href={`${baseUrl}/${langParam}`} class="header-link">← ホームに戻る</a>
    </div>

  </div>
</Layout>

<style>
  .recruit-list-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 48px 16px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .page-header {
    text-align: center;
  }
  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }
  .main-heading {
    font-size: 28px;
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.3;
  }
  .desc-text {
    font-size: 13.5px;
    color: var(--text-muted);
    margin-top: 8px;
    line-height: 1.7;
  }
  .quick-guide-bar {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--jyrac-navy);
  }
  .guide-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .step-num {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 900;
    background: var(--jyrac-navy);
    color: #ffffff;
    padding: 2px 7px;
    border-radius: 6px;
  }
  .guide-arrow {
    color: var(--jyrac-teal);
    font-size: 12px;
  }
  .job-list-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .job-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    padding: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .job-card:hover {
    border-color: var(--jyrac-teal);
    box-shadow: 0 4px 16px rgba(0, 43, 84, 0.05);
  }
  .job-card-featured {
    border-left: 5px solid var(--jyrac-teal);
    background: linear-gradient(180deg, #ffffff 0%, #fafcfc 100%);
  }
  .job-card-main {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .job-top-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .dept-tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--jyrac-teal);
    font-family: ui-monospace, monospace;
  }
  .status-pill {
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 6px;
  }
  .pill-open {
    background: #e0f2fe;
    color: #0284c7;
  }
  .pill-limited {
    background: #fef3c7;
    color: #d97706;
  }
  .job-title {
    font-size: 18px;
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.4;
    margin: 0;
  }
  .job-title a {
    color: inherit;
    text-decoration: none;
  }
  .job-title a:hover {
    color: var(--jyrac-teal);
  }
  .job-summary {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }
  .job-spec-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
  .spec-chip {
    font-size: 11px;
    color: var(--text-main);
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    padding: 3px 10px;
    border-radius: 6px;
    font-weight: 600;
  }
  .job-card-action {
    flex-shrink: 0;
  }
  .btn-job-detail {
    display: inline-block;
    background: var(--jyrac-navy);
    color: #ffffff !important;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 10px;
    white-space: nowrap;
    transition: background-color 0.2s, transform 0.2s;
  }
  .btn-job-detail:hover {
    background: var(--jyrac-teal);
    transform: translateY(-2px);
  }
  .common-notice-card {
    background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 100%);
    border: 1px solid #ccfbf1;
    border-radius: 18px;
    padding: 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .notice-heading {
    font-size: 18px;
    font-weight: 800;
    color: var(--jyrac-navy);
    margin: 0;
  }
  .notice-desc {
    max-width: 680px;
    font-size: 13px;
    color: var(--text-main);
    line-height: 1.7;
    margin: 0;
  }
  .notice-btn-row {
    margin-top: 8px;
  }
  .btn-general-apply {
    display: inline-block;
    background: var(--jyrac-teal);
    color: #ffffff;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 800;
    padding: 12px 28px;
    border-radius: 10px;
    box-shadow: 0 4px 12px rgba(0, 154, 166, 0.25);
    transition: background-color 0.2s, transform 0.2s;
  }
  .btn-general-apply:hover {
    background: var(--jyrac-teal-dark);
    transform: translateY(-2px);
  }
  .header-link {
    font-size: 12px;
    font-weight: 800;
    color: var(--jyrac-teal);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
  .back-row {
    text-align: center;
  }
  @media (max-width: 768px) {
    .job-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px 16px;
    }
    .btn-job-detail {
      width: 100%;
      text-align: center;
      padding: 12px 16px;
      box-sizing: border-box;
    }
    .job-card-action {
      width: 100%;
    }
    .quick-guide-bar {
      flex-direction: column;
      gap: 8px;
    }
    .guide-arrow {
      transform: rotate(90deg);
    }
  }
</style>
