---
// src/pages/recruitment.astro
import Layout from "../layouts/Layout.astro";

const currentLang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// ポジション一覧（現在募集しているのは広報局のみ）
const activeJob = {
  id: "pr",
  department: "広報局",
  title: "広報スタッフ（公式SNS運用・デザイン・Web記事執筆）",
  badge: "積極募集中",
  badgeType: "open",
  target: "中学生 / 高校生 / 大学生 / 若手社会人",
  location: "完全オンライン（全国どこからでも参加可能）",
  timeCommitment: "週1〜3時間程度（学業・試験期間最優先）",
  summary: "公式Instagram・X・noteの企画運用や、Canvaを用いた画像・動画制作、Webサイト更新、プレスリリース作成などを通じて、若者の防災・減災アクションを社会へ届けるクリエイティブポジションです。",
  detailLink: `${baseUrl}/join-pr${langParam}`
};

// 募集停止中・準備中の部門
const upcomingDepartments = [
  {
    department: "防災事業本部",
    title: "生徒会防災サミット 企画運営・政策提言サポート",
    badge: "次回募集準備中",
    summary: "全国生徒会防災サミットの企画・当日運営、避難所環境改善調査、政策提言ドラフト作成など。"
  },
  {
    department: "復興事業本部",
    title: "能登現地支援・食文化継承プロジェクトメンバー",
    badge: "次回募集準備中",
    summary: "能登半島でのボランティア活動、仮設住宅交流会、郷土食の魅力を伝える物産企画など。"
  },
  {
    department: "地域事業本部 / 募金事業本部",
    title: "街頭支援募金・地域防災イベントスタッフ",
    badge: "次回募集準備中",
    summary: "全国各地での街頭募金活動の運営、地域防災フェスへのブース出展・ワークショップ企画など。"
  },
  {
    department: "事務局 / 人事局 / 外務局",
    title: "法人基盤運営・メンバー育成・渉外補佐",
    badge: "次回募集準備中",
    summary: "メンバー採用オンボーディング、ITツール管理、行政・企業・他団体との連携窓口など。"
  }
];
---

<Layout 
  title={currentLang === 'en' ? 'Recruitment | JYRAC' : 'メンバー募集一覧 | 日本若者防災復興協会'} 
  currentTab="recruitment"
>
  <div class="recruit-list-container">

    <!-- ページ見出し -->
    <header class="page-header">
      <span class="sub-label">JOIN JYRAC</span>
      <h1 class="main-heading">メンバー募集</h1>
      <p class="desc-text">
        現在、日本若者防災復興協会（JYRAC）では<strong>【広報局】</strong>のメンバーを重点募集しています。<br class="pc-br" />
        全国の中学・高校・大学生が完全オンラインで活動中。あなたの発信力やデザインへの興味を、防災と復興の現場で活かしてみませんか？
      </p>
    </header>

    <!-- 応募手順ガイド -->
    <div class="quick-guide-bar">
      <div class="guide-item">
        <span class="step-num">01</span>
        <span>募集要項を確認</span>
      </div>
      <span class="guide-arrow">➔</span>
      <div class="guide-item">
        <span class="step-num">02</span>
        <span>Googleフォームからエントリー</span>
      </div>
      <span class="guide-arrow">➔</span>
      <div class="guide-item">
        <span class="step-num">03</span>
        <span>オンライン面談・Discord合流</span>
      </div>
    </div>

    <!-- 募集中セクション -->
    <section class="section-block">
      <div class="section-title-wrap">
        <span class="status-indicator"></span>
        <h2 class="section-title">現在募集中のポジション</h2>
      </div>

      <!-- 広報局員 注目カード -->
      <article class="active-job-card">
        <div class="job-card-main">
          <div class="job-top-row">
            <span class="dept-tag">{activeJob.department}</span>
            <span class="status-pill pill-active">{activeJob.badge}</span>
          </div>

          <h3 class="job-title">
            <a href={activeJob.detailLink}>{activeJob.title}</a>
          </h3>

          <p class="job-summary">{activeJob.summary}</p>

          <div class="job-spec-chips">
            <span class="spec-chip">👤 対象：{activeJob.target}</span>
            <span class="spec-chip">📍 拠点：{activeJob.location}</span>
            <span class="spec-chip">⏱ 目安：{activeJob.timeCommitment}</span>
          </div>
        </div>

        <div class="job-card-action">
          <a href={activeJob.detailLink} class="btn-job-detail">
            募集要項・詳細を見る ➔
          </a>
          <a 
            href="https://docs.google.com/forms/d/e/1FAIpQLScv5WAo-g4J7_vufh_NbB-dqhACP9iQihiBCtrK8XJWa2lM_g/viewform?usp=send_form" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-job-apply"
          >
            直接エントリー ↗
          </a>
        </div>
      </article>
    </section>

    <!-- 募集準備中セクション -->
    <section class="section-block">
      <div class="section-title-wrap">
        <h2 class="section-title-sub">次回募集準備中のポジション</h2>
        <span class="sub-note">※以下の部門は現在定員またはプロジェクト準備中のため、次回募集開始時に改めて告知いたします。</span>
      </div>

      <div class="closed-jobs-grid">
        {upcomingDepartments.map(dept => (
          <div class="closed-card">
            <div class="closed-top">
              <span class="closed-dept">{dept.department}</span>
              <span class="status-pill pill-closed">{dept.badge}</span>
            </div>
            <h4 class="closed-title">{dept.title}</h4>
            <p class="closed-summary">{dept.summary}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- お問い合わせ・相談カード -->
    <section class="common-notice-card">
      <h3 class="notice-heading">応募前の質問・相談について</h3>
      <p class="notice-desc">
        「学業や部活動と両立できるか不安」「まずは活動の雰囲気を聞いてみたい」という方も大歓迎です。エントリーフォームまたは公式メールよりお気軽にご連絡ください。
      </p>
      <div class="notice-btn-row">
        <a 
          href="https://docs.google.com/forms/d/e/1FAIpQLScv5WAo-g4J7_vufh_NbB-dqhACP9iQihiBCtrK8XJWa2lM_g/viewform?usp=send_form" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-general-apply"
        >
          応募・相談フォームを開く ↗
        </a>
      </div>
    </section>

    <!-- 戻るリンク -->
    <div class="back-row">
      <a href={`${baseUrl}/${langParam}`} class="header-link">← ホームに戻る</a>
    </div>

  </div>
</Layout>

<style>
  .recruit-list-container {
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) 16px;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 5vw, 40px);
  }

  .page-header {
    text-align: center;
  }
  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }
  .main-heading {
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.3;
  }
  .desc-text {
    font-size: 13.5px;
    color: var(--text-muted);
    margin-top: 8px;
    line-height: 1.75;
  }

  /* ガイドバー */
  .quick-guide-bar {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--jyrac-navy);
  }
  .guide-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .step-num {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 900;
    background: var(--jyrac-navy);
    color: #ffffff;
    padding: 2px 7px;
    border-radius: 6px;
  }
  .guide-arrow {
    color: var(--jyrac-teal);
    font-size: 12px;
  }

  /* セクション見出し */
  .section-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2);
    flex-shrink: 0;
  }
  .section-title {
    font-size: clamp(17px, 4vw, 19px);
    font-weight: 900;
    color: var(--jyrac-navy);
    margin: 0;
  }
  .section-title-sub {
    font-size: clamp(15px, 3.8vw, 16px);
    font-weight: 800;
    color: var(--text-muted);
    margin: 0;
  }
  .sub-note {
    font-size: 11px;
    color: var(--text-muted);
    width: 100%;
    margin-top: 2px;
  }

  /* 募集中カード */
  .active-job-card {
    background: #ffffff;
    border: 2px solid var(--jyrac-teal);
    border-radius: 20px;
    padding: clamp(20px, 4vw, 32px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    box-shadow: 0 8px 24px rgba(0, 154, 166, 0.08);
  }
  .job-card-main {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .job-top-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dept-tag {
    font-size: 11.5px;
    font-weight: 800;
    color: var(--jyrac-teal);
    font-family: ui-monospace, monospace;
  }
  .status-pill {
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 6px;
  }
  .pill-active {
    background: #dcfce7;
    color: #15803d;
  }
  .pill-closed {
    background: #f1f5f9;
    color: #64748b;
  }

  .job-title {
    font-size: clamp(17px, 4vw, 20px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.4;
    margin: 0;
  }
  .job-title a {
    color: inherit;
    text-decoration: none;
  }
  .job-title a:hover {
    color: var(--jyrac-teal);
  }

  .job-summary {
    font-size: 13px;
    color: var(--text-main);
    line-height: 1.7;
    margin: 0;
  }

  .job-spec-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .spec-chip {
    font-size: 11px;
    color: var(--text-main);
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    padding: 4px 8px;
    border-radius: 6px;
    font-weight: 600;
  }

  .job-card-action {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
    min-width: 200px;
  }
  .btn-job-detail {
    display: block;
    text-align: center;
    background: var(--jyrac-teal);
    color: #ffffff !important;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    padding: 12px 18px;
    border-radius: 10px;
    transition: background-color 0.2s, transform 0.2s;
    box-sizing: border-box;
  }
  .btn-job-detail:hover {
    background: var(--jyrac-teal-dark);
    transform: translateY(-2px);
  }
  .btn-job-apply {
    display: block;
    text-align: center;
    background: #ffffff;
    color: var(--jyrac-navy) !important;
    border: 1px solid var(--border-color);
    text-decoration: none;
    font-size: 12px;
    font-weight: 800;
    padding: 10px 18px;
    border-radius: 10px;
    transition: background-color 0.2s;
    box-sizing: border-box;
  }
  .btn-job-apply:hover {
    background: var(--bg-light);
  }

  /* 準備中グリッド */
  .closed-jobs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .closed-card {
    background: #ffffff;
    border: 1px dashed var(--border-color);
    border-radius: 14px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    opacity: 0.8;
  }
  .closed-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .closed-dept {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
  }
  .closed-title {
    font-size: 13.5px;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
    line-height: 1.4;
  }
  .closed-summary {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* 相談カード */
  .common-notice-card {
    background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 100%);
    border: 1px solid #ccfbf1;
    border-radius: 18px;
    padding: clamp(20px, 4vw, 32px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .notice-heading {
    font-size: clamp(15.5px, 3.8vw, 17px);
    font-weight: 800;
    color: var(--jyrac-navy);
    margin: 0;
  }
  .notice-desc {
    max-width: 640px;
    font-size: 13px;
    color: var(--text-main);
    line-height: 1.7;
    margin: 0;
  }
  .notice-btn-row {
    margin-top: 4px;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .btn-general-apply {
    display: inline-block;
    background: var(--jyrac-navy);
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 10px;
    transition: background-color 0.2s;
    box-sizing: border-box;
  }
  .btn-general-apply:hover {
    background: var(--jyrac-teal);
  }

  .header-link {
    font-size: 12px;
    font-weight: 800;
    color: var(--jyrac-teal);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
  .back-row {
    text-align: center;
  }

  @media (max-width: 768px) {
    .pc-br {
      display: none;
    }
    .active-job-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px 16px;
    }
    .job-card-action {
      width: 100%;
      min-width: unset;
    }
    .btn-job-detail,
    .btn-job-apply {
      width: 100%;
    }
    .quick-guide-bar {
      flex-direction: column;
      gap: 6px;
      padding: 12px 14px;
    }
    .guide-arrow {
      transform: rotate(90deg);
    }
    .btn-general-apply {
      width: 100%;
      text-align: center;
    }
  }
</style>
