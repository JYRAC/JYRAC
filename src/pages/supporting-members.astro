---
import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from '../lib/i18n';

const currentLang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const isEn = currentLang === 'en';
const langParam = isEn ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = translations[currentLang];
---

<Layout 
  title={isEn ? "Supporting Members | JYRAC" : "賛助会員のご紹介 | 特定非営利活動法人 日本若者防災復興協会（JYRAC）"} 
  currentTab="supporting-members"
>

  <!-- ヒーローセクション -->
  <section class="hero-wrap">
    <div class="hero-layout">
      <div class="hero-text-col">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span>SUPPORTING MEMBERS / JYRAC</span>
        </div>

        <h1 class="hero-heading">
          {isEn ? (
            <>
              Supporting Our Mission for Youth Resilience.<br class="pc-br"/>
              <span class="text-gradient">Our Supporting Members.</span>
            </>
          ) : (
            <>
              若者の防災と復興への支援。<br class="pc-br"/>
              <span class="text-gradient">賛助会員のご紹介</span> 
            </>
          )}
        </h1>

        <p class="hero-subtext">
          {isEn ? (
            <>
              We would like to express our deepest gratitude to the corporations, organizations, and individuals who support the activities and disaster relief projects of the Japan Youth Resilience Action Consortium (JYRAC).
            </>
          ) : (
            <>
              特定非営利活動法人日本若者防災復興協会（JYRAC）の防災・復興事業および若者主体の活動をご支援いただいている賛助会員（法人・個人）の皆様をご紹介いたします。
            </>
          )}
        </p>

        <div class="hero-btn-row">
          <a href="#corporate-logo" class="btn-hero btn-navy">
            {isEn ? "Corporations (Logo)" : "ご賛助企業（ロゴ掲載）"}
          </a> 
          <a href="#corporate-name" class="btn-hero btn-white">
            {isEn ? "Corporations (Name)" : "ご賛助企業（名称掲載）"}
          </a>
          <a href="#individuals" class="btn-hero btn-white">
            {isEn ? "Individuals" : "個人会員"}
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="content-container">

    <!-- 1. 企業・団体（ロゴ掲載） -->
    <section id="corporate-logo" class="section-block">
      <div class="section-header-split">
        <div>
          <span class="sub-label">CORPORATE PARTNERS</span>
          <h2 class="main-heading">
            {isEn ? "Corporate Members (Logo Display)" : "賛助会員（企業・団体 - ロゴ掲載）"}
          </h2>
          <p class="desc-text">
            {isEn 
              ? "Corporations and organizations supporting our activities."
              : "当協会の活動をご支援いただいている企業・団体の皆様（五十音順）"}
          </p>
        </div>
      </div>

      <div class="coming-soon-box">
        <span class="cs-tag">COMING SOON</span>
        <p class="cs-text">{isEn ? "Information will be published soon." : "現在、準備中・順次掲載予定です。"}</p>
      </div>
    </section>

    <!-- 2. 企業・団体（名称掲載） -->
    <section id="corporate-name" class="section-block">
      <div class="section-header-split">
        <div>
          <span class="sub-label">CORPORATE MEMBERS</span>
          <h2 class="main-heading">
            {isEn ? "Corporate Members (Name Display)" : "賛助会員（企業・団体 - 名称掲載）"}
          </h2>
          <p class="desc-text">
            {isEn 
              ? "Corporations and organizations supporting our activities."
              : "当協会の活動をご支援いただいている企業・団体の皆様（五十音順）"}
          </p>
        </div>
      </div>

      <div class="coming-soon-box">
        <span class="cs-tag">COMING SOON</span>
        <p class="cs-text">{isEn ? "Information will be published soon." : "現在、準備中・順次掲載予定です。"}</p>
      </div>
    </section>

    <!-- 3. 個人 -->
    <section id="individuals" class="section-block">
      <div class="section-header-split">
        <div>
          <span class="sub-label">INDIVIDUAL MEMBERS</span>
          <h2 class="main-heading">
            {isEn ? "Individual Members" : "賛助会員（個人）"}
          </h2>
          <p class="desc-text">
            {isEn 
              ? "Individuals supporting our activities."
              : "当協会の活動をご支援いただいている個人の皆様（五十音順・掲載をご希望された方のみ）"}
          </p>
        </div>
      </div>

      <div class="coming-soon-box">
        <span class="cs-tag">COMING SOON</span>
        <p class="cs-text">{isEn ? "Information will be published soon." : "現在、準備中・順次掲載予定です。"}</p>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* ヒーローセクション */
  .hero-wrap {
    background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
    padding: clamp(32px, 5vw, 64px) 16px;
    border-bottom: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
  }
  .hero-layout {
    max-width: 1160px;
    margin: 0 auto;
  }
  .hero-text-col {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    text-align: left;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid #ccfbf1;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 800;
    color: var(--jyrac-teal);
    font-family: ui-monospace, monospace;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--jyrac-teal);
  }
  .hero-heading {
    font-size: clamp(22px, 4.2vw, 32px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.35;
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .text-gradient {
    background: linear-gradient(90deg, var(--jyrac-teal) 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtext {
    max-width: 680px;
    font-size: clamp(13px, 2.4vw, 14px);
    color: var(--text-muted);
    line-height: 1.8;
  }
  .hero-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
    width: 100%;
  }
  .btn-hero {
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 800;
    text-decoration: none;
    text-align: center;
    transition: transform 0.2s, opacity 0.2s;
    box-sizing: border-box;
    white-space: nowrap;
  }
  .btn-hero:hover {
    transform: translateY(-2px);
  }
  .btn-navy {
    background: var(--jyrac-navy);
    color: #ffffff !important;
  }
  .btn-white {
    background: #ffffff;
    color: var(--jyrac-navy);
    border: 1px solid var(--border-color);
  }

  /* コンテナ共通 */
  .content-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 48px) 16px;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 6vw, 54px);
  }

  /* セクション見出し共通 */
  .section-header-split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    display: block;
    letter-spacing: 0.08em;
  }
  .main-heading {
    font-size: clamp(19px, 4.5vw, 24px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.3;
  }
  .desc-text {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  /* 準備中（Coming Soon）ボックス */
  .coming-soon-box {
    background: var(--bg-light);
    border: 1px dashed var(--border-color);
    border-radius: 14px;
    padding: 32px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .cs-tag {
    font-size: 12px;
    font-weight: 900;
    font-family: ui-monospace, monospace;
    color: var(--jyrac-teal);
    background: #ffffff;
    border: 1px solid #ccfbf1;
    padding: 3px 10px;
    border-radius: 6px;
    letter-spacing: 0.08em;
  }
  .cs-text {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
  }
</style>
