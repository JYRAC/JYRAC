---
import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from '../lib/i18n';

const currentLang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const isEn = currentLang === 'en';
const langParam = isEn ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = translations[currentLang];

// 1. ロゴ掲載企業・団体（3口以上）
const corporateLogoMembers = [
  {
    name: "株式会社防災テック・ソリューションズ",
    enName: "Disaster Tech Solutions Co., Ltd.",
    logoUrl: "/images/partners/disaster-tech.png",
    url: "https://example.com/disaster-tech"
  },
  {
    name: "日本ソーシャルレジリエンスホールディングス",
    enName: "Japan Social Resilience Holdings",
    logoUrl: "/images/partners/social-resilience.png",
    url: "https://example.com/social-resilience"
  },
  {
    name: "未来防災イノベーション合同会社",
    enName: "Mirai Disaster Innovation LLC",
    logoUrl: "", // ロゴデータ準備中の場合のテキストフォールバック
    url: "https://example.com/mirai-innovation"
  }
];

// 2. 名称掲載企業・団体（1口以上）
const corporateNameMembers = [
  { name: "あおぞら損害保険株式会社", url: "https://example.com" },
  { name: "合同会社クリエイティブ・フォース", url: "" },
  { name: "西日本地域防災パートナーズ株式会社", url: "https://example.com" },
  { name: "ファースト・レスポンダーズ税理士法人", url: "" },
  { name: "みずほロジスティクスサービス株式会社", url: "" }
];

// 3. 個人会員（1口以上・掲載希望者のみ）
const individualMembers = [
  "阿部 健太郎 様",
  "佐藤 巧 様",
  "T. K. 様",
  "高橋 結衣 様",
  "中村 慎之介 様",
  "H. M. 様",
  "匿名希望 1名"
];
---

<Layout 
  title={isEn ? "Supporting Members | JYRAC" : "賛助会員のご紹介 | 特定非営利活動法人 日本若者防災復興協会（JYRAC）"} 
  currentTab="about"
>

  <!-- ヒーローセクション -->
  <section class="hero-wrap">
    <div class="hero-layout">
      <div class="hero-text-col">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span>SUPPORTING MEMBERS / JYRAC</span>
        </div>

        <h1 class="hero-heading">
          {isEn ? (
            <>
              Supporting Our Mission for Youth Resilience.<br class="pc-br"/>
              <span class="text-gradient">Our Supporting Members.</span>
            </>
          ) : (
            <>
              若者の防災と復興への支援。<br class="pc-br"/>
              <span class="text-gradient">賛助会員のご紹介</span> 
            </>
          )}
        </h1>

        <p class="hero-subtext">
          {isEn ? (
            <>
              We would like to express our deepest gratitude to the corporations, organizations, and individuals who support the activities and disaster relief projects of the Japan Youth Resilience Action Consortium (JYRAC).
            </>
          ) : (
            <>
              特定非営利活動法人日本若者防災復興協会（JYRAC）の防災・復興事業および若者主体の活動をご支援いただいている賛助会員（法人・個人）の皆様をご紹介いたします。
            </>
          )}
        </p>

        <div class="hero-btn-row">
          <a href="#corporate-logo" class="btn-hero btn-navy">
            {isEn ? "Corporations (Logo)" : "ご賛助企業（ロゴ掲載）"}
          </a> 
          <a href="#corporate-name" class="btn-hero btn-white">
            {isEn ? "Corporations (Name)" : "ご賛助企業（名称掲載）"}
          </a>
          <a href="#individuals" class="btn-hero btn-white">
            {isEn ? "Individuals" : "個人会員"}
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="content-container">

    <!-- 1. ロゴ掲載企業・団体（3口以上） -->
    <section id="corporate-logo" class="section-block">
      <div class="section-header-split">
        <div>
          <span class="sub-label">CORPORATE PARTNERS</span>
          <h2 class="main-heading">
            {isEn ? "Corporate Members" : "賛助会員（企業・団体）"}
          </h2>
          <p class="desc-text">
            {isEn 
              ? "Corporations and organizations supporting our activities."
              : "当協会の活動をご支援いただいている企業・団体の皆様（五十音順）"}
          </p>
        </div>
      </div>

      <div class="logo-grid">
        {corporateLogoMembers.map(m => (
          <div class="logo-card">
            <div class="logo-box">
              {m.logoUrl ? (
                <img src={m.logoUrl} alt={m.name} class="partner-logo" />
              ) : (
                <div class="logo-placeholder">
                  <span>{m.name}</span>
                </div>
              )}
            </div>
            <div class="logo-body">
              <h3 class="company-name">{isEn ? m.enName : m.name}</h3>
              {m.url && (
                <a href={m.url} target="_blank" rel="noopener noreferrer" class="company-link">
                  {isEn ? "Official Website ↗" : "Webサイト ↗"}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. 名称掲載企業・団体（1口以上） -->
    <section id="corporate-name" class="section-block">
      <div class="section-header-split">
        <div>
          <span class="sub-label">CORPORATE MEMBERS</span>
          <h2 class="main-heading">
            {isEn ? "Corporate Members (Name Display)" : "賛助会員（企業・団体）"}
          </h2>
          <p class="desc-text">
            {isEn 
              ? "Corporations and organizations supporting our activities."
              : "当協会の活動をご支援いただいている企業・団体の皆様（五十音順）"}
          </p>
        </div>
      </div>

      <div class="name-corporate-grid">
        {corporateNameMembers.map(m => (
          <div class="name-card">
            <span class="corp-title">{m.name}</span>
            {m.url && (
              <a href={m.url} target="_blank" rel="noopener noreferrer" class="arrow-link" title="Webサイトを開く">
                ↗
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- 3. 個人会員（1口以上） -->
    <section id="individuals" class="section-block">
      <div class="section-header-split">
        <div>
          <span class="sub-label">INDIVIDUAL MEMBERS</span>
          <h2 class="main-heading">
            {isEn ? "Individual Members" : "賛助会員（個人）"}
          </h2>
          <p class="desc-text">
            {isEn 
              ? "Individuals supporting our activities."
              : "当協会の活動をご支援いただいている個人の皆様（五十音順・掲載をご希望された方のみ）"}
          </p>
        </div>
      </div>

      <div class="individual-box">
        <ul class="individual-list">
          {individualMembers.map(name => (
            <li class="individual-item">
              <span class="indiv-name">{name}</span>
            </li>
          ))}
        </ul>
        <p class="privacy-note">
          ※掲載のご希望をいただいた方のみ掲載しております。
        </p>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* ヒーローセクション */
  .hero-wrap {
    background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
    padding: clamp(32px, 5vw, 64px) 16px;
    border-bottom: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
  }
  .hero-layout {
    max-width: 1160px;
    margin: 0 auto;
  }
  .hero-text-col {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    text-align: left;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid #ccfbf1;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 800;
    color: var(--jyrac-teal);
    font-family: ui-monospace, monospace;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--jyrac-teal);
  }
  .hero-heading {
    font-size: clamp(22px, 4.2vw, 32px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.35;
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .text-gradient {
    background: linear-gradient(90deg, var(--jyrac-teal) 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtext {
    max-width: 680px;
    font-size: clamp(13px, 2.4vw, 14px);
    color: var(--text-muted);
    line-height: 1.8;
  }
  .hero-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
    width: 100%;
  }
  .btn-hero {
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 800;
    text-decoration: none;
    text-align: center;
    transition: transform 0.2s, opacity 0.2s;
    box-sizing: border-box;
    white-space: nowrap;
  }
  .btn-hero:hover {
    transform: translateY(-2px);
  }
  .btn-navy {
    background: var(--jyrac-navy);
    color: #ffffff !important;
  }
  .btn-white {
    background: #ffffff;
    color: var(--jyrac-navy);
    border: 1px solid var(--border-color);
  }

  /* コンテナ共通 */
  .content-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 48px) 16px;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 6vw, 54px);
  }

  /* セクション見出し共通 */
  .section-header-split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal);
    display: block;
    letter-spacing: 0.08em;
  }
  .main-heading {
    font-size: clamp(19px, 4.5vw, 24px);
    font-weight: 900;
    color: var(--jyrac-navy);
    line-height: 1.3;
  }
  .desc-text {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  /* 1. ロゴカードグリッド */
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .logo-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s;
  }
  .logo-card:hover {
    transform: translateY(-2px);
    border-color: var(--jyrac-teal);
  }
  .logo-box {
    height: 80px;
    background: var(--bg-light);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    margin-bottom: 12px;
    border: 1px solid var(--border-color);
  }
  .partner-logo {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
  }
  .logo-placeholder {
    font-size: 12.5px;
    font-weight: 800;
    color: var(--jyrac-navy);
    text-align: center;
  }
  .logo-body {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .company-name {
    font-size: 13.5px;
    font-weight: 800;
    color: var(--jyrac-navy);
  }
  .company-link {
    font-size: 11.5px;
    font-weight: 800;
    color: var(--jyrac-teal);
    text-decoration: none;
    white-space: nowrap;
  }
  .company-link:hover {
    text-decoration: underline;
  }

  /* 2. 名称掲載企業グリッド */
  .name-corporate-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }
  .name-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .corp-title {
    font-size: 13px;
    font-weight: 800;
    color: var(--jyrac-navy);
  }
  .arrow-link {
    color: var(--jyrac-teal);
    font-size: 14px;
    text-decoration: none;
    font-weight: 800;
  }

  /* 3. 個人会員ボックス */
  .individual-box {
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 20px;
  }
  .individual-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 10px;
  }
  .individual-item {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 10px 14px;
    text-align: center;
  }
  .indiv-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-main);
  }
  .privacy-note {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 14px;
    text-align: right;
  }

  @media (max-width: 768px) {
    .individual-list {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    }
  }
</style>
