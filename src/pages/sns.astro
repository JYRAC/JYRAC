---
// src/pages/sns.astro
import Layout from '../layouts/Layout.astro';
import { translations, type Lang } from '../lib/i18n';

// URLから言語パラメーターを取得 (プロトコルをhttpsに整形)
const requestUrl = Astro.request.url.replace(/^http:/, 'https:');
const url = new URL(requestUrl);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// 1. DATA LAYER (SNSリンクのURLや文言を一元管理)
const jyracSns = [
  {
    type: "x",
    title: "X (formerly Twitter) ↗",
    url: "https://x.com/jyrac_official",
    desc: currentLang === 'en' 
      ? 'Official press releases, announcements, and news from JYRAC.' 
      : 'JYRAC法人の公式プレス、お知らせ、ニュースなどをテキストで発信しています。'
  },
  {
    type: "instagram",
    title: "Instagram ↗",
    url: "https://www.instagram.com/jyrac_official",
    desc: currentLang === 'en'
      ? 'Activity reports and joint posts with NSF shared via photos and Reels videos.'
      : '活動報告やNSFとの共同投稿などを、写真やリール動画で投稿しています。'
  },
  {
    type: "note",
    title: currentLang === 'en' ? 'note (JYRAC Only) ↗' : 'note (※JYRACのみ) ↗',
    url: "https://note.com/jyrac_official",
    desc: currentLang === 'en'
      ? 'Columns and background stories sharing thoughts on disaster prevention from our representatives.'
      : '防災・復興に対する代表や役員の想い、活動の背景にあるストーリーをコラム形式などで発信しています。'
  }
];

const nsfSns = [
  {
    type: "x",
    title: "X (formerly Twitter) ↗",
    url: "https://x.com/nsf_project",
    desc: currentLang === 'en'
      ? 'Sharing news, project updates, and announcements.'
      : 'お知らせ、ニュースなどを発信しています。'
  },
  {
    type: "instagram",
    title: "Instagram ↗",
    url: "https://www.instagram.com/nsf_project",
    desc: currentLang === 'en'
      ? 'Activity reports, joint posts with JYRAC and various projects, and event announcements.'
      : '活動報告や、JYRAC・各種プロジェクトとの共同投稿、イベント告知などを発信しています。'
  }
];
---

<Layout 
  title={currentLang === 'en' ? 'Official SNS List | Japan Youth Resilience Action Consortium' : '公式SNS一覧 | 日本若者防災復興協会'} 
  currentTab="sns"
>
  <div class="content-panel">
    <header class="sns-page-header">
      <span class="sub-label">SOCIAL CHANNELS</span>
      <h2>
        {currentLang === 'en' ? 'Official SNS Accounts' : '公式SNS一覧'}
      </h2>
      <p class="lead-text">
        {currentLang === 'en'
          ? 'A list of official SNS accounts for Japan Youth Resilience Action Consortium (JYRAC) and its affiliated NSF PROJECTs. We share real-time activity progress and disaster prevention insights from a youth perspective.'
          : '日本若者防災復興協会（JYRAC）、および傘下のNSF PROJECTsの公式SNSアカウント一覧です。活動のリアルタイム進捗や、若者目線での防災・減災を目指し発信しています。'}
      </p>
    </header>
    
    <section class="sns-group-section">
      <h3 class="sns-group-title">
        🏢 {currentLang === 'en' ? 'Japan Youth Resilience Action Consortium (JYRAC)' : '日本若者防災復興協会（JYRAC）'}
      </h3>
      <div class="sns-grid sns-grid-triple">
        {jyracSns.map((sns) => (
          <a href={sns.url} class={`sns-card sns-${sns.type}`} target="_blank" rel="noopener noreferrer">
            <h4>{sns.title}</h4>
            <p>{sns.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="sns-group-section" style="margin-top: clamp(32px, 5vw, 48px);">
      <h3 class="sns-group-title">🎓 NSF PROJECTs</h3>
      <div class="sns-grid">
        {nsfSns.map((sns) => (
          <a href={sns.url} class={`sns-card sns-${sns.type}`} target="_blank" rel="noopener noreferrer">
            <h4>{sns.title}</h4>
            <p>{sns.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- ホームに戻るリンク -->
    <div class="back-row">
      <a href={`${baseUrl}/${langParam}`} class="header-link">
        {currentLang === 'en' ? '← Back to Home' : '← ホームに戻る'}
      </a>
    </div>
  </div>
</Layout>

<style>
  .content-panel {
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 44px) 16px clamp(36px, 6vw, 56px) 16px;
    box-sizing: border-box;
  }

  .sns-page-header {
    margin-bottom: clamp(24px, 4vw, 36px);
  }

  .sub-label {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: var(--jyrac-teal, #009aa6);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }

  h2 {
    color: #002b54;
    font-size: clamp(20px, 4.5vw, 25px);
    font-weight: 800;
    margin-top: 0;
    margin-bottom: 12px;
    border-left: 5px solid var(--jyrac-teal, #009aa6);
    padding-left: 12px;
    line-height: 1.35;
  }

  .lead-text {
    color: #4f5e71;
    font-size: clamp(13px, 3vw, 14.5px);
    line-height: 1.8;
    margin: 0;
  }

  /* グループ見出し */
  .sns-group-title {
    font-size: clamp(15px, 3.5vw, 16.5px);
    font-weight: 800;
    color: #002b54;
    margin: 0 0 14px 0;
    border-left: 4px solid var(--jyrac-teal, #009aa6);
    padding-left: 10px;
    letter-spacing: 0.5px;
    line-height: 1.4;
  }

  /* SNSカードグリッド */
  .sns-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(14px, 3vw, 20px);
  }
  @media (min-width: 650px) {
    .sns-grid {
      grid-template-columns: 1fr 1fr;
    }
    .sns-grid-triple {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
  }

  /* 共通カードデザイン */
  .sns-card {
    background: #ffffff;
    border: 1px solid rgba(0, 154, 166, 0.15);
    border-radius: 16px;
    padding: clamp(16px, 3.5vw, 22px);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    box-sizing: border-box;
  }
  
  .sns-card h4 {
    margin: 0 0 8px 0;
    font-size: clamp(15px, 3.8vw, 16.5px);
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.35;
    word-break: break-word;
  }
  
  .sns-card p {
    margin: 0;
    font-size: 12.5px;
    color: #64748b;
    font-weight: 500;
    line-height: 1.6;
  }
  
  /* 各カードのホバー効果 */
  .sns-x:hover {
    border-color: #000000;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-3px);
  }
  .sns-x h4 { color: #000000; }

  .sns-instagram:hover {
    border-color: #e1306c;
    box-shadow: 0 8px 24px rgba(225, 48, 108, 0.12);
    transform: translateY(-3px);
  }
  .sns-instagram h4 { color: #e1306c; }

  .sns-note:hover {
    border-color: #23c175;
    box-shadow: 0 8px 24px rgba(35, 193, 117, 0.12);
    transform: translateY(-3px);
  }
  .sns-note h4 { color: #23c175; }

  /* ホームに戻るリンク */
  .back-row {
    text-align: center;
    margin-top: clamp(32px, 6vw, 48px);
  }
  .header-link {
    font-size: 12.5px;
    font-weight: 800;
    color: var(--jyrac-teal, #009aa6);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
</style>
