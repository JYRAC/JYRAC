---
// src/pages/services.astro
import Layout from '../layouts/Layout.astro';
import { type Lang } from '../lib/i18n';

const currentLang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout 
  title={currentLang === 'en' ? 'Services & Activities | JYRAC' : '主な事業・活動内容 | 日本若者防災復興協会'} 
  currentTab="services"
>
  <div class="content-panel">
    <h2>
      {currentLang === 'en' ? 'Main Services & Activities' : '主な事業・活動内容'}
    </h2>
    
    <p class="lead-text">
      {currentLang === 'en'
        ? 'To comprehensively support the proactive and creative disaster prevention and recovery activities of youth, our organization develops and backs the following core infrastructure initiatives.'
        : '当団体は、若者たちの主体かつ創造的な防災・復興活動を全面的にサポートするため、以下の基盤事業を展開・支援してまいります。'}
    </p>
    
    <div class="project-grid">
      <!-- 1. NSF PROJECTs -->
      <div class="project-card">
        <div class="card-body">
          <h4>
            <span class="project-badge">
              {currentLang === 'en' ? 'Support Platform' : '支援基盤事業'}
            </span>
            {currentLang === 'en' ? 'Student-Led Project "NSF PROJECTs"' : '学生主体プロジェクト「NSF PROJECTs」'}
          </h4>
          <p>
            {currentLang === 'en'
              ? 'Centered around junior high, high school, and university students nationwide, this project conducts recovery support for disaster-affected areas such as the Noto Peninsula Earthquake, as well as flexible disaster awareness from a youth perspective. JYRAC supports their legal and financial foundations.'
              : '全国の中高生・大学生が中心となり、能登半島地震をはじめとする被災地への復興支援や、若者目線での柔軟な防災啓発を行っています。当団体は、彼らの法的・財政的基盤を支えています。'}
          </p>
        </div>
        <a href="https://nsf.stki.org/" class="btn-link" target="_blank" rel="noopener noreferrer">
          {currentLang === 'en' ? 'Official Site ➔' : '公式サイト ➔'}
        </a>
      </div>

      <!-- 2. 全国生徒会防災サミット -->
      <div class="project-card orange-card">
        <div class="card-body">
          <h4>
            <span class="project-badge summit">
              {currentLang === 'en' ? 'Hosted Event' : '主催事業'}
            </span>
            {currentLang === 'en' ? 'National Student Council Disaster Prevention Summit' : '全国生徒会防災サミット'}
          </h4>
          <p>
            {currentLang === 'en'
              ? 'The flagship summit organized by JYRAC. We pass down lessons from the Great East Japan Earthquake and the Noto Peninsula Earthquake, hold cross-regional and intergenerational disaster management discussions, and issue "Next-Generation Disaster Management Proposals" driven by youth.'
              : 'JYRACが主催する最重要サミットです。東日本大震災や能登半島地震などの教訓の継承、地域や世代を超えた防災ディスカッションを行い、若者発の「次世代防災提言」を発信しています。'}
          </p>
        </div>
        <a href="https://summit.jyrac.stki.org" class="btn-link btn-summit" target="_blank" rel="noopener noreferrer">
          {currentLang === 'en' ? 'Official Site ➔' : '公式サイト ➔'}
        </a>
      </div>

      <!-- 3. 模擬防災国連 (MWCDRR) -->
      <div class="project-card navy-card">
        <div class="card-body">
          <h4>
            <span class="project-badge mwcdrr">
              {currentLang === 'en' ? 'Hosted Event' : '主催事業'}
            </span>
            {currentLang === 'en' ? 'Model World Conference on Disaster Risk Reduction (MWCDRR)' : '模擬防災国連（MWCDRR）'}
          </h4>
          <p>
            {currentLang === 'en'
              ? 'Modeled after the UN World Conference on Disaster Risk Reduction, participants represent various nations to discuss, negotiate, and formulate international disaster policies. This program empowers youth to tackle global disaster risk reduction from international perspectives.'
              : '国連防災世界会議をモデルとし、参加者が各国代表になりきって国際的な防災・減災政策を議論・交渉するプログラムです。「模擬国連」の仕組みを通じて、若者が国際的・多角的な視野から防災に向き合う場を提供します。'}
          </p>
        </div>
        <a href="https://mwcdrr.jyrac.stki.org/" class="btn-link btn-mwcdrr" target="_blank" rel="noopener noreferrer">
          {currentLang === 'en' ? 'Official Site ➔' : '公式サイト ➔'}
        </a>
      </div>
    </div>

    <!-- ホームへ戻る -->
    <div class="back-row">
      <a href={`${baseUrl}/${langParam}`} class="header-link">
        {currentLang === 'en' ? '← Back to Home' : '← ホームに戻る'}
      </a>
    </div>
  </div>
</Layout>

<style>
  .content-panel {
    max-width: 1040px;
    margin: 0 auto;
    padding: 36px 16px 48px 16px;
  }
  
  h2 {
    color: var(--jyrac-navy, #002b54);
    font-size: 24px;
    font-weight: 800;
    margin-top: 0;
    margin-bottom: 20px;
    border-left: 5px solid var(--jyrac-teal, #009aa6);
    padding-left: 15px;
  }

  .lead-text {
    color: #4f5e71;
    font-size: 14.5px;
    line-height: 1.8;
    margin-bottom: 35px;
  }

  /* グリッドレイアウト */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }

  /* カードデザイン */
  .project-card {
    background: #ffffff;
    border: 1px solid rgba(0, 154, 166, 0.15);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 4px 16px rgba(0, 43, 84, 0.03);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 154, 166, 0.1);
  }
  .project-card.orange-card {
    border-color: rgba(230, 126, 34, 0.25);
  }
  .project-card.navy-card {
    border-color: rgba(0, 43, 84, 0.25);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .project-card h4 {
    margin: 0;
    font-size: 17px;
    font-weight: 800;
    color: var(--jyrac-navy, #002b54);
    line-height: 1.45;
  }

  /* バッジ */
  .project-badge {
    display: block;
    width: fit-content;
    font-size: 10px;
    font-weight: 800;
    color: #fff;
    background: var(--jyrac-teal, #009aa6);
    padding: 2px 8px;
    border-radius: 6px;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }
  .project-badge.summit {
    background: #e67e22;
  }
  .project-badge.mwcdrr {
    background: #005a9c;
  }

  .project-card p {
    margin: 0;
    color: #5b6779;
    font-size: 13.5px;
    line-height: 1.7;
  }

  /* ボタンリンク */
  .btn-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff !important;
    padding: 12px 24px;
    text-decoration: none;
    border-radius: 10px;
    font-weight: 700;
    font-size: 13.5px;
    background: linear-gradient(135deg, #009aa6 0%, #00b4c5 100%);
    box-shadow: 0 4px 14px rgba(0, 154, 166, 0.2);
    transition: opacity 0.2s, transform 0.1s;
    margin-top: auto;
  }
  .btn-link:hover {
    opacity: 0.95;
  }
  .btn-link:active {
    transform: translateY(2px);
  }

  .btn-summit {
    background: linear-gradient(135deg, #e67e22 0%, #f39c12 100%);
    box-shadow: 0 4px 14px rgba(230, 126, 34, 0.25);
  }

  .btn-mwcdrr {
    background: linear-gradient(135deg, #005a9c 0%, #1a82d2 100%);
    box-shadow: 0 4px 14px rgba(0, 90, 156, 0.25);
  }

  .back-row {
    text-align: center;
    margin-top: 48px;
  }
  .header-link {
    font-size: 12.5px;
    font-weight: 800;
    color: var(--jyrac-teal, #009aa6);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
</style>
