---
// src/pages/gioco.astro
import Layout from '../layouts/Layout.astro';
import { type Lang } from '../lib/i18n';

// URLから言語パラメーターを取得
const currentLang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout 
  title={currentLang === 'en' ? 'Educational Tools & Diagnosis | JYRAC' : 'オリジナル教材・診断ツール | 日本若者防災復興協会'} 
  currentTab="gioco"
>
  <div class="portal-wrapper">
    <div class="content-panel">
      
      <!-- ヘッダーエリア -->
      <header class="portal-header">
        <div class="title-badge">
          {currentLang === 'en' ? 'JYRAC Original Digital Tools' : 'JYRAC独自開発デジタル教材・ツール'}
        </div>
        <h2>
          {currentLang === 'en' ? 'Educational Tools & Diagnosis' : 'オリジナル教材・診断ツール'}
        </h2>
        <p class="portal-desc">
          {currentLang === 'en' ? (
            <>Experience youth-led disaster prevention through our interactive shelter game and mutual aid personality diagnosis tool.</>
          ) : (
            <>子どもから大人まで直感的に学べる避難所運営ゲームや、自分の助け方の強みを知る共助診断ツールを体験できます。</>
          )}
        </p>
      </header>

      <!-- ツール選択グリッド -->
      <div class="tools-grid">

        <!-- カード 1: HUG Gioco -->
        <article class="tool-card card-gioco">
          <div class="card-top">
            <span class="category-badge badge-sun">🎮 {currentLang === 'en' ? 'Simulation Game' : '防災ゲーム'}</span>
            <h3>HUG Gioco</h3>
            <span class="sub-title">
              {currentLang === 'en' 
                ? '— TKB Evacuation Shelter Discussion Game' 
                : '— TKB型避難所運営ディスカッションゲーム'}
            </span>
            <p class="card-desc">
              {currentLang === 'en' ? (
                <>Card-driven "What if" shelter environments. Discuss TKB (Toilets, Kitchens, Beds) challenges and discover questions together in a next-gen disaster simulation.</>
              ) : (
                <>カードが織りなす「もしも」の避難所環境。避難所で極めて重要なTKB（トイレ・キッチン・ベッド）をテーマに、話し合いで課題解決を考える対話型シミュレーションゲームです。</>
              )}
            </p>
            <ul class="feature-list">
              <li>👥 {currentLang === 'en' ? '1 to 5+ Players (Solo or Groups)' : '1人ワーク〜5人以上のグループ・研修対応'}</li>
              <li>🚨 {currentLang === 'en' ? 'Random emergencies & realistic incidents' : '突発トラブルやランダムアクシデント発生'}</li>
              <li>☁️ {currentLang === 'en' ? 'Digital reflection & automatic sheet submit' : 'ワークシートの自動集約・送信機能つき'}</li>
            </ul>
          </div>
          <div class="card-bottom">
            <a href={`${baseUrl}/hug-gioco${langParam}`} class="btn-launch btn-gioco" target="_blank" rel="noopener">
              {currentLang === 'en' ? '🎲 Launch HUG Gioco ➔' : '🎲 HUG Gioco を起動する ➔'}
            </a>
            <span class="btn-note">
              {currentLang === 'en' ? '*Opens in a new window (PC, Tablet, Smartphone)' : '※別ウィンドウで起動（PC・スマホ対応）'}
            </span>
          </div>
        </article>

        <!-- カード 2: ぼうさい8 -->
        <article class="tool-card card-bosai8">
          <div class="card-top">
            <span class="category-badge badge-coral">🐾 {currentLang === 'en' ? 'Type Diagnosis' : '共助診断'}</span>
            <h3>ぼうさい8</h3>
            <span class="sub-title">
              {currentLang === 'en' 
                ? '— Disaster Mutual Aid Type Diagnosis' 
                : '— 防災共助タイプ診断'}
            </span>
            <p class="card-desc">
              {currentLang === 'en' ? (
                <>How would you help in a disaster? Answer 20 scenario-based questions to discover which of the 8 animal helper types matches your unique strengths.</>
              ) : (
                <>災害のとき、人の助け方はひとつじゃない。場面ごとの直感的な選択から、あなたの助け方に近い「8匹の動物タイプ」を見つけ出す自己発見ツールです。</>
              )}
            </p>
            <ul class="feature-list">
              <li>⏱️ {currentLang === 'en' ? 'Quick test: 2-3 mins (15+5 questions)' : '所要時間 約2〜3分（15問＋5問）'}</li>
              <li>📊 {currentLang === 'en' ? 'Analyzed across 3 operational axes' : '支援機能・行動様式・支援射程の3軸分析'}</li>
              <li>🤝 {currentLang === 'en' ? 'Discover your buddy and opposite types' : '避難所での持ち場・相棒タイプがわかる'}</li>
            </ul>
          </div>
          <div class="card-bottom">
            <a href={`${baseUrl}/bosai8${langParam}`} class="btn-launch btn-bosai8">
              {currentLang === 'en' ? '🐾 Start Bosai 8 ➔' : '🐾 ぼうさい8 をはじめる ➔'}
            </a>
            <span class="btn-note">
              {currentLang === 'en' ? '*Results sent directly to your email' : '※結果をメールで保存可能'}
            </span>
          </div>
        </article>

      </div>

      <!-- 戻るリンク -->
      <div class="back-row">
        <a href={`${baseUrl}/${langParam}`} class="header-link">
          {currentLang === 'en' ? '← Back to Home' : '← ホームに戻る'}
        </a>
      </div>

    </div>
  </div>
</Layout>

<style>
  .portal-wrapper {
    --navy: #1B3A8C;
    --navy-deep: #152E70;
    --green: #2E9E4F;
    --red: #E01E2B;
    --sun: #FFD23F;
    --coral: #EF5A48;
    --ink: #233047;
    --ink-soft: #5b6779;
    --line: #E7E0D0;
    --shadow: 0 8px 24px rgba(27, 58, 140, 0.08);

    color: var(--ink);
    padding: clamp(20px, 5vw, 44px) 16px;
  }

  .content-panel {
    max-width: 960px;
    margin: 0 auto;
    text-align: left;
  }

  /* ポータルヘッダー */
  .portal-header {
    text-align: center;
    margin-bottom: clamp(24px, 4vw, 36px);
    border-bottom: 2px solid rgba(0, 154, 166, 0.15);
    padding-bottom: clamp(16px, 3vw, 24px);
  }

  .title-badge {
    display: inline-block;
    background: var(--navy);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 6px;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
  }

  .portal-header h2 {
    font-family: 'Baloo 2', 'Zen Maru Gothic', sans-serif;
    color: var(--navy);
    font-size: clamp(1.45rem, 5vw, 2rem);
    font-weight: 900;
    margin: 0 0 10px 0;
    line-height: 1.25;
  }

  .portal-desc {
    font-size: clamp(0.88rem, 2.5vw, 0.95rem);
    color: var(--ink-soft);
    line-height: 1.7;
    margin: 0 auto;
    max-width: 650px;
  }

  /* ツール選択グリッド */
  .tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(18px, 3vw, 28px);
  }

  @media (min-width: 768px) {
    .tools-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ツールカード共通スタイル */
  .tool-card {
    background: #fff;
    border: 2px solid var(--line);
    border-radius: 22px;
    padding: clamp(20px, 4vw, 32px) clamp(16px, 3.5vw, 26px);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .tool-card:hover {
    transform: translateY(-4px);
  }

  .card-gioco {
    border-color: #ffe599;
  }
  .card-gioco:hover {
    box-shadow: 0 12px 30px rgba(255, 210, 63, 0.25);
  }

  .card-bosai8 {
    border-color: #ffd2c7;
  }
  .card-bosai8:hover {
    box-shadow: 0 12px 30px rgba(239, 90, 72, 0.22);
  }

  /* カテゴリバッジ */
  .category-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 8px;
    margin-bottom: 10px;
  }
  .badge-sun { background: #fff4cc; color: #8a6d00; }
  .badge-coral { background: #ffe9e4; color: #c0392b; }

  .tool-card h3 {
    font-family: 'Baloo 2', 'Zen Maru Gothic', sans-serif;
    color: var(--navy);
    font-size: clamp(1.4rem, 4vw, 1.7rem);
    font-weight: 900;
    margin: 0;
    line-height: 1.2;
  }

  .sub-title {
    display: block;
    font-size: clamp(0.8rem, 2.3vw, 0.88rem);
    color: var(--ink-soft);
    font-weight: 700;
    margin-top: 4px;
    margin-bottom: 14px;
  }

  .card-desc {
    font-size: clamp(0.85rem, 2.4vw, 0.92rem);
    color: var(--ink);
    line-height: 1.65;
    margin-bottom: 18px;
  }

  /* 特徴リスト */
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
    border-top: 1px dashed var(--line);
    padding-top: 12px;
  }

  .feature-list li {
    font-size: clamp(0.8rem, 2.2vw, 0.85rem);
    font-weight: 700;
    color: var(--ink-soft);
    margin-bottom: 8px;
    line-height: 1.4;
  }
  .feature-list li:last-child {
    margin-bottom: 0;
  }

  /* ボタンエリア */
  .card-bottom {
    text-align: center;
    margin-top: auto;
  }

  .btn-launch {
    font-family: 'Baloo 2', 'Zen Maru Gothic', sans-serif;
    font-weight: 800;
    font-size: clamp(0.95rem, 2.6vw, 1.05rem);
    text-decoration: none;
    border-radius: 999px;
    padding: 13px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.08s ease, box-shadow 0.08s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .btn-gioco {
    color: var(--navy);
    background: var(--sun);
    box-shadow: 0 5px 0 #e0b325, 0 10px 18px rgba(255, 210, 63, 0.35);
  }
  .btn-gioco:hover {
    transform: translateY(2px);
    box-shadow: 0 3px 0 #e0b325, 0 6px 12px rgba(255, 210, 63, 0.3);
  }
  .btn-gioco:active {
    transform: translateY(5px);
    box-shadow: 0 0 0 #e0b325;
  }

  .btn-bosai8 {
    color: #fff;
    background: var(--coral);
    box-shadow: 0 5px 0 #c73c2b, 0 10px 18px rgba(239, 90, 72, 0.35);
  }
  .btn-bosai8:hover {
    transform: translateY(2px);
    box-shadow: 0 3px 0 #c73c2b, 0 6px 12px rgba(239, 90, 72, 0.3);
  }
  .btn-bosai8:active {
    transform: translateY(5px);
    box-shadow: 0 0 0 #c73c2b;
  }

  .btn-note {
    display: block;
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin-top: 8px;
    font-weight: 600;
  }

  /* 戻るリンク */
  .back-row {
    text-align: center;
    margin-top: clamp(24px, 5vw, 40px);
  }
  .header-link {
    font-size: 12.5px;
    font-weight: 800;
    color: var(--jyrac-teal, #009aa6);
    text-decoration: none;
  }
  .header-link:hover {
    text-decoration: underline;
  }
</style>
