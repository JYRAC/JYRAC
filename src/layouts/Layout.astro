---
// src/layouts/Layout.astro
import { translations, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  currentTab?: string;
  description?: string;
}

const { 
  title, 
  currentTab = 'home',
  description = "特定非営利活動法人 日本若者防災復興協会（JYRAC）公式サイト。若者の力で、防災を日常に。被災地に確かな未来を。"
} = Astro.props;

const requestUrl = Astro.request.url.replace(/^http:/, 'https:');
const url = new URL(requestUrl);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";

const t = translations?.[currentLang] || translations?.['ja'] || {} as any;
const langParam = currentLang === 'en' ? '?lang=en' : '';
const currentPath = url.pathname;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${baseUrl}/JYRAC.jpg`;

const navLinks = [
  { key: 'home', label: currentLang === 'en' ? 'Home' : 'ホーム', href: `/${langParam}` },
  { key: 'about', label: currentLang === 'en' ? 'About' : 'JYRACについて', href: `/about${langParam}` },
  { key: 'services', label: currentLang === 'en' ? 'Business' : '事業案内', href: `/services${langParam}` },
  { key: 'history', label: currentLang === 'en' ? 'History' : '活動実績・沿革', href: `/history${langParam}` },
  { key: 'news', label: currentLang === 'en' ? 'News' : 'お知らせ', href: `/news${langParam}` },
  { key: 'recruitment', label: currentLang === 'en' ? 'Join Us' : 'メンバー募集', href: `/recruitment${langParam}` },
  { key: 'contact', label: currentLang === 'en' ? 'Contact' : 'お問い合わせ', href: `/contact${langParam}` }
];
---
<!DOCTYPE html>
<html lang={currentLang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" href="/JYRAC.jpg" type="image/jpeg">
  <link rel="apple-touch-icon" href="/JYRAC.jpg">
  
  <style is:global>
    :root {
      --primary: #009aa6;
      --primary-dark: #007c87;
      --navy: #002b54;
      --navy-light: #0d3b66;
      --accent: #e67e22;
      --bg-slate: #f8fafc;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
      margin: 0;
      padding: 0;
      color: #334155;
      background-color: #ffffff;
      overflow-x: hidden;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="flex flex-col min-h-screen">

  <!-- グローバルヘッダー -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 sm:h-20 flex items-center justify-between gap-4">
      
      <!-- ロゴ＆団体名 -->
      <a href={`/${langParam}`} class="flex items-center gap-3 no-underline shrink-0 group">
        <img src={logoSrc} alt="JYRAC ロゴ" class="w-10 h-10 sm:w-11 sm:h-11 object-contain rounded-xl shadow-xs group-hover:scale-105 transition" />
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-black tracking-tight text-[#002b54] leading-tight">
            日本若者防災復興協会
          </span>
          <span class="text-[9px] sm:text-[10px] font-mono font-bold tracking-wider text-[#009aa6] uppercase">
            JAPAN YOUTH RESILIENCE ACTION CONSORTIUM
          </span>
        </div>
      </a>

      <!-- PC ナビゲーションリンク -->
      <nav class="hidden lg:flex items-center gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-lg text-xs font-black transition no-underline ${
              currentTab === link.key 
                ? 'text-[#009aa6] bg-teal-50/80 font-black' 
                : 'text-slate-600 hover:text-[#002b54] hover:bg-slate-100/70'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- 言語切替 ＆ アクション -->
      <div class="flex items-center gap-2.5 shrink-0">
        <div class="flex items-center bg-slate-100 rounded-full p-1 border border-slate-200 text-[11px] font-bold">
          <a href={`${currentPath}?lang=ja`} class={`px-2.5 py-1 rounded-full transition no-underline ${currentLang === 'ja' ? 'bg-white text-[#002b54] shadow-2xs font-black' : 'text-slate-500'}`}>JA</a>
          <a href={`${currentPath}?lang=en`} class={`px-2.5 py-1 rounded-full transition no-underline ${currentLang === 'en' ? 'bg-white text-[#002b54] shadow-2xs font-black' : 'text-slate-500'}`}>EN</a>
        </div>

        <a
          href={`/recruitment${langParam}`}
          class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#009aa6] to-teal-500 hover:to-[#007c87] text-white text-xs font-black shadow-sm transition no-underline active:scale-95"
        >
          <span>参加する</span>
        </a>
      </div>

    </div>

    <!-- スマホ・タブレット用 サブナビゲーションスクロールバー -->
    <div class="lg:hidden border-t border-slate-100 bg-slate-50/90 px-4 py-2 overflow-x-auto flex items-center gap-2 no-scrollbar">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`px-3.5 py-1.5 rounded-full text-[11px] font-bold shrink-0 no-underline transition ${
            currentTab === link.key 
              ? 'bg-[#002b54] text-white shadow-xs' 
              : 'bg-white text-slate-600 border border-slate-200/80'
          }`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </header>

  <!-- メインコンテンツ領域（全幅コンテナ） -->
  <main class="flex-grow w-full">
    <slot />
  </main>

  <!-- メガフッター -->
  <footer class="bg-[#002b54] text-white pt-16 pb-12 border-t-4 border-[#009aa6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-3">
            <img src={logoSrc} alt="JYRAC" class="w-10 h-10 rounded-xl bg-white p-1 object-contain" />
            <div>
              <span class="text-base font-black tracking-tight block">特定非営利活動法人 日本若者防災復興協会</span>
              <span class="text-xs text-teal-300 font-mono font-bold block">JAPAN YOUTH RESILIENCE ACTION CONSORTIUM</span>
            </div>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed max-w-md">
            「いつもの暮らし」が、いちばん強い。若者の力で、防災を日常に。被災地に確かな未来を。全国の中高生・大学生と手を取り合い、新しい防災・復興のスタンダードを築きます[cite: 3]。
          </p>
          <div class="text-xs text-slate-400 space-y-1">
            <p>所在地：東京都文京区小日向四丁目4番6-603号[cite: 3]</p>
            <p>連絡先：jy.rac.gaimu@gmail.com[cite: 3]</p>
          </div>
        </div>

        <div class="space-y-3">
          <span class="text-xs font-mono font-black text-teal-400 uppercase tracking-wider block">NAVIGATION</span>
          <ul class="space-y-2 text-xs text-slate-300">
            <li><a href={`/about${langParam}`} class="hover:text-white transition no-underline">JYRACについて[cite: 3]</a></li>
            <li><a href={`/services${langParam}`} class="hover:text-white transition no-underline">事業内容（4大領域）[cite: 3]</a></li>
            <li><a href={`/history${langParam}`} class="hover:text-white transition no-underline">活動実績・沿革[cite: 3]</a></li>
            <li><a href={`/recruitment${langParam}`} class="hover:text-white transition no-underline">メンバー募集要項</a></li>
          </ul>
        </div>

        <div class="space-y-3">
          <span class="text-xs font-mono font-black text-teal-400 uppercase tracking-wider block">PROJECTS & TOOLS</span>
          <ul class="space-y-2 text-xs text-slate-300">
            <li><a href="https://summit.jyrac.stki.org" target="_blank" rel="noopener noreferrer" class="hover:text-white transition no-underline">生徒会防災サミット ↗[cite: 3]</a></li>
            <li><a href="https://nsf.stki.org/ema" target="_blank" rel="noopener noreferrer" class="hover:text-white transition no-underline">デジタル絵馬プロジェクト ↗</a></li>
            <li><a href={`/gioco${langParam}`} class="hover:text-white transition no-underline">教材・診断ツール</a></li>
            <li><a href={`/contact${langParam}`} class="hover:text-white transition no-underline">取材・お問い合わせ</a></li>
          </ul>
        </div>

      </div>

      <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
        <p>© 2026 特定非営利活動法人 日本若者防災復興協会 (JYRAC) All Rights Reserved.</p>
        <div class="flex items-center gap-4">
          <a href={`/governance${langParam}`} class="hover:text-slate-200 no-underline">情報公開</a>
          <a href="https://www.instagram.com/pred.studentsummit" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 no-underline">公式Instagram[cite: 3]</a>
        </div>
      </div>
    </div>
  </footer>

  <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "cec25f9117274a519150136e7a35a0d9"}'></script>
</body>
</html>
