---
// src/layouts/Layout.astro
import { translations, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  currentTab?: string;
  description?: string;
}

const { title, currentTab = '', description = '' } = Astro.props;

// 言語の取得
const currentLang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "ja";
const langParam = currentLang === 'en' ? '?lang=en' : '';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = translations[currentLang];

// ナビゲーション定義（教材・診断ツール gioco を配置）
const navItems = [
  { id: 'home', label: t.nav.home, href: `${baseUrl}/${langParam}` },
  { id: 'about', label: t.nav.about, href: `${baseUrl}/about${langParam}` },
  { id: 'services', label: t.nav.services, href: `${baseUrl}/services${langParam}` },
  { id: 'history', label: t.nav.history, href: `${baseUrl}/history${langParam}` },
  { id: 'news', label: t.nav.news, href: `${baseUrl}/news${langParam}` },
  { id: 'gioco', label: t.nav.gioco, href: `${baseUrl}/gioco${langParam}` },
  { id: 'recruitment', label: t.nav.recruitment, href: `${baseUrl}/recruitment${langParam}` },
  { id: 'contact', label: t.nav.contact, href: `${baseUrl}/contact${langParam}` },
];
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <!-- ファビコンを JYRAC.jpg に設定 -->
    <link rel="icon" type="image/jpeg" href={`${baseUrl}/JYRAC.jpg`} />
    <title>{title}</title>
    <meta name="description" content={description || t.siteDescription} />
  </head>
  <body>
    <!-- グローバルヘッダー -->
    <header class="global-header">
      <div class="header-inner">
        
        <!-- ロゴエリア -->
        <a href={`${baseUrl}/${langParam}`} class="brand-logo">
          <span class="logo-text-ja">日本若者防災復興協会</span>
          <span class="logo-text-en">JAPAN YOUTH RESILIENCE ACTION CONSORTIUM</span>
        </a>

        <!-- PC向けナビゲーション -->
        <nav class="desktop-nav">
          <ul class="nav-list">
            {navItems.map(item => (
              <li>
                <a 
                  href={item.href} 
                  class={`nav-link ${currentTab === item.id ? 'active' : ''} ${item.id === 'recruitment' ? 'nav-link-pill' : ''}`}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- 言語切替 & スマホメニューボタン -->
        <div class="header-actions">
          <div class="lang-switch">
            <a href="?lang=ja" class={`lang-btn ${currentLang === 'ja' ? 'active' : ''}`}>JA</a>
            <span class="lang-divider">/</span>
            <a href="?lang=en" class={`lang-btn ${currentLang === 'en' ? 'active' : ''}`}>EN</a>
          </div>

          <!-- モバイル用ハンバーガー開閉ボタン -->
          <button id="mobile-menu-toggle" class="mobile-toggle-btn" aria-label="Toggle Navigation Menu">
            <span class="bar bar-1"></span>
            <span class="bar bar-2"></span>
            <span class="bar bar-3"></span>
          </button>
        </div>

      </div>

      <!-- モバイル向けドロワーメニュー -->
      <div id="mobile-drawer" class="mobile-drawer">
        <nav class="mobile-nav-list">
          {navItems.map(item => (
            <a 
              href={item.href} 
              class={`mobile-nav-link ${currentTab === item.id ? 'active' : ''} ${item.id === 'recruitment' ? 'mobile-highlight' : ''}`}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="site-main">
      <slot />
    </main>

    <!-- フッター -->
    <footer class="global-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="footer-name">特定非営利活動法人 日本若者防災復興協会（JYRAC）</span>
          <span class="footer-address">東京都文京区</span>
        </div>
        <div class="footer-links">
          <a href={`${baseUrl}/${langParam}`}>ホーム</a>
          <a href={`${baseUrl}/about${langParam}`}>団体概要</a>
          <a href={`${baseUrl}/gioco${langParam}`}>教材・診断</a>
          <a href={`${baseUrl}/governance${langParam}`}>情報公開</a>
          <a href={`${baseUrl}/contact${langParam}`}>お問い合わせ</a>
        </div>
      </div>
      <div class="footer-bottom">
        <small>&copy; 2024-2026 Japan Youth Resilience Action Consortium. All Rights Reserved.</small>
      </div>
    </footer>

    <!-- モバイルメニュー開閉スクリプト -->
    <script>
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const drawer = document.getElementById('mobile-drawer');

      if (toggleBtn && drawer) {
        toggleBtn.addEventListener('click', () => {
          const isOpen = drawer.classList.toggle('open');
          toggleBtn.classList.toggle('active');
          toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          document.body.style.overflow = isOpen ? 'hidden' : '';
        });

        // リンククリック時に閉じる
        drawer.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            drawer.classList.remove('open');
            toggleBtn.classList.remove('active');
            document.body.style.overflow = '';
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --jyrac-navy: #002b54;
    --jyrac-teal: #009aa6;
    --jyrac-teal-dark: #007a84;
    --bg-light: #f8fafc;
    --border-color: #e2e8f0;
    --text-main: #1e293b;
    --text-muted: #64748b;
  }

  /* ボックスサイジングとリセット */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    overflow-x: hidden; /* 横スクロール・横揺れの完全防止 */
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
    color: var(--text-main);
    background-color: #fcfdfe;
    -webkit-text-size-adjust: 100%;
    line-height: 1.6;
  }

  img, svg, video, iframe {
    max-width: 100%;
    height: auto;
    display: block;
  }

  table {
    max-width: 100%;
    overflow-x: auto;
    display: block;
  }
</style>

<style>
  /* ヘッダー全体 */
  .global-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
  }
  .header-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* ブランドロゴ */
  .brand-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.15;
    flex-shrink: 0;
  }
  .logo-text-ja {
    font-size: 16px;
    font-weight: 900;
    color: var(--jyrac-navy);
    letter-spacing: -0.01em;
  }
  .logo-text-en {
    font-size: 7.5px;
    font-weight: 700;
    color: var(--jyrac-teal);
    font-family: ui-monospace, monospace;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  /* デスクトップナビ */
  .desktop-nav {
    display: none;
  }
  .nav-list {
    display: flex;
    list-style: none;
    gap: 14px;
    align-items: center;
  }
  .nav-link {
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    color: var(--jyrac-navy);
    padding: 6px 4px;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover, .nav-link.active {
    color: var(--jyrac-teal);
  }
  .nav-link-pill {
    background: #e0f2fe;
    color: #0284c7 !important;
    padding: 6px 14px;
    border-radius: 20px;
  }
  .nav-link-pill:hover, .nav-link-pill.active {
    background: var(--jyrac-teal);
    color: #ffffff !important;
  }

  /* アクションエリア */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 800;
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    padding: 3px 8px;
    border-radius: 6px;
  }
  .lang-btn {
    text-decoration: none;
    color: var(--text-muted);
  }
  .lang-btn.active {
    color: var(--jyrac-teal);
  }
  .lang-divider {
    color: var(--border-color);
  }

  /* スマホ用ハンバーガーボタン */
  .mobile-toggle-btn {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 1100;
  }
  .bar {
    width: 100%;
    height: 2px;
    background: var(--jyrac-navy);
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.25s;
  }
  .mobile-toggle-btn.active .bar-1 {
    transform: translateY(8px) rotate(45deg);
  }
  .mobile-toggle-btn.active .bar-2 {
    opacity: 0;
  }
  .mobile-toggle-btn.active .bar-3 {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* モバイルドロワー */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 57px;
    left: 0;
    width: 100%;
    height: calc(100vh - 57px);
    background: #ffffff;
    padding: 24px 20px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    overflow-y: auto;
  }
  .mobile-drawer.open {
    display: block;
  }
  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mobile-nav-link {
    display: block;
    text-decoration: none;
    font-size: 15px;
    font-weight: 800;
    color: var(--jyrac-navy);
    padding: 12px 16px;
    border-radius: 10px;
    background: var(--bg-light);
  }
  .mobile-nav-link.active {
    color: var(--jyrac-teal);
    background: #f0fdfa;
  }
  .mobile-highlight {
    background: #e0f2fe;
    color: #0284c7;
  }

  /* メインコンテンツエリア */
  .site-main {
    min-height: calc(100vh - 240px);
    width: 100%;
  }

  /* フッター */
  .global-footer {
    background: var(--jyrac-navy);
    color: #ffffff;
    padding: 48px 16px 24px 16px;
    margin-top: 64px;
  }
  .footer-inner {
    max-width: 1160px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    flex-wrap: wrap;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .footer-name {
    font-size: 14px;
    font-weight: 800;
  }
  .footer-address {
    font-size: 12px;
    color: #94a3b8;
  }
  .footer-links {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .footer-links a {
    color: #cbd5e1;
    font-size: 13px;
    text-decoration: none;
  }
  .footer-links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
  .footer-bottom {
    max-width: 1160px;
    margin: 20px auto 0 auto;
    text-align: center;
    font-size: 11px;
    color: #64748b;
  }

  /* PC向けブレークポイント */
  @media (min-width: 992px) {
    .brand-logo .logo-text-ja {
      font-size: 17px;
    }
    .brand-logo .logo-text-en {
      font-size: 8px;
    }
    .desktop-nav {
      display: block;
    }
    .mobile-toggle-btn {
      display: none;
    }
    .mobile-drawer {
      display: none !important;
    }
  }
</style>
